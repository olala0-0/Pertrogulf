<odoo>
    <template id="body_petrogulf_automotive">
        <t t-set="show_net_weight" t-value="any(l.net_weight for l in o.order_line if not l.display_type)"/>
        <t t-set="show_gross_weight" t-value="any(l.gross_weight for l in o.order_line if not l.display_type)"/>
        <t t-set="show_pack_type" t-value="any(l.pack_type for l in o.order_line if not l.display_type)"/>
        <t t-set="show_hs_code" t-value="any(l.hs_code for l in o.order_line if not l.display_type)"/>
        <t t-set="show_discount" t-value="any(l.discount for l in o.order_line if not l.display_type)"/>
        <table class="table table-sm o_main_table mb-0" style="font-size:15px;">
            <tr style="background-color:#f4b6bb;">
                <th style="font-weight:bold">Sn</th>
                <th style="font-weight:bold">Offered Items</th>
                <th style="font-weight:bold">Pack Size</th>
                <th style="font-weight:bold">No of Units</th>
                <th style="font-weight:bold">Unit Price</th>
                <th t-if="show_net_weight" style="font-weight:bold">Net Weight</th>
                <th t-if="show_gross_weight" style="font-weight:bold">Gross Weight</th>
                <th t-if="show_pack_type" style="font-weight:bold">Pack Type</th>
                <th t-if="show_hs_code" style="font-weight:bold">HS Code</th>
                <th t-if="show_discount" style="font-weight:bold">Discount/Credit Note</th>
                <th class="text-right" style="font-weight:bold">Amount</th>

            </tr>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td>
                                <span t-esc="sn"/>
                            </td>
                            <td>
                                <span t-field="line.name"/>
                            </td>
                            <td>
                                <span t-field="line.pack_size_id"/>
                            </td>
                            <td>
                                <span t-field="line.product_uom_qty"/>
                            </td>
                            <td>
                                <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td t-if="show_net_weight">
                                <span t-field="line.net_weight"/>
                            </td>
                            <td t-if="show_gross_weight">
                                <span t-field="line.gross_weight"/>
                            </td>
                            <td t-if="show_pack_type">
                                <span t-field="line.pack_type"/>
                            </td>
                            <td t-if="show_hs_code">
                                <span t-field="line.hs_code"/>
                            </td>
                            <td t-if="show_discount">
                                <t t-if="line.discount"><span t-field="line.discount"/>%</t>
                            </td>
                            <td class="text-right">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
        <table class="table table-sm o_main_table mb-0"
               style="margin-top:0; font-size:11px;">
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Total</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_untaxed"/>
                </td>
            </tr>
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Vat 5%</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_tax"/>
                </td>
            </tr>
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Grand Total</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_total"/>
                </td>
            </tr>
        </table>

        <div class="mt-3">
            <t t-if="o.note">
                <strong>Terms &amp; Conditions:</strong>
                <div t-field="o.note"/>
            </t>
            <strong>Payment terms:</strong>

            <span t-field="o.payment_term_id.name"/>
        </div>
    </template>
</odoo>
