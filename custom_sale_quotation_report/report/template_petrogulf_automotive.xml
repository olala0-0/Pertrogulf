<odoo>
    <template id="body_petrogulf_automotive">
        <t t-set="show_net_weight" t-value="any(l.net_weight for l in o.order_line if not l.display_type)"/>
        <t t-set="show_gross_weight" t-value="any(l.gross_weight for l in o.order_line if not l.display_type)"/>
        <t t-set="show_pack_type" t-value="any(l.pack_type for l in o.order_line if not l.display_type)"/>
        <t t-set="show_hs_code" t-value="any(l.hs_code for l in o.order_line if not l.display_type)"/>
        <t t-set="show_discount" t-value="any(l.discount for l in o.order_line if not l.display_type)"/>
        <t t-set="total_columns" t-value="6 + (1 if show_net_weight else 0) + (1 if show_gross_weight else 0) + (1 if show_pack_type else 0) + (1 if show_hs_code else 0) + (1 if show_discount else 0)"/>
        <table class="table table-sm o_main_table mb-0" style="font-size:15px; border-collapse:collapse;">
            <tr>
                <th style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb; border-radius:8px 0 0 0;" class="text-center">SN</th>
                <th style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb;">Offered Items</th>
                <th style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb;">Pack Size</th>
                <th style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb;">No of Units</th>
                <th style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb;">Unit Price</th>
                <th t-if="show_net_weight" style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb;">Net Weight</th>
                <th t-if="show_gross_weight" style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb;">Gross Weight</th>
                <th t-if="show_pack_type" style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb;">Pack Type</th>
                <th t-if="show_hs_code" style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb;">HS Code</th>
                <th t-if="show_discount" style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb;">Discount/Credit Note</th>
                <th class="text-end" style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb; border-radius:0 8px 0 0;" >Amount</th>
            </tr>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td style="border:1px solid #6c757d !important;" class="text-center">
                                <span t-esc="sn"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.name"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.pack_size_id"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.product_uom_qty"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td t-if="show_net_weight" style="border:1px solid #6c757d !important;">
                                <span t-field="line.net_weight"/>
                            </td>
                            <td t-if="show_gross_weight" style="border:1px solid #6c757d !important;">
                                <span t-field="line.gross_weight"/>
                            </td>
                            <td t-if="show_pack_type" style="border:1px solid #6c757d !important;">
                                <span t-field="line.pack_type"/>
                            </td>
                            <td t-if="show_hs_code" style="border:1px solid #6c757d !important;">
                                <span t-field="line.hs_code"/>
                            </td>
                            <td t-if="show_discount" style="border:1px solid #6c757d !important;">
                                <t t-if="line.discount"><span t-field="line.discount"/>%</t>
                            </td>
                            <td class="text-end" style="border:1px solid #6c757d !important;">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" style="text-align: right; font-weight: bold; border:1px solid #6c757d !important; border-top:3px solid #000 !important;">SubTotal</td>
                    <td t-attf-colspan="#{total_columns - 4}" class="text-end" style="text-align: right; font-weight: bold; border:1px solid #6c757d !important; border-top:3px solid #000 !important;">
                        <span t-field="o.amount_untaxed"/>
                    </td>
                </tr>
                <tr>
                    <td colspan="4" style="text-align: right; font-weight: bold; border:1px solid #6c757d !important;">VAT 5%</td>
                    <td t-attf-colspan="#{total_columns - 4}" class="text-end" style="text-align: right; font-weight: bold; border:1px solid #6c757d !important;">
                        <span t-field="o.amount_tax"/>
                    </td>
                </tr>
                <tr>
                    <td colspan="4" style="text-align: right; font-weight: bold; border:1px solid #6c757d !important;">Grand Total</td>
                    <td t-attf-colspan="#{total_columns - 4}" class="text-end" style="text-align: right; font-weight: bold; border:1px solid #6c757d !important;">
                        <span t-field="o.amount_total"/>
                    </td>
                </tr>
            </tfoot>
        </table>
                <p>
            <strong>Total Amount in words:</strong>
            <span style="font-weight:bold;" t-esc="o._get_amount_in_words()"/>
        </p>


        <div class="mt-3">
            <t t-if="o.note">
                <strong>Terms &amp; Conditions:</strong>
                <div t-field="o.note"/>
            </t>
            <strong>Payment terms:</strong>

            <span t-field="o.payment_term_id.name"/>
        </div>
    </template>
</odoo>
