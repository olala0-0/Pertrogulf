<odoo>
    <template id="body_petrogulf_automotive">
        <table class="table table-sm o_main_table">
                <tr style="background-color:#f4b6bb;">
                    <td>Sn</td>
                    <td>Offered Items</td>
                    <td>Pack Size</td>
                    <td>No of Units</td>
                    <td>Unit Price</td>
                    <td class="text-right">Amount</td>
                </tr>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td>
                                <span t-esc="sn"/>
                            </td>
                            <td>
                                <span t-field="line.name"/>
                                <!-- Optional / show-hide fields, Automotive only -->
                                <t t-if="line.net_weight">
                                    <br/>
                                    <small class="text-muted">Net Weight:
                                        <span t-field="line.net_weight"/>
                                    </small>
                                </t>
                                <t t-if="line.gross_weight">
                                    <br/>
                                    <small class="text-muted">Gross Weight:
                                        <span t-field="line.gross_weight"/>
                                    </small>
                                </t>
                                <t t-if="line.hs_code">
                                    <br/>
                                    <small class="text-muted">HS Code:
                                        <span t-field="line.hs_code"/>
                                    </small>
                                </t>
                            </td>
                            <td>
                                <span t-field="line.pack_type"/>
                            </td>
                            <td>
                                <span t-field="line.product_uom_qty"/>
                            </td>
                            <td>
                                <span t-field="line.price_unit"/>
                            </td>
                            <td class="text-right">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                        <t t-if="line.discount">
                            <tr>
                                <td/>
                                <td colspan="5">
                                    <small>Discount / Credit Note:<span t-field="line.discount"/>%
                                    </small>
                                </td>
                            </tr>
                        </t>
                    </t>
                </t>
            </tbody>
        </table>
        <table class="table table-sm o_main_table mb-0"
               style="margin-top:0; font-size:11px;">
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Total</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_untaxed"/>
                </td>
            </tr>
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Vat 5%</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_tax"/>
                </td>
            </tr>
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Grand Total</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_total"/>
                </td>
            </tr>
        </table>

        <div class="mt-3">
            <strong>Terms &amp; Conditions:</strong>
            <ul>
                <div t-field="o.note"/>
            </ul>
            <strong>Payment terms:</strong>
            <span t-field="o.payment_term_id.name"/>
        </div>
    </template>
</odoo>
