<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_tax_invoice_ajman">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="bank" t-value="o.partner_bank_id or o.preferred_payment_method_line_id.journal_id.bank_account_id"/>
                <t t-set="so" t-value="o._get_related_sale_order()"/>
                <t t-set="delivery" t-value="o._get_related_delivery()"/>
                <t t-set="is_powerx" t-value="o.company_id.business_unit == 'pg_powerx'"/>
                <t t-set="is_marine" t-value="o.company_id.business_unit == 'pg_fujairah' or (o.company_id.parent_id and o.company_id.parent_id.business_unit == 'pg_fujairah')"/>
                <!-- <t t-set="is_fixed_company_name" t-value="o.company_id.business_unit in ('pg_aviation', 'pg_auto', 'pg_tblnd', 'pg_fujairah', 'pg_marine')"/> -->
                <t t-set="is_fixed_company_name" t-value="o.company_id.business_unit in ('pg_fujairah', 'pg_marine')"/>
                <t t-set="is_logo_company" t-value="o.company_id.business_unit in ('pg_aviation', 'pg_auto', 'pg_tblnd', 'pg_fujairah', 'pg_marine', 'pg_ajman')"/>
                <div class="page" style="font-size:12px; padding:0; margin:0;">

                    <!-- ============ HEADER (letterhead banner, SVG shape as background image) ============ -->
                    <div style="width:100%; height:42mm; background-repeat:no-repeat; background-size:100% 100%; background-image:url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyMTAgNDIiIHByZXNlcnZlQXNwZWN0UmF0aW89Im5vbmUiPjxwb2x5Z29uIHBvaW50cz0iMCwwIDIxMCwwIDIxMCwxNC40IDk5LjMsMTQuNCA4Ny45LDQyIDAsNDIiIGZpbGw9IiNkMWQzZDQiLz48L3N2Zz4=');">
                    <table style="width:100%; height:42mm; table-layout:fixed; border-collapse:collapse;">
                        <colgroup>
                            <col style="width:93mm;"/>
                            <col style="width:117mm;"/>
                        </colgroup>
                        <tr style="border:none;">
                            <td style="border:none;padding:3mm 4mm; vertical-align:middle; text-align:left;">
                                <!-- <t t-if="is_logo_company">
                                    <img t-if="o.company_id.logo" t-att-src="o.company_id.get_logo_on_background()" style="max-height:36mm; max-width:100%;"/>
                                </t>
                                <t t-else="">
                                    <img t-if="o.company_id.logo" t-att-src="o.company_id.get_logo_on_background()" style="max-height:36mm; max-width:100%;"/>
                                </t> -->
                                <t t-set="ajman_company" t-value="env['res.company'].search([('business_unit', '=', 'pg_ajman')], limit=1)"/>
                                <t t-if="is_logo_company and ajman_company">
                                    <img t-if="ajman_company.logo" t-att-src="ajman_company.get_logo_on_background()" style="max-height:36mm; max-width:100%;"/>
                                </t>
                                <t t-else="">
                                    <img t-if="o.company_id.logo" t-att-src="o.company_id.get_logo_on_background()" style="max-height:36mm; max-width:100%;"/>
                                </t>
                            </td>
                            <td style="border:none;padding:6mm 18mm 6mm 4mm; vertical-align:middle; text-align:right;">
                                <span style="font-size:34px; font-weight:bold; color:#231f20;">TAX INVOICE</span>
                            </td>
                        </tr>
                    </table>
                    </div>

                    <!-- <div style="padding:3mm 7mm 0 7mm;"> -->
                    <div>

                    <table style="width:100%; border-collapse:collapse; margin-bottom:15px;">
                        <tr style="border:none;">
                            <td style="border:none;width:50%; vertical-align:top; font-size:12px;">
                                <t t-if="is_fixed_company_name">
                                    <div style="margin-left: 4px;"><strong>Petro Gulf Oil Manufacturing L.L.C</strong></div>
                                    <div style="margin-left: 4px;">Office C7, FIFTCO 02, Fujairah Port,</div>
                                    <div style="margin-left: 4px;">Fujairah, United Arab Emirates</div>
                                </t>
                                <t t-elif="is_powerx">
                                    <div style="margin-left: 4px;"><strong t-field="o.company_id.name"/></div>
                                    <div style="margin-left: 4px;" t-if="o.company_id.street"><span t-field="o.company_id.street"/></div>
                                </t>
                                <t t-else="">
                                    <div style="margin-left: 4px;"><strong>Petro Gulf Oil Manufacturing L.L.C</strong></div>
                                    <div style="margin-left: 4px;">Industrial Area - 1,</div>
                                    <div style="margin-left: 4px;">Ajman, United Arab Emirates,</div>
                                    <!-- <div>Ajman, United Arab Emirates,</div> -->
                                </t>
                                <div style="margin-left: 4px;" t-if="o.company_id.vat">TRN : <span t-field="o.company_id.vat"/></div>
                                <div style="margin-left: 4px;" t-if="o.company_id.phone"><span t-field="o.company_id.phone"/></div>
                                <div style="margin-left: 4px;" t-if="o.company_id.email"><span t-field="o.company_id.email"/></div>
                                <div style="margin-left: 4px;" t-if="o.company_id.website">
                                    <span t-esc="o.get_formatted_website()"/>
                                </div>
                            </td>
                            <td style="width:50%; vertical-align:top;">
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    <tr >
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2; width:35%;">
                                            <strong>Invoice No</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.name"/>
                                        </td>
                                    </tr>
                                    <tr >
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong><span t-esc="'Date' if is_powerx else 'Date'"/></strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.invoice_date" t-options="{'widget': 'date'}"/>
                                        </td>
                                    </tr>
                                    <tr t-if="is_powerx">
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>Ref. Proforma / Sales Order Inv. No.</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="so.name"/>
                                        </td>
                                    </tr>
                                    <tr t-if="is_powerx">
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>Purchase Order No. and Date</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="so.client_po_order_no"/>
                                        </td>
                                    </tr>
                                    <tr t-if="is_powerx">
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>Contact Person</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;"> </td>
                                    </tr>
                                    <tr t-if="is_powerx">
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>Contact Email / Phone</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <t t-if="o.partner_id.email or o.partner_id.phone">
                                                <span t-field="o.partner_id.email"/> / <span t-field="o.partner_id.phone"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr t-if="is_powerx">
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>Payment Terms</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.invoice_payment_term_id.name"/>
                                        </td>
                                    </tr>
                                    <tr t-if="is_powerx">
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>Exchange Rate</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;"> </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ BUYER / INVOICE DETAILS ============ -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:15px;">
                        <tr>
                            <td style="border:none;width:50%; vertical-align: top;">
                                <div style="background-color:#d9d9d9; padding:4px 6px; font-weight:bold;">Buyer</div>
                                <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:12px;">
                                    <tr t-if="is_marine">
                                        <td colspan="2" style="padding:4px; font-size:12px; font-style:italic;">
                                            Master and/or Owner(s) and/or Managing Director(s) and/or Operator(s) and/or Charterer(s) and/or Buyer(s) for Vessel - <span t-if="so and so.vessel_no_id" t-field="so.vessel_no_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:none; padding:4px; width:40%;">Company Name</td>
                                        <td style="border:none; padding:4px;">: <span t-field="o.partner_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border:none; padding:4px;">Address</td>
                                        <td style="border:none; padding:4px;">:
                                            <span t-field="o.partner_id.street"/>
                                            <t t-if="o.partner_id.street2">, <span t-field="o.partner_id.street2"/></t>
                                            <t t-if="o.partner_id.city">, <span t-field="o.partner_id.city"/></t>
                                        </td>
                                    </tr>
                                    <t t-if="is_marine">
                                        <tr>
                                            <td style="border:none; padding:4px;">Emirate / State</td>
                                            <td style="border:none; padding:4px;">: <span t-field="o.partner_id.state_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="border:none; padding:4px;">Country</td>
                                            <td style="border:none; padding:4px;">: <span t-field="o.partner_id.country_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="border:none; padding:4px;">Contact No.</td>
                                            <td style="border:none; padding:4px;">: <span t-field="o.partner_id.phone"/></td>
                                        </tr>
                                        <tr>
                                            <td style="border:none; padding:4px;">TRN / GSTN / TAX ID</td>
                                            <td style="border:none; padding:4px;">: <span t-field="o.partner_id.vat"/></td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td style="border:none; padding:4px;">Contact No.</td>
                                            <td style="border:none; padding:4px;">: <span t-field="o.partner_id.phone"/></td>
                                        </tr>
                                        <tr t-if="not is_powerx">
                                            <td style="border:none; padding:4px;">Emirate</td>
                                            <td style="border:none; padding:4px;">: <span t-field="o.partner_id.state_id.name"/></td>
                                        </tr>
                                        <tr t-if="not is_powerx">
                                            <td style="border:none; padding:4px;">Country</td>
                                            <td style="border:none; padding:4px;">: <span t-field="o.partner_id.country_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="border:none; padding:4px;">TRN</td>
                                            <td style="border:none; padding:4px;">: <span t-field="o.partner_id.vat"/></td>
                                        </tr>
                                    </t>
                                </table>
                            </td>
                            <!-- <td style="border:none;width:4%;"/> -->
                            <td style="border:none;width:50%; vertical-align:top;">
                                <div style="background-color:#d9d9d9; padding:4px 6px; font-weight:bold;">
                                    <span t-esc="'Delivery Details' if is_powerx else 'Invoice Details'"/>
                                </div>
                                <table t-if="is_powerx" style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:12px; table-layout:fixed;">
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Vehicle No.</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Contact No.</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="delivery.vehicle_no"/>&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="o.partner_id.phone"/>&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Weight Slip No.</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Delivery Note No.</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;">&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="delivery.document_number"/>&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="border:none; padding:4px;" colspan="2">Terms</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;" colspan="2">&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Place of Supply</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Place of Loading</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;">&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="so.port_master_id.name"/>&#160;</td>
                                    </tr>
                                </table>
                                <table t-else="" style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:12px; table-layout:fixed;">
                                    <tr t-if="is_marine" style="background-color:#f2f2f2;">
                                        <td colspan="2" style="padding:4px;">&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Delivery Note No.</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Date</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="delivery.name"/>&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="delivery.date_done" t-options="{'widget': 'date'}"/>&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Vessel Name</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">IMO No</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="so.vessel_no_id.name"/>&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="so.imo_number"/>&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Buyer's Order No.</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Date</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="so.client_po_order_no"/>&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="so.buyers_date"/>&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Dispatch Note No.</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Date</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="delivery.document_number"/>&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-esc="delivery.scheduled_date and delivery.scheduled_date.strftime('%d/%m/%Y')"/>&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Dispatched through</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Port</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="so.dispatch_through"/>&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="so.port_master_id.name"/>&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Payment Terms</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Terms of Delivery</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="o.invoice_payment_term_id.name"/>&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="so.incoterm.name"/>&#160;</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <div t-if="is_powerx" style="font-weight:bold; margin:-10px 0 15px 0;">FREE ZONE TO FREE ZONE</div>

                    <!-- ============ LINE ITEMS ============ -->
                    <table class="table table-sm" style="width:100%; border-collapse:collapse; font-size:11px;">
                        <thead>
                            <tr style="background-color:#d9d9d9;">
                                <th style="border:1px solid #ccc; padding:4px;">Sn No</th>
                                <th style="border:1px solid #ccc; padding:4px;">Description of Goods</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">Packaging</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">Quantity</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">Rate</th>
                                <th t-if="not is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">Per</th>
                                <th t-if="not is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">VAT %</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">Amount</th>
                                <th t-if="is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">VAT Rate</th>
                                <th t-if="is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">Taxable Value</th>
                                <th t-if="is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">Tax Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sn" t-value="0"/>
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <t t-if="line.display_type == 'product'">
                                    <t t-set="sn" t-value="sn + 1"/>
                                    <t t-set="vat_pct"
                                       t-value="'+'.join(['%g' % t.amount for t in line.tax_ids if t.amount_type == 'percent']) or '0'"/>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-esc="sn"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="line.name"/>
                                            <t t-if="is_powerx and line.sale_line_ids[:1].packing_type">
                                                <br/>
                                                <small class="text-muted">Packing: <span t-esc="line.sale_line_ids[:1].packing_type"/></small>
                                            </t>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-esc="line.sale_line_ids[:1].pack_size_id.name"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.price_unit"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td t-if="not is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.product_uom_id.name"/>
                                        </td>
                                        <td t-if="not is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-esc="vat_pct"/>%
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.price_subtotal"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td t-if="is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-esc="vat_pct"/>%
                                        </td>
                                        <td t-if="is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.price_subtotal"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td t-if="is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-esc="o.currency_id.symbol + ' ' + '{:,.2f}'.format(line.price_total - line.price_subtotal)"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <div t-if="is_powerx" style="display:flex; justify-content:space-between; background-color:#f2f2f2; padding:4px 6px; font-size:11px; border:1px solid #ccc; border-top:none;">
                        <span>Gross Weight: <span t-esc="'{:,.2f}'.format(sum(o.invoice_line_ids.mapped('sale_line_ids').mapped('gross_weight')))"/></span>
                        <span>Net Weight: <span t-esc="'{:,.2f}'.format(sum(o.invoice_line_ids.mapped('sale_line_ids').mapped('net_weight')))"/></span>
                    </div>

                    <table t-if="is_powerx" style="width:100%; border-collapse:collapse; font-size:11px; margin-top:4px;">
                        <tr style="background-color:#d9d9d9; font-weight:bold;">
                            <td style="border:1px solid #ccc; padding:4px;">Total AED</td>
                            <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ TERMS / TOTALS ============ -->
                    <table t-if="is_powerx" style="width:100%; border-collapse:collapse; margin-top:10px;">
                        <tr>
                            <td style="width:80%; vertical-align:top; font-size:12px;">
                                <div><strong>Amount Chargeable (in words)</strong></div>
                                <div><span t-esc="o.currency_id.amount_to_text(o.amount_total)"/></div>
                                <div style="margin-top:10px;"><strong>VAT Amount (in words)</strong></div>
                                <div><span t-esc="o.currency_id.amount_to_text(o.amount_tax)"/></div>
                            </td>
                            <td style="width:20%; vertical-align:top;">
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="border:1px solid #ccc; padding:4px;"><strong>VAT %</strong></td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;"><strong>Assessable Value</strong></td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;"><strong>Tax Amount</strong></td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px;">5%</td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="font-weight:bold;">
                                        <td style="border:1px solid #ccc; padding:4px;">Total</td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                                <div style="text-align:right; font-size:10px; font-style:italic; margin-top:2px;">E. &amp; O.E</div>
                            </td>
                        </tr>
                    </table>
                    <table t-else="" style="width:100%; border-collapse:collapse; margin-top:10px;">
                        <tr style="border:none;">
                            <td style="border:none;width:75%; vertical-align:top;"/>
                            <td style="border:none;width:25%; vertical-align:top;">
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    <tr>
                                        <td style="border:none; padding:4px;"><strong>Sub Total</strong></td>
                                        <td style="border:none; padding:4px; text-align:right;">
                                            <span t-field="o.amount_untaxed"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="so and so.vat_selection and so.vat_selection != 'vat_not_applicable'">
                                        <td style="border:none; padding:4px;">
                                            <strong>
                                                <span t-if="so.vat_selection == 'vat_5'">VAT 5%</span>
                                                <span t-if="so.vat_selection == 'vat_0'">VAT 0%</span>
                                            </strong>
                                        </td>
                                        <td style="border:none; padding:4px; text-align:right;">
                                            <span t-field="o.amount_tax"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-elif="o.amount_tax">
                                        <td style="border:none; padding:4px;"><strong>VAT</strong></td>
                                        <td style="border:none; padding:4px; text-align:right;">
                                            <span t-field="o.amount_tax"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:none; padding:4px;"><strong>Grand Total</strong></td>
                                        <td style="border:none; padding:4px; text-align:right;">
                                            <span t-field="o.amount_total"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                    <div t-if="not is_powerx" style="margin-top:8px; font-size:12px;">
                        <strong>Amount in words</strong> :
                        <span style="font-weight:bold;" t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                    </div>

                    <!-- ============ BANK DETAILS ============ -->
                    <table style="width:100%; border-collapse:collapse; margin-top:20px;">
                        <tr>
                            <td style="border:none;width:48%; vertical-align:top;">
                                <div style="background-color:#f2f2f2; padding:10px; font-size:12px;">
                                    <div style="font-weight:bold; margin-bottom:6px;">BANK DETAILS</div>
                                    <table style="width:100%; border-collapse:collapse;">
                                        <tr>
                                            <td style="padding:2px; width:45%;">Account Name</td>
                                            <td style="padding:2px;"><span t-field="bank.acc_holder_name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding:2px;"><span t-esc="'Account Number' if is_marine else 'A/C No.'"/></td>
                                            <td style="padding:2px;"><span t-field="bank.acc_number"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding:2px;">Bank Name</td>
                                            <td style="padding:2px;"><span t-field="bank.bank_name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding:2px;">IBAN</td>
                                            <td style="padding:2px;"><span t-field="bank.clearing_number"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding:2px;">Branch &amp; SWIFT Code</td>
                                            <td style="padding:2px;"><span t-field="bank.bank_street"/> &amp; <span t-field="bank.bank_bic"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                            <td style="border:none;width:4%;"/>
                            <t t-if="not is_powerx">
                                <td style="border:none;width:48%; vertical-align:bottom; font-size:11px;">
                                    <t t-if="is_marine">
                                        <div style="font-weight:bold; margin-bottom:4px;">Terms :</div>
                                        <div t-field="o.narration"/>
                                    </t>
                                    <t t-elif="not is_powerx">
                                        <div style="text-align:center; font-size:12px;">
                                            <div t-if="is_fixed_company_name">for Petro Gulf Oil Manufacturing LLC</div>
                                            <div t-else="">for Petro Gulf Oil Manufacturing LLC</div>
                                            <div style="margin-top:24px;"><strong>Authorised Signatory</strong></div>
                                        </div>
                                    </t>
                                </td>
                            </t>
                            <t t-else="">
                                <td style="border:none;width:48%; vertical-align:top; font-size:11px;">
                                    <t t-if="is_marine">
                                        <div style="font-weight:bold; margin-bottom:4px;">Terms :</div>
                                        <div t-field="o.narration"/>
                                    </t>
                                    <t t-elif="not is_powerx">
                                        <div style="text-align:right; font-size:12px;">
                                            <div t-if="is_fixed_company_name">for Petro Gulf Oil Manufacturing LLC</div>
                                            <div t-else="">for Petro Gulf Oil Manufacturing LLC</div>
                                            <div style="margin-top:24px;"><strong>Authorised Signatory</strong></div>
                                        </div>
                                    </t>
                                </td>
                            </t>
                        </tr>
                    </table>

                    <!-- ============ SIGNATURE (Power X only) ============ -->
                    <div t-if="is_powerx" style="text-align:right; margin-top:20px; font-size:12px;">
                        <div>for Power X Oil FZE</div>
                        <div style="margin-top:24px;"><strong>Authorised Signatory</strong></div>
                    </div>
                    <div t-if="is_powerx" style="color:#c0392b; font-style:italic; font-weight:bold; text-align:right; margin-top:8px;">
                        Leave your Base Oil with us
                    </div>

                    <!-- ============ DECLARATION ============ -->
                    <div style="margin-top:20px; font-size:11px;">
                        <div style="text-decoration:underline; font-weight:bold;">Declaration</div>
                        <div t-if="is_powerx">
                            We declare that this invoice shows the actual price of the goods
                            described and that all particulars are true and correct
                        </div>
                        <div t-else="">
                            We hereby declare that this invoice shows the actual price of the goods
                            described and that all particulars are true and correct
                        </div>
                    </div>

                    <div style="text-align:center; font-size:10px; margin-top:15px;">
                        This is a Computer Generated Invoice
                    </div>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
