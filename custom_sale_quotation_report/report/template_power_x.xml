<odoo>
    <template id="body_power_x">
        <table style="width:100%; border-collapse:collapse; margin-top:10px; font-size:14px;" border="1">
            <thead style="background:#f5f5f5;">
                <tr>
                    <th style="text-align:center; width:5%; padding:8px; line-height:1.8; border:1px solid #000;">Sn</th>
                    <th style="text-align:left; width:40%; padding:8px; line-height:1.8; border:1px solid #000;">Description of Goods</th>
                    <th style="text-align:center; width:10%; padding:8px; line-height:1.8; border:1px solid #000;">Rate</th>
                    <th style="text-align:center; width:10%; padding:8px; line-height:1.8; border:1px solid #000;">Per</th>
                    <th style="text-align:center; width:15%; padding:8px; line-height:1.8; border:1px solid #000;">Discount</th>
                    <th style="text-align:center; width:15%; padding:8px; line-height:1.8; border:1px solid #000;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td style="text-align:center; padding:8px; line-height:1.8;">
                                <span t-esc="sn"/>
                            </td>
                            <td style="text-align:center; padding:8px; line-height:1.8;">
                                <span t-field="line.name"/>
                                <!-- Optional packing/weight info, only for Power X -->
                                <t t-if="line.packing_type">
                                    <br/>
                                    <small class="text-muted">
                                        Packing:
                                        <span t-esc="line.packing_type"/>
                                        <t t-if="line.packing_type == 'drum'">
                                            | Net Wt:
                                            <span t-field="line.net_weight"/>
                                            | Gross Wt:
                                            <span t-field="line.gross_weight"/>
                                        </t>
                                        <t t-elif="line.packing_type == 'ibc'">
                                            | Gross Wt:
                                            <span t-field="line.gross_weight"/>
                                            | Net Wt:
                                            <span t-field="line.net_weight"/>
                                        </t>
                                        <t t-elif="line.packing_type == 'bulk'">
                                            | Net Wt:
                                            <span t-field="line.net_weight"/>
                                        </t>
                                        <t t-elif="line.packing_type == 'flexi'">
                                            | Net Wt:
                                            <span t-field="line.net_weight"/>
                                        </t>
                                    </small>
                                </t>
                            </td>
                            <td style="text-align:center; padding:8px; line-height:1.8;">
                                <span t-field="line.price_unit"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td style="text-align:center; padding:8px; line-height:1.8;">
                                <span t-field="line.product_uom_id.name"/>
                            </td>
                            <td style="text-align:center; padding:8px; line-height:1.8;"><span t-field="line.discount"/>%
                            </td>
                            <td class="text-right">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
        <table class="table"
               style="width: 100%; float: right; font-size: 15px; border-collapse: collapse; border: 0 !important; border-style: none !important; box-shadow: none !important;border: 0px solid #495057 !important;border-radius: 0 !important;">
            <t t-set="total_discounted"
               t-value="sum(o.order_line.filtered(lambda l: not l.product_id.is_expences and l.product_id.name != 'Discount').mapped('price_subtotal'))"/>
            <tr>
                <td style="text-align: right; font-weight: bold;width: 68.4%;">Total</td>
                <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 1px solid #ddd; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                    <span t-esc="o.currency_id.symbol + ' ' + '{:,.2f}'.format(total_discounted)"/>
                </td>
            </tr>
            <tr t-if="o.vat_selection and o.vat_selection != 'vat_not_applicable'">
                <td style="text-align: right; font-weight: bold; width: 68.4%;">
                    <span t-if="o.vat_selection == 'vat_5'">VAT 5%</span>
                    <span t-if="o.vat_selection == 'vat_0'">VAT 0%</span>
                </td>
                <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                    <span t-esc="o.currency_id.symbol + ' ' + '{:,.2f}'.format(o.amount_tax)"/>
                </td>
            </tr>
            <t t-set="expense_total"
               t-value="sum(o.order_line.filtered(lambda l: l.product_id.is_expences).mapped('price_subtotal'))"/>
            <t t-foreach="o.order_line.filtered(lambda l: l.product_id.is_expences)" t-as="line">
                <tr>
                    <td style="text-align: right; font-weight: bold;width: 68.4%;">
                        <t t-esc="line.product_id.name"/>
                    </td>
                    <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                        <span t-esc="o.currency_id.symbol + ' ' + '{:,.2f}'.format(line.price_subtotal)"/>
                    </td>
                </tr>
            </t>

            <tr>
                <td style="text-align: right; font-weight: bold;width: 68.4%;">Grand Total</td>
                <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                    <strong t-esc="o.currency_id.symbol + ' ' + '{:,.2f}'.format(total_discounted + o.amount_tax + expense_total)"/>
                </td>
            </tr>
        </table>


        <div class="mt-3">
            <strong>Terms &amp; Conditions:</strong>
            <div t-field="o.note"/>
            <strong>Payment terms:</strong>

            <span t-field="o.payment_term_id.name"/>
        </div>
    </template>
</odoo>
