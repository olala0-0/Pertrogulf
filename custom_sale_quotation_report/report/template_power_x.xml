<odoo>
    <template id="body_power_x">
        <table  class="table table-sm o_main_table mb-0" style="font-size:15px; border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="text-align:center; width:5%; padding:8px; line-height:1.8; border:1px solid #6c757d !important;font-weight: bold; border-radius:8px 0 0 0;">Sn</th>
                    <th style="text-align:center; width:32%; padding:8px; line-height:1.8; border:1px solid #6c757d !important;font-weight: bold">Description of Goods</th>
                    <th style="text-align:center; width:8%; padding:8px; line-height:1.8; border:1px solid #6c757d !important;font-weight: bold">Quantity</th>
                    <th style="text-align:center; width:10%; padding:8px; line-height:1.8; border:1px solid #6c757d !important;font-weight: bold">Rate</th>
                    <th style="text-align:center; width:10%; padding:8px; line-height:1.8; border:1px solid #6c757d !important;font-weight: bold">Per</th>
                    <th style="text-align:center; width:15%; padding:8px; line-height:1.8; border:1px solid #6c757d !important;font-weight: bold">Discount</th>
                    <th style="text-align:right; width:15%; padding:8px; line-height:1.8; border:1px solid #6c757d !important;font-weight: bold; border-radius:0 8px 0 0;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td style="text-align:center; padding:8px; line-height:1.8; border:1px solid #6c757d !important;">
                                <span t-esc="sn"/>
                            </td>
                            <td style="text-align:center; padding:8px; line-height:1.8; border:1px solid #6c757d !important;">
                                <span t-field="line.name"/>
                                <!-- Optional packing/weight info, only for Power X -->
                                <t t-if="line.packing_type">
                                    <br/>
                                    <small class="text-muted">
                                        Packing:
                                        <span t-esc="line.packing_type"/>
                                        <t t-if="line.packing_type == 'drum'">
                                            | Net Wt:
                                            <span t-field="line.net_weight"/>
                                            | Gross Wt:
                                            <span t-field="line.gross_weight"/>
                                        </t>
                                        <t t-elif="line.packing_type == 'ibc'">
                                            | Gross Wt:
                                            <span t-field="line.gross_weight"/>
                                            | Net Wt:
                                            <span t-field="line.net_weight"/>
                                        </t>
                                        <t t-elif="line.packing_type == 'bulk'">
                                            | Net Wt:
                                            <span t-field="line.net_weight"/>
                                        </t>
                                        <t t-elif="line.packing_type == 'flexi'">
                                            | Net Wt:
                                            <span t-field="line.net_weight"/>
                                        </t>
                                    </small>
                                </t>
                            </td>
                            <td style="text-align:center; padding:8px; line-height:1.8; border:1px solid #6c757d !important;">
                                <span t-field="line.product_uom_qty"/>
                            </td>
                            <td style="text-align:center; padding:8px; line-height:1.8; border:1px solid #6c757d !important;">
                                <span t-field="line.price_unit"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td style="text-align:center; padding:8px; line-height:1.8; border:1px solid #6c757d !important;">
                                <span t-field="line.product_uom_id.name"/>
                            </td>
                            <td style="text-align:center; padding:8px; line-height:1.8; border:1px solid #6c757d !important;"><span t-field="line.discount"/>%
                            </td>
                            <td style="text-align:right; padding:8px; line-height:1.8; border:1px solid #6c757d !important;">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
            <tfoot>
                <t t-set="total_discounted"
                   t-value="sum(o.order_line.filtered(lambda l: not l.product_id.is_expences and l.product_id.name != 'Discount').mapped('price_subtotal'))"/>
                <tr>
                    <td colspan="6" style="text-align: right; padding:8px; font-weight: bold; border:1px solid #6c757d !important; border-top:3px solid #000 !important;">Total</td>
                    <td style="text-align: right; padding:8px; font-weight: bold; border:1px solid #6c757d !important; border-top:3px solid #000 !important;">
                        <span t-esc="o.currency_id.symbol + ' ' + '{:,.2f}'.format(total_discounted)"/>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: right; padding:8px; font-weight: bold; border:1px solid #6c757d !important;">
                        <span>VAT 5%</span>
<!--                    <span t-if="o.vat_selection == 'vat_0'">VAT 0%</span>-->
                    </td>
                    <td style="text-align: right; padding:8px; font-weight: bold; border:1px solid #6c757d !important;">
                        <span t-esc="o.currency_id.symbol + ' ' + '{:,.2f}'.format(o.amount_tax)"/>
                    </td>
                </tr>
                <t t-set="expense_total"
                   t-value="sum(o.order_line.filtered(lambda l: l.product_id.is_expences).mapped('price_subtotal'))"/>
                <t t-foreach="o.order_line.filtered(lambda l: l.product_id.is_expences)" t-as="line">
                    <tr>
                        <td colspan="6" style="text-align: right; padding:8px; font-weight: bold; border:1px solid #6c757d !important;">
                            <t t-esc="line.product_id.name"/>
                        </td>
                        <td style="text-align: right; padding:8px; font-weight: bold; border:1px solid #6c757d !important;">
                            <span t-esc="o.currency_id.symbol + ' ' + '{:,.2f}'.format(line.price_subtotal)"/>
                        </td>
                    </tr>
                </t>
                <tr>
                    <td colspan="6" style="text-align: right; padding:8px; font-weight: bold; border:1px solid #6c757d !important;">Grand Total</td>
                    <td style="text-align: right; padding:8px; font-weight: bold; border:1px solid #6c757d !important;">
                        <strong t-esc="o.currency_id.symbol + ' ' + '{:,.2f}'.format(total_discounted + o.amount_tax + expense_total)"/>
                    </td>
                </tr>
            </tfoot>
        </table>


        <div class="mt-3">
            <strong>Terms &amp; Conditions:</strong>
            <div t-field="o.note"/>
            <strong>Payment terms:</strong>

            <span t-field="o.payment_term_id.name"/>
        </div>
    </template>
</odoo>
