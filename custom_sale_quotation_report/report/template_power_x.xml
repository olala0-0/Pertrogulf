<odoo>
    <template id="body_power_x">
        <table class="table table-sm o_main_table mb-0" style="font-size:15px;">
            <thead>
                <tr style="background-color:#e6e6e6;">
                    <th >Sn</th>
                    <th class="text-start">Description of Goods</th>
                    <th class="text-start">Rate</th>
                    <th class="text-start">Per</th>
                    <th class="text-start">Discount</th>
                    <th name="th_subtotal" class="text-end">
                        <span>Amount</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td><span t-esc="sn"/></td>
                            <td>
                                <span t-field="line.name"/>
                                <!-- Optional packing/weight info, only for Power X -->
                                <t t-if="line.packing_type">
                                    <br/>
                                    <small class="text-muted">
                                        Packing: <span t-esc="line.packing_type"/>
                                        <t t-if="line.packing_type == 'drum'">
                                            | Net Wt: <span t-field="line.net_weight"/> | Gross Wt: <span t-field="line.gross_weight"/>
                                        </t>
                                        <t t-elif="line.packing_type == 'ibc'">
                                            | Gross Wt: <span t-field="line.gross_weight"/> | Net Wt: <span t-field="line.net_weight"/>
                                        </t>
                                        <t t-elif="line.packing_type == 'bulk'">
                                            | Net Wt: <span t-field="line.net_weight"/>
                                        </t>
                                        <t t-elif="line.packing_type == 'flexi'">
                                            | Net Wt: <span t-field="line.net_weight"/>
                                        </t>
                                    </small>
                                </t>
                            </td>
                            <td><span t-field="line.price_unit"/></td>
                            <td><span t-field="line.product_uom_id.name"/></td>
                            <td><span t-field="line.discount"/>%</td>
                            <td class="text-right"><span t-field="line.price_subtotal"/></td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
        <table class="table table-sm o_main_table mb-0"
                   style="margin-top:0; font-size:11px; border-top:none;" >
                <tr>
                    <td style="text-align:right;width:75%">
                        <strong>Sub Total</strong>
                    </td>
                    <td colspan="3" style="text-align:right;">
                        <span t-field="o.amount_untaxed"/>
                    </td>
                </tr>
                <tr>
                    <td style="text-align:right;width:75%">
                        <strong>Vat 5%</strong>
                    </td>
                    <td colspan="3" style="text-align:right;">
                        <span t-field="o.amount_tax"/>
                    </td>
                </tr>
                <tr>
                    <td style="text-align:right;width:75%">
                        <strong>Grand Total</strong>
                    </td>
                    <td colspan="3" style="text-align:right;">
                        <span t-field="o.amount_total"/>
                    </td>
                </tr>
            </table>


        <div class="mt-3">
            <strong>Terms &amp; Conditions:</strong>
            <div t-field="o.note"/>
            <strong>Payment terms:</strong>

            <span t-field="o.payment_term_id.name"/>
        </div>
    </template>
</odoo>
