<odoo>
    <template id="body_petrogulf_aviation">
       <t t-set="show_inquired_item" t-value="any(l.inquired_item for l in o.order_line if not l.display_type)"/>
       <table class="o_has_total_table table o_main_table table-borderless mb-0" style="border-collapse:collapse;">
                <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                <thead style="display: table-row-group;text-transform: none !important;">
                    <td style=" width:4%; border:1px solid #6c757d !important; background-color:#f4b6bb;font-weight:bold; white-space:nowrap; border-radius:8px 0 0 0;">Sn</td>
                    <td t-if="show_inquired_item" class="text-start" style=" width:10%; border:1px solid #6c757d !important; background-color:#f4b6bb;font-weight:bold; white-space:nowrap">Inquired Items</td>
<!--                    <td class="text-start" style=" width:16%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Product Description</td>-->
                    <td class="text-start" style=" width:10%; border:1px solid #6c757d !important; background-color:#f4b6bb;font-weight:bold; white-space:nowrap">Offered Product</td>
                    <td class="text-start" style=" width:8%; border:1px solid #6c757d !important; background-color:#f4b6bb;font-weight:bold; white-space:nowrap">Category</td>
                    <td class="text-start" style=" width:7%; border:1px solid #6c757d !important; background-color:#f4b6bb;font-weight:bold; white-space:nowrap">Lead Time</td>
                    <td class="text-start" style=" width:7%; border:1px solid #6c757d !important; background-color:#f4b6bb;font-weight:bold; white-space:nowrap">PKG Type</td>
                    <td class="text-start" style=" width:8%; border:1px solid #6c757d !important; background-color:#f4b6bb;font-weight:bold; white-space:nowrap">Requested Qty</td>
                    <td class="text-start" style=" width:7.5%; border:1px solid #6c757d !important; background-color:#f4b6bb;font-weight:bold; white-space:nowrap">KGS Per PKG Type</td>
                    <td class="text-start" style=" width:7.5%; border:1px solid #6c757d !important; background-color:#f4b6bb;font-weight:bold; white-space:nowrap">Total KGS</td>
                    <td class="text-start" style=" width:7.5%; border:1px solid #6c757d !important; background-color:#f4b6bb;font-weight:bold; white-space:nowrap">Rate Per Pack</td>
                    <td name="th_subtotal" class="text-end" style=" width:7.5%; border:1px solid #6c757d !important; background-color:#f4b6bb;font-weight:bold; white-space:nowrap; border-radius:0 8px 0 0;">
                        <span>Amount</span>
                    </td>

                </thead>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-esc="sn"/>
                            </td>
<!--                            <td style="border:1px solid #6c757d !important;">-->
<!--                                <span t-field="line.customer_ref_id.name"/>-->
<!--                            </td>-->
                            <td t-if="show_inquired_item" style="border:1px solid #6c757d !important;">
                                <span t-field="line.inquired_item"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.offered_product"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.product_id.categ_id.name"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.leads_time"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.product_id.pack_size_id"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.product_uom_qty"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.product_id.kgs_per_pkg_type"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-esc="'{:,.2f}'.format(line.product_uom_qty * line.product_id.kgs_per_pkg_type)"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.price_unit"/>
                            </td>
                            <td class="text-right" style="border:1px solid #6c757d !important;">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
        <table class="table mt-0"
               style="width: 100%; float: right; font-size: 15px; border-collapse: collapse; border: 0 !important; border-style: none !important; box-shadow: none !important;border: 0px solid #495057 !important;border-radius: 0 !important;">
            <tr>
                <td style="text-align: right; font-weight: bold; width:77.7%">SubTotal</td>
                <td style="text-align: right; font-weight: bold;">
                    <span t-field="o.amount_untaxed"/>
                </td>
            </tr>
            <tr>
                <td style="text-align: right; font-weight: bold; width:77.7%">VAT 5%</td>
                <td style="text-align: right; font-weight: bold;">
                    <span t-field="o.amount_tax"/>
                </td>
            </tr>
            <tr>
                <td style="text-align: right; font-weight: bold; width:77.7%;">Total Amount</td>
                <td style="text-align: right; font-weight: bold;">
                    <span t-field="o.amount_total"/>
                </td>
            </tr>
        </table>
        <div class="mt-3">
            <t t-if="o.note">
                <strong>Terms &amp; Conditions:</strong>
                <div t-field="o.note"/>
            </t>
            <strong>Payment terms:</strong>

            <span t-field="o.payment_term_id.name"/>
        </div>
        <t t-if="o.show_bank_details">
            <div class="mt-3">
                <strong>Bank Details:</strong>
                <p>-- pull from o.company_id / company bank accounts here --</p>
            </div>
        </t>
    </template>
</odoo>