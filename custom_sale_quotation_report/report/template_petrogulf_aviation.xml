<odoo>
    <template id="body_petrogulf_aviation">
        <table class="table table-sm o_main_table mb-0" style="font-size:15px;">
            <thead>
                <tr style="background-color:#f4b6bb;">
                    <th style="font-weight:bold">Sn</th>
                    <th class="text-start" style="font-weight:bold">Inquired Items</th>
                    <th class="text-start" style="font-weight:bold">Product Description</th>
                    <th class="text-start" style="font-weight:bold">Offered Product</th>
                    <th class="text-start" style="font-weight:bold">Category</th>
                    <th class="text-start" style="font-weight:bold">Lead Time</th>
                    <th class="text-start" style="font-weight:bold">Pkg Type</th>
                    <th class="text-start" style="font-weight:bold">Requested Qty</th>
                    <th class="text-start" style="font-weight:bold">Kgs per Pkg Type</th>
                    <th class="text-start" style="font-weight:bold">Total Kgs</th>
                    <th class="text-start" style="font-weight:bold">Rate per Pack</th>
                    <th name="th_subtotal" class="text-end" style="font-weight:bold">
                        <span>Amount</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td>
                                <span t-esc="sn"/>
                            </td>
                            <td>
                                <span t-field="line.inquired_item"/>
                            </td>
                            <td>
                                <span t-field="line.name"/>
                            </td>
                            <td>
                                <span t-field="line.offered_product"/>
                            </td>
                            <td>
                                <span t-field="line.category"/>
                            </td>
                            <td>
                                <span t-field="line.lead_time"/>
                            </td>
                            <td>
                                <span t-field="line.pkg_type"/>
                            </td>
                            <td>
                                <span t-field="line.product_uom_qty"/>
                            </td>
                            <td>
                                <span t-field="line.kgs_per_pkg_type"/>
                            </td>
                            <td>
                                <span t-field="line.total_kgs"/>
                            </td>
                            <td>
                                <span t-field="line.rate_per_pack"/>
                            </td>
                            <td class="text-right">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
        <table class="table table-sm o_main_table mb-0"
               style="margin-top:0; font-size:15px; border-top:none;">
            <tr>
                <td style="text-align:right;width:75%;border-top:none;">
                    <strong>Sub Total</strong>
                </td>
                <td colspan="3" style="text-align:right;border-top:none;">
                    <span t-field="o.amount_untaxed"/>
                </td>
            </tr>
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Vat 5%</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_tax"/>
                </td>
            </tr>
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Total Amount</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_total"/>
                </td>
            </tr>
        </table>
        <div class="mt-3">
            <t t-if="o.note">
                <strong>Terms &amp; Conditions:</strong>
                <div t-field="o.note"/>
            </t>
            <strong>Payment terms:</strong>

            <span t-field="o.payment_term_id.name"/>
        </div>
        <t t-if="o.show_bank_details">
            <div class="mt-3">
                <strong>Bank Details:</strong>
                <p>-- pull from o.company_id / company bank accounts here --</p>
            </div>
        </t>
    </template>
</odoo>