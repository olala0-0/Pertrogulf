<odoo>
    <template id="body_petrogulf_aviation">
    <div style="position:absolute; top:-52mm; left:0; font-size:9px; color:#888;">
        Petrogulf Aviation - Quotation Template
    </div>
        <div style="position:relative; z-index:1; padding-bottom:32mm;">
            <table class="table table-sm o_main_table mb-0" style="font-size:11px;">
                <thead>
                    <tr style="background-color:#f4b6bb;">
                        <th>Sn</th>
                        <th>Inquired Items</th>
                        <th>Product Description</th>
                        <th>Offered Product</th>
                        <th>Category</th>
                        <th>Lead Time</th>
                        <th>Pkg Type</th>
                        <th>Requested Qty</th>
                        <th>Kgs per Pkg Type</th>
                        <th>Total Kgs</th>
                        <th>Rate per Pack</th>
                        <th class="text-right">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="sn" t-value="0"/>
                    <t t-foreach="o.order_line" t-as="line">
                        <t t-if="not line.display_type">
                            <t t-set="sn" t-value="sn + 1"/>
                            <tr>
                                <td>
                                    <span t-esc="sn"/>
                                </td>
                                <td>
                                    <span t-field="line.inquired_item"/>
                                </td>
                                <td>
                                    <span t-field="line.name"/>
                                </td>
                                <td>
                                    <span t-field="line.offered_product"/>
                                </td>
                                <td>
                                    <span t-field="line.category"/>
                                </td>
                                <td>
                                    <span t-field="line.lead_time"/>
                                </td>
                                <td>
                                    <span t-field="line.pkg_type"/>
                                </td>
                                <td>
                                    <span t-field="line.product_uom_qty"/>
                                </td>
                                <td>
                                    <span t-field="line.kgs_per_pkg_type"/>
                                </td>
                                <td>
                                    <span t-field="line.total_kgs"/>
                                </td>
                                <td>
                                    <span t-field="line.rate_per_pack"/>
                                </td>
                                <td class="text-right">
                                    <span t-field="line.price_subtotal"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <table class="table table-sm o_main_table mb-0"
                   style="margin-top:0; font-size:11px;">
                <tr>
                    <td style="text-align:right;width:75%">
                        <strong>Sub Total</strong>
                    </td>
                    <td colspan="3" style="text-align:right;">
                        <span t-field="o.amount_untaxed"/>
                    </td>
                </tr>
                <tr>
                    <td style="text-align:right;width:75%">
                        <strong>Vat 5%</strong>
                    </td>
                    <td colspan="3" style="text-align:right;">
                        <span t-field="o.amount_tax"/>
                    </td>
                </tr>
                <tr>
                    <td style="text-align:right;width:75%">
                        <strong>Total Amount</strong>
                    </td>
                    <td colspan="3" style="text-align:right;">
                        <span t-field="o.amount_total"/>
                    </td>
                </tr>
            </table>
            <div class="mt-3">
                <strong>Terms &amp; Conditions:</strong>
                <div t-field="o.note"/>
                <strong>Payment terms:</strong>
                <span t-field="o.payment_term_id.name"/>

                <p style="background-color:#8fd3c7; padding:4px;">
                    <strong>Once order is confirmed, any subsequent cancellation will incur applicable cancellation
                        charges.
                    </strong>
                </p>
            </div>

            <t t-if="o.show_bank_details">
                <div class="mt-3">
                    <strong>Bank Details:</strong>
                    <p>-- pull from o.company_id / company bank accounts here --</p>
                </div>
            </t>

        </div>
    </template>
</odoo>