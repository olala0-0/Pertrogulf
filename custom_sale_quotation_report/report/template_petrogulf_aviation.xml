                <table class="table mt-0"
                       style="width: 100%; font-size: 15px; border-collapse: collapse; border: 0 !important; border-style: none !important; box-shadow: none !important;border: 0px solid #495057 !important;border-radius: 0 !important;">
                    <tr>
                        <td colspan="5" style="text-align: right; font-weight: bold; border:1px solid #6c757d !important;">
                            SubTotal
                        </td>
                        <td style="text-align: right; font-weight: bold; border:1px solid #6c757d !important;">
                            <span t-field="o.amount_untaxed"/>
                        </td>
                    </tr>
