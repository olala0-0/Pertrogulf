<odoo>
    <template id="body_petrogulf_aviation">
        <table class="table table-sm o_main_table mb-0" style="font-size:15px; border-collapse:collapse;">
                <tr>
                    <td style=" width:4%; border:1px solid #6c757d !important; background-color:#f4b6bb; border-radius:8px 0 0 0;">Sn</td>
                    <td class="text-start" style=" width:10%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Inquired Items</td>
                    <td class="text-start" style=" width:16%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Product Description</td>
                    <td class="text-start" style=" width:10%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Offered Product</td>
                    <td class="text-start" style=" width:8%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Category</td>
                    <td class="text-start" style=" width:7%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Lead Time</td>
                    <td class="text-start" style=" width:7%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Pkg Type</td>
                    <td class="text-start" style=" width:8%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Requested Qty</td>
                    <td class="text-start" style=" width:8%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Kgs per Pkg Type</td>
                    <td class="text-start" style=" width:7%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Total Kgs</td>
                    <td class="text-start" style=" width:7.5%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Rate per Pack</td>
                    <td name="th_subtotal" class="text-end" style=" width:7.5%; border:1px solid #6c757d !important; background-color:#f4b6bb; border-radius:0 8px 0 0;">
                        <span>Amount</span>
                    </td>
                </tr>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-esc="sn"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.inquired_item"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.name"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.offered_product"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.category"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.lead_time"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.pkg_type"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.product_uom_qty"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.kgs_per_pkg_type"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.total_kgs"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.rate_per_pack"/>
                            </td>
                            <td class="text-right" style="border:1px solid #6c757d !important;">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
        <table class="table"
               style="width: 100%; float: right; font-size: 15px; border-collapse: collapse; border: 0 !important; border-style: none !important; box-shadow: none !important;border: 0px solid #495057 !important;border-radius: 0 !important;">
            <tr>
                <td style="text-align: right; font-weight: bold; width:78%">SubTotal</td>
                <td style="text-align: right; font-weight: bold;">
                    <span t-field="o.amount_untaxed"/>
                </td>
            </tr>
            <tr>
                <td style="text-align: right; font-weight: bold; width:78%">Vat 5%</td>
                <td style="text-align: right; font-weight: bold;">
                    <span t-field="o.amount_tax"/>
                </td>
            </tr>
            <tr>
                <td style="text-align: right; font-weight: bold; width:78%;">Total Amount</td>
                <td style="text-align: right; font-weight: bold;">
                    <span t-field="o.amount_total"/>
                </td>
            </tr>
        </table>
        <div class="mt-3">
            <t t-if="o.note">
                <strong>Terms &amp; Conditions:</strong>
                <div t-field="o.note"/>
            </t>
            <strong>Payment terms:</strong>

            <span t-field="o.payment_term_id.name"/>
        </div>
        <t t-if="o.show_bank_details">
            <div class="mt-3">
                <strong>Bank Details:</strong>
                <p>-- pull from o.company_id / company bank accounts here --</p>
            </div>
        </t>
    </template>
</odoo>