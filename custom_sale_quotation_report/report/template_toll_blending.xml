<odoo>

    <!-- ============ STANDARD TOLL BLENDING ============ -->
    <template id="body_toll_blending">
        <table class="table table-sm o_main_table mb-0" style="font-size:9px;">

            <thead>
                <tr style="background-color:#f4b6bb;">
                    <th>Sn</th>
                    <th>Product Description</th>
                    <th>Selling Unit</th>
                    <th>No of Units</th>
                    <th>Unit Price (USD)</th>
                    <th class="text-right">Amount (USD)</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td>
                                <span t-esc="sn"/>
                            </td>
                            <td>
                                <span t-field="line.name"/>
                            </td>
                            <td>
                                <span t-field="line.selling_unit"/>
                            </td>
                            <td>
                                <span t-field="line.product_uom_qty"/>
                            </td>
                            <td>
                                <span t-field="line.price_unit"/>
                            </td>
                            <td class="text-right">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
        <table class="table table-sm o_main_table mb-0"
               style="margin-top:0; font-size:9px;">
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Sub Total</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_untaxed"/>
                </td>
            </tr>
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Discount (Credit Note)</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_tax"/>
                </td>
            </tr>
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Total Amount</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_total"/>
                </td>
            </tr>

        </table>

        <p>
            <strong>Total Amount in words:</strong>
            <span t-esc="o._get_amount_in_words()"/>
        </p>
        <div class="mt-3">
            <strong>Terms &amp; Conditions:</strong>
            <div t-field="o.port_note"/>
            <strong>Payment terms:</strong>
            <span t-field="o.payment_term_id.name"/>
        </div>

    </template>

    <!-- ============ TOLL BLENDING - ADNOC VARIANT ============ -->
    <!-- Simplified: no qty/amount/totals shown, only product type/description/selling unit/unit price -->
    <template id="body_toll_blending_adnoc">
        <table class="table table-sm o_main_table">
            <thead>
                <tr style="background-color:#f4b6bb;">
                    <th>Sn</th>
                    <th>Product Type</th>
                    <th>Product Description</th>
                    <th>Selling Unit</th>
                    <th class="text-right">Unit Price</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td>
                                <span t-esc="sn"/>
                            </td>
                            <td>
                                <span t-field="line.product_type"/>
                            </td>
                            <td>
                                <span t-field="line.name"/>
                            </td>
                            <td>
                                <span t-field="line.selling_unit"/>
                            </td>
                            <td class="text-right">
                                <span t-field="line.price_unit"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>

        <p>
            <strong>Total Amount in words:</strong>
            <span t-esc="o._get_amount_in_words()"/>
        </p>

        <div class="mt-3">
            <strong>Terms &amp; Conditions:</strong>
            <ul>
                <div t-field="o.port_note"/>
            </ul>
            <strong>Payment terms:</strong>
            <span t-field="o.payment_term_id.name"/>
        </div>

        <t t-if="o.show_bank_details">
            <div class="mt-3">
                <strong>Bank Details:</strong>
                <p>-- pull from o.company_id / company bank accounts here --</p>
            </div>
        </t>
    </template>

</odoo>
