<odoo>

    <!-- ============ STANDARD TOLL BLENDING ============ -->
    <template id="body_toll_blending">
        <table class="table table-sm o_main_table mb-0" style="font-size:15px; border-collapse:collapse;">
            <thead>
                <tr>
                    <th class="text-center" style="font-weight:bold; width:5%; border:1px solid #6c757d !important; background-color:#f4b6bb; border-radius:8px 0 0 0;">SN</th>
                    <th style="font-weight:bold; width:45%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Product Description</th>
                    <th style="font-weight:bold; width:15%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Selling Unit</th>
                    <th style="font-weight:bold; width:12%; border:1px solid #6c757d !important; background-color:#f4b6bb;">No of Units</th>
                    <th style="font-weight:bold; width:11.5%; border:1px solid #6c757d !important; background-color:#f4b6bb;">Unit Price</th>
                    <th class="text-end" style="font-weight:bold; width:11.5%; border:1px solid #6c757d !important; background-color:#f4b6bb; border-radius:0 8px 0 0;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td class="text-center" style="border:1px solid #6c757d !important;">
                                <span t-esc="sn"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.name"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.product_uom_id.name"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.product_uom_qty"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td class="text-end" style="border:1px solid #6c757d !important;">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
        <table t-if="o.show_total" class="table"
               style="width: 100%; float: right; font-size: 15px; border-collapse: collapse; border: 0 !important; border-style: none !important; box-shadow: none !important;border: 0px solid #495057 !important;border-radius: 0 !important;">
            <tr>
                <td style="text-align: right; font-weight: bold; width: 77%; border-top:3px solid #000 !important;">Sub Total</td>
                <td style="text-align: right; font-weight: bold; border-top:3px solid #000 !important;">
                    <span t-field="o.amount_untaxed"/>
                </td>
            </tr>
            <tr t-if="o.show_vat">
                <td style="text-align: right; font-weight: bold; width: 77%;">Vat 5%</td>
                <td style="text-align: right; font-weight: bold;">
                    <span t-field="o.amount_tax"/>
                </td>
            </tr>
            <tr t-if="o.show_credit_note">
                <td colspan="2" style="text-align: right; font-weight: bold;">Credit Note</td>
            </tr>
            <tr>
                <td style="text-align: right; font-weight: bold; width: 77%;">Total Amount</td>
                <td style="text-align: right; font-weight: bold;">
                    <span t-field="o.amount_total"/>
                </td>
            </tr>
        </table>

        <p>
            <strong>Total Amount in words:</strong>
            <span style="font-weight:bold;"  t-esc="o._get_amount_in_words()"/>
        </p>
        <div class="mt-3">
            <strong>Terms &amp; Conditions:</strong>
            <div t-field="o.note"/>
            <strong>Payment terms:</strong>

            <span t-field="o.payment_term_id.name"/>

        </div>

        <t t-if="o.show_bank_details">
            <div class="mt-3">
                <strong>Bank Details:</strong>
                <p>-- pull from o.company_id / company bank accounts here --</p>
            </div>
        </t>

    </template>

    <!-- ============ TOLL BLENDING - ADNOC VARIANT ============ -->
    <!-- Simplified: no qty/amount/totals shown, only product type/description/selling unit/unit price -->
    <template id="body_toll_blending_adnoc">
        <table class="table table-sm o_main_table" style="border-collapse:collapse;">
            <thead>
                <tr>
                    <th class="text-center" style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb; border-radius:8px 0 0 0;">SN</th>
                    <th style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb;">Product Type</th>
                    <th style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb;">Product Description</th>
                    <th style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb;">Pack Size</th>
                    <th class="text-end" style="font-weight:bold; border:1px solid #6c757d !important; background-color:#f4b6bb; border-radius:0 8px 0 0;">Unit Price</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td class="text-center" style="border:1px solid #6c757d !important;">
                                <span t-esc="sn"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.product_id.type"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.name"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.product_uom_id.name"/>
                            </td>
                            <td class="text-end" style="border:1px solid #6c757d !important;">
                                <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>

        <div class="mt-3">
            <strong>Terms &amp; Conditions:</strong>
            <ul>
                <div t-field="o.port_note"/>
            </ul>
            <strong>Payment terms:</strong>
            <span t-field="o.payment_term_id.name"/>
        </div>

        <t t-if="o.show_bank_details">
            <div class="mt-3">
                <strong>Bank Details:</strong>
                <p>-- pull from o.company_id / company bank accounts here --</p>
            </div>
        </t>
    </template>

</odoo>
