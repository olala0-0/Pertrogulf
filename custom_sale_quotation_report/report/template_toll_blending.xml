<odoo>

    <!-- ============ STANDARD TOLL BLENDING ============ -->
    <template id="body_toll_blending">
        <table class="table table-sm o_main_table" style="border:1px solid #333;">
            <thead>
                <tr style="background-color:#f4b6bb;">
                    <th>Sn</th>
                    <th>Product Description</th>
                    <th>Selling Unit</th>
                    <th>No of Units</th>
                    <th>Unit Price (USD)</th>
                    <th class="text-right">Amount (USD)</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td><span t-esc="sn"/></td>
                            <td><span t-field="line.name"/></td>
                            <td><span t-field="line.selling_unit"/></td>
                            <td><span t-field="line.product_uom_qty"/></td>
                            <td><span t-field="line.price_unit"/></td>
                            <td class="text-right"><span t-field="line.price_subtotal"/></td>
                        </tr>
                    </t>
                </t>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" class="text-right"><strong>Sub Total</strong></td>
                    <td class="text-right"><span t-field="o.amount_untaxed"/></td>
                </tr>
                <t t-if="o.show_credit_note">
                    <tr>
                        <td colspan="5" class="text-right"><strong>Discount (Credit Note)</strong></td>
                        <td class="text-right">-</td>
                    </tr>
                </t>
                <t t-if="o.show_vat">
                    <tr>
                        <td colspan="5" class="text-right"><strong>Vat 5%</strong></td>
                        <td class="text-right"><span t-field="o.amount_tax"/></td>
                    </tr>
                </t>
                <tr>
                    <td colspan="5" class="text-right"><strong>Total Amount</strong></td>
                    <td class="text-right"><span t-field="o.amount_total"/></td>
                </tr>
            </tfoot>
        </table>

        <p><strong>Total Amount in words: </strong><span t-esc="o._get_amount_in_words()"/></p>

        <div class="mt-3">
            <strong>Terms &amp; Conditions:</strong>
            <ul>
                <li>Lead time: 4-5 working day(s) subject to availability.</li>
                <li>Delivery care of agent: Boat to be arranged by the Agent under Owners account for supply at the anchorage</li>
                <li>Pumping if required USD 600.00/- additional charges applicable.</li>
                <li>Duty free for vessel under foreign run.</li>
                <li>Prices are valid for the requested quantities only.</li>
                <li>Any change in volume, delivery point, or conditions may result in a revised price.</li>
                <li>Deliveries are always subject to weather conditions and "Force Majeure".</li>
                <li>Availability and any additional charges (if applicable) are subject to reconfirmation upon nomination.</li>
            </ul>
            <strong>Payment terms: 30 Days</strong>
        </div>

        <t t-if="o.show_bank_details">
            <div class="mt-3">
                <strong>Bank Details:</strong>
                <p>-- pull from o.company_id / company bank accounts here --</p>
            </div>
        </t>
    </template>

    <!-- ============ TOLL BLENDING - ADNOC VARIANT ============ -->
    <!-- Simplified: no qty/amount/totals shown, only product type/description/selling unit/unit price -->
    <template id="body_toll_blending_adnoc">
        <table class="table table-sm o_main_table" style="border:1px solid #333;">
            <thead>
                <tr style="background-color:#f4b6bb;">
                    <th>Sn</th>
                    <th>Product Type</th>
                    <th>Product Description</th>
                    <th>Selling Unit</th>
                    <th class="text-right">Unit Price</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td><span t-esc="sn"/></td>
                            <td><span t-field="line.product_type"/></td>
                            <td><span t-field="line.name"/></td>
                            <td><span t-field="line.selling_unit"/></td>
                            <td class="text-right"><span t-field="line.price_unit"/></td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>

        <p><strong>Total Amount in words: </strong><span t-esc="o._get_amount_in_words()"/></p>

         <div class="mt-3">
            <strong>Terms &amp; Conditions:</strong>
            <ul>
               <div t-field="o.note"/>
            </ul>
           <strong>Payment terms: </strong><span t-field="o.payment_term_id.name"/>
        </div>

        <t t-if="o.show_bank_details">
            <div class="mt-3">
                <strong>Bank Details:</strong>
                <p>-- pull from o.company_id / company bank accounts here --</p>
            </div>
        </t>
    </template>

</odoo>
