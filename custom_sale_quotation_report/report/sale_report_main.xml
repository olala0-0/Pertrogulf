<odoo>

    <template id="report_saleorder_business_unit">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 14px;">
                        <div class="oe_structure"/>
                        <div t-if="o.company_id.business_unit not in ('pg_marine', 'pg_greece', 'pg_sing')"
                             style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 1px;">
                            QUOTATION
                        </div>

                        <div class="row col-12 mb4">
                            <div class="col-6">
                                <span style="font-size:20px !important; ">Quotation No:</span>
                                <span style="font-size:20px;" t-field="o.name"/>
                                <br/>
                                <span style="font-size:20px !important; font-weight:bold;">Kind Attn:</span>
                                <span style="font-size:20px; font-weight:bold;" t-field="o.inquiry_rec_from"/>
                                <br/>
                                <span style="font-size:20px !important; ">Customer Name:</span>
                                <span style="font-size:20px;" t-field="o.partner_id.name"/>
                                <br/>
                                <span style="font-size:20px !important; ">Customer Address:</span>
                                <span style="font-size:20px !important;" t-field="o.partner_id.street"></span>
                                <span style="font-size:20px !important;" t-field="o.partner_id.street2"></span>
                                <span style="font-size:20px !important;" t-field="o.partner_id.city"></span>
                                <span style="font-size:20px !important;"
                                      t-field="o.partner_id.country_id.name"></span>
                                <t t-if="o.partner_id.phone and o.company_id.business_unit not in ('pg_marine', 'pg_greece', 'pg_sing')">
                                    <br/>
                                    <span style="font-size:20px !important; ">Contact No:</span>
                                    <span style="font-size:20px;" t-field="o.partner_id.phone"/>
                                </t>
                            </div>
                            <div t-if="o.company_id.business_unit == 'pg_aviation'" class="col-6 text-end">
                                <img src="data:image/png;base64," style="max-width:280px; max-height:130px;"/>
                            </div>
                        </div>


                        <div class="row mb-4 mt32" id="informations">
                            <div t-if="o.client_order_ref" class="col" name="informations_reference">
                                <strong>Your Reference</strong>
                                <div t-field="o.client_order_ref">SO0000</div>
                            </div>
                            <div t-if="o.date_order" class="col" name="informations_date">
                                <strong t-if="o.state in ['draft', 'sent']">Quotation Date</strong>
                                <strong t-else="">Order Date</strong>
                                <div t-field="o.date_order" t-options='{"widget": "date"}'>2023-12-31</div>
                            </div>
                            <div class="col" name="expiration_date">
                                <strong>Quote Valid Till Date</strong>
                                <div t-field="o.validity_date">2023-12-31</div>
                            </div>
                            <div t-if="o.create_uid.name" class="col">
                                <strong>Quoted by</strong>
                                <div t-field="o.create_uid">Mitchell Admin</div>
                            </div>
                            <t t-if="o.company_id.business_unit in ('pg_marine', 'pg_greece','pg_sing')">
                                <div t-if="o.vessel_no_id" class="col" name="vessel_no">
                                    <strong>Vessel Name</strong>
                                    <div t-field="o.vessel_no_id.name"></div>
                                </div>
                                <div t-if="o.imo_number" class="col" name="imo_number">
                                    <strong>IMO No</strong>
                                    <div t-field="o.imo_number"></div>
                                </div>
                                <div t-if="o.port_master_id" class="col" name="port_master_id">
                                    <strong>Port Name</strong>
                                    <div t-field="o.port_master_id.name"></div>
                                </div>
                            </t>
                            <!-- Aviation-only extra header fields -->
                            <t t-if="o.company_id.business_unit == 'pg_aviation'">
                                <div class="col" name="aircraft_reg_details">
                                    <strong>Aircraft Reg Details</strong>
                                    <div t-field="o.aircraft_reg_details"></div>
                                </div>
                                <div class="col" name="aircraft_type">
                                    <strong>Aircraft Type</strong>
                                    <div t-field="o.aircraft_type"></div>
                                </div>
                                <div class="col" name="country_of_origin">
                                    <strong>Country of Origin</strong>
                                    <div t-field="o.country_of_origin"></div>
                                </div>
                            </t>
                        </div>


                        <!-- ============ BUSINESS UNIT DISPATCH ============ -->

                        <t t-if="o.company_id.business_unit == 'pg_powerx'">
                            <t t-call="custom_sale_quotation_report.body_power_x"/>
                        </t>

                        <t t-elif="o.company_id.business_unit == 'pg_auto'">
                            <t t-call="custom_sale_quotation_report.body_petrogulf_automotive"/>
                        </t>

                        <t t-elif="o.company_id.business_unit == 'pg_aviation'">
                            <t t-call="custom_sale_quotation_report.body_petrogulf_aviation"/>
                        </t>

                        <t t-elif="o.company_id.business_unit == 'pg_tblnd' and o.partner_id.is_adnoc">
                            <t t-call="custom_sale_quotation_report.body_toll_blending_adnoc"/>
                        </t>

                        <t t-elif="o.company_id.business_unit == 'pg_tblnd'">
                            <t t-call="custom_sale_quotation_report.body_toll_blending"/>
                        </t>
                        <t t-elif="o.company_id.business_unit in ('pg_marine', 'pg_greece', 'pg_sing')">
                            <t t-call="custom_sale_quotation_report.body_petrogulf_marine"/>
                        </t>

                        <t t-elif="o.company_id.business_unit == 'pg_golden'">
                            <t t-call="custom_sale_quotation_report.body_golden"/>
                        </t>

                        <t t-else="">
                            <!-- Fallback: generic layout if business_unit is not set / unrecognized -->
                            <p class="text-danger">
                                No quotation layout configured for business unit:
                                <span t-esc="o.company_id.business_unit"/>.
                                Falling back to default line table.
                            </p>
                            <t t-call="custom_sale_quotation_report.body_power_x"/>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
