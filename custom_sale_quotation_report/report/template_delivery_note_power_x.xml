<odoo>
    <!--
        Standalone Power X "Delivery Note" print layout - built to match
        PX/Others/Delivery Note Format - Power X.pdf exactly.

        Bound to stock.picking (this is a dispatch/delivery document, not
        a quotation) - reuses the vehicle_no / driver_name / driver_id /
        container_no / document_number / invoice_no fields zilancer_customisation
        already adds to stock.picking. Fields with no equivalent anywhere in
        this codebase today (Terms of Delivery, Date & Time In/Out, Material,
        Loaded/Empty/Net Weight, Operator, Container #2, Tank No., Vat
        Amount, Total Amount) are rendered as label-only, blank cells for
        manual fill-in.

        Deliberately does NOT use web.external_layout (that renders Odoo's
        generic Document Layout header/footer) since this format has its
        own fixed letterhead (grey banner + diagonal cut + logo left /
        title right) that must be reproduced pixel-for-pixel.
    -->
    <template id="report_delivery_note_power_x">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article">
                    <div class="page" style="font-size:12px;">

                        <!-- ============ LETTERHEAD ============ -->
                        <div style="position:relative; background-color:#e6e6e6; padding:0 24px; overflow:hidden; height:90px;">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)"
                                 style="max-height:65px; margin-top:12px; position:relative; z-index:2;"/>
                            <div style="position:absolute; top:0; left:340px; width:110px; height:90px; background-color:#ffffff; transform:skewX(-20deg); z-index:1;"/>
                            <div style="position:absolute; top:0; left:400px; right:0; height:90px; background-color:#ffffff; z-index:1;"/>
                            <div style="position:absolute; top:0; right:60px; height:90px; z-index:2;">
                                <span style="font-size:22px; font-weight:bold; line-height:90px; white-space:nowrap;">DELIVERY NOTE</span>
                            </div>
                        </div>

                        <!-- ============ COMPANY / DOC INFO ============ -->
                        <div class="row mt-3">
                            <div class="col-6">
                                <div><strong><span t-field="o.company_id.name"/></strong></div>
                                <div><span t-field="o.company_id.street"/></div>
                                <div>
                                    <span t-field="o.company_id.city"/><t t-if="o.company_id.city and o.company_id.country_id"> , </t><span t-field="o.company_id.country_id.name"/>
                                </div>
                                <div t-if="o.company_id.phone"><span t-field="o.company_id.phone"/></div>
                                <div t-if="o.company_id.email"><span t-field="o.company_id.email"/></div>
                                <div t-if="o.company_id.website"><span t-field="o.company_id.website"/></div>
                                <div>TRN <span t-field="o.company_id.vat"/></div>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm mb-0" >
                                    <tr>
                                        <td style="background-color:#e6e6e6;">Delivery Order No.</td>
                                        <td style="background-color:transparent !important;"><span t-field="o.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="background-color:#e6e6e6;">Date</td>
                                        <td style="background-color:transparent !important;"><span t-field="o.scheduled_date" t-options="{'widget': 'date'}"/></td>
                                    </tr>
                                    <tr>
                                        <td style="background-color:#e6e6e6;">Invoice No.</td>
                                        <td style="background-color:transparent !important;"><span t-field="o.invoice_no"/></td>
                                    </tr>
                                    <tr>
                                        <td style="background-color:#e6e6e6;">Order Reference:</td>
                                        <td style="background-color:transparent !important;"><span t-field="o.origin"/></td>
                                    </tr>
                                    <tr>
                                        <td style="background-color:#e6e6e6;">Terms of Delivery</td>
                                        <td style="background-color:transparent !important;"></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ============ BUYER ============ -->
                        <div style="background-color:#e6e6e6; padding:4px 8px; font-weight:bold; margin-top:16px;">Buyer</div>
                        <div class="row mt-2">
                            <div class="col-6">
                                <table class="table table-sm mb-0" >
                                    <tr>
                                        <td style="width:35%;background-color:#e6e6e6;" >Company Name</td>
                                        <td style="width:5%;">:</td>
                                        <td ><span t-field="o.partner_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="background-color:#e6e6e6;">Address</td>
                                        <td >:</td>
                                        <td >
                                            <span t-field="o.partner_id"
                                                  t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': True}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="background-color:#e6e6e6;">Contact No.</td>
                                        <td >:</td>
                                        <td ><span t-field="o.partner_id.phone"/></td>
                                    </tr>
                                    <tr>
                                        <td style="background-color:#e6e6e6;">TRN</td>
                                        <td >:</td>
                                        <td ><span t-field="o.partner_id.vat"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table style="font-size:11px; border-collapse:collapse; width:100%;">
                                    <tr>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">DN No.</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"><span t-field="o.document_number"/></td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Date &amp; Time In</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Vehicle No.</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"><span t-field="o.vehicle_no"/></td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Date &amp; Time Out</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Driver</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"><span t-field="o.driver_name"/></td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">EID - No.</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"><span t-field="o.driver_id"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Customer</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"><span t-field="o.partner_id.name"/></td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Container #1</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"><span t-field="o.container_no"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Material</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Container #2</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Loaded Weight</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">TANK NO</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Empty Weight</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Vat Amount</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Net Weight</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Total Amount</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;background-color:#e6e6e6;">Operator</td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                        <td style="border:1px solid #f7f5f5; padding:2px 4px;"></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ============ LINE ITEMS ============ -->
                        <table class="table table-sm o_main_table mt-3">
                            <thead>
                                <tr style="background-color:#d9d9d9;">
                                    <th>Sn</th>
                                    <th>Description of Goods</th>
                                    <th class="text-right">Quantity</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="sn" t-value="0"/>
                                <t t-foreach="o.move_ids" t-as="move">
                                    <t t-set="sn" t-value="sn + 1"/>
                                    <tr>
                                        <td><span t-esc="sn"/></td>
                                        <td><span t-field="move.product_id.name"/></td>
                                        <td class="text-right"><span t-field="move.product_uom_qty"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color:#e6e6e6;">
                                    <td colspan="2" class="text-right"><strong>Total</strong></td>
                                    <td class="text-right">
                                        <span t-esc="sum(o.move_ids.mapped('product_uom_qty'))"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ============ SIGNATURE ============ -->
                        <div class="text-end mt-4" style="text-align:right;">
                            <div>for <span t-field="o.company_id.name"/></div>
                            <div style="margin-top:36px;"><strong>Authorised Signatory</strong></div>
                        </div>

                        <!-- ============ DECLARATION / FOOTER ============ -->
                        <div class="mt-4">
                            <div style="text-decoration:underline;">Declaration</div>
                            <div>We declare that this invoice shows the actual price of the goods
                                described and that all particulars are true and correct</div>
                            <div style="color:#c0392b; font-style:italic; font-weight:bold; text-align:right; margin-top:8px;">
                                Leave your Base Oil with us
                            </div>
                            <div class="text-center mt-2" style="text-align:center;">This is a Computer Generated Invoice</div>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>