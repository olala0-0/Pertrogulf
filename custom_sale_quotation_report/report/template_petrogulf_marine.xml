<odoo>
    <template id="body_petrogulf_marine">
        <style>
            .article {
            padding-left: 0 !important;
            padding-right: 0 !important;
            }
        </style>

        <t t-set="regular_lines"
           t-value="o.order_line.filtered(lambda l: not l.display_type and not l.product_id.is_expences)"/>
        <t t-set="expense_lines"
           t-value="o.order_line.filtered(lambda l: not l.display_type and l.product_id.is_expences)"/>
        <t t-set="pg_total" t-value="sum(regular_lines.mapped('price_subtotal'))"/>
        <t t-set="pg_discount" t-value="sum(regular_lines.mapped('discount_value'))"/>
        <t t-set="pg_discounted_value" t-value="pg_total - pg_discount"/>
        <t t-set="pg_expense_total" t-value="sum(expense_lines.mapped('price_subtotal'))"/>

        <!-- These two are always shown (0.00 if not on the order), matching the
             fixed row layout in the sample - any other OOS-type expense line is
             still caught and listed separately below them. -->
        <t t-set="pg_delivery_charge_lines"
           t-value="expense_lines.filtered(lambda l: l.product_id.name == 'Delivery Charge - OOS')"/>
        <t t-set="pg_port_charge_lines"
           t-value="expense_lines.filtered(lambda l: l.product_id.name == 'Port and Custom Charges - OOS')"/>
        <t t-set="pg_other_expense_lines" t-value="expense_lines - pg_delivery_charge_lines - pg_port_charge_lines"/>

        <table class="table table-sm o_main_table mb-0" style="font-size:15px; border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="border:1px solid #6c757d !important; background-color:#619FAF; border-radius:8px 0 0 0;">Sn</th>
                    <th class="text-start" style="border:1px solid #6c757d !important; background-color:#619FAF;">Inquired Item</th>
                    <th class="text-start" style="border:1px solid #6c757d !important; background-color:#619FAF;">Offered Item</th>
                    <th class="text-start" style="border:1px solid #6c757d !important; background-color:#619FAF;">Pack Size</th>
                    <th class="text-start" style="border:1px solid #6c757d !important; background-color:#619FAF;">No of Units</th>
                    <th class="text-start" style="border:1px solid #6c757d !important; background-color:#619FAF;">Unit Price</th>
                    <th name="th_subtotal" class="text-end" style="border:1px solid #6c757d !important; background-color:#619FAF; border-radius:0 8px 0 0;">
                        <span>Amount</span>
                    </th>

                </tr>
            </thead>
            <tbody class="sale_tbody">
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-esc="sn"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.customer_ref_id.name"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.product_template_id"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.pack_size_id.name"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.product_uom_qty"/>
                            </td>
                            <td style="border:1px solid #6c757d !important;">
                                <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td class="text-end" style="border:1px solid #6c757d !important;">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" style="text-align:right; border:1px solid #6c757d !important; border-top:3px solid #000 !important;">
                        <strong>Total</strong>
                    </td>
                    <td colspan="2" class="text-end" style="text-align:right; border:1px solid #6c757d !important; border-top:3px solid #000 !important;">
                        <span t-esc="pg_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                    </td>
                </tr>
                <tr t-if="pg_discount">
                    <td colspan="5" style="text-align:right; border:1px solid #6c757d !important;">
                        <strong>Discount</strong>
                    </td>
                    <td colspan="2" class="text-end" style="text-align:right; border:1px solid #6c757d !important;">
                        <span t-esc="pg_discount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                    </td>
                </tr>
                <tr t-if="pg_discount">
                    <td colspan="5" style="text-align:right; border:1px solid #6c757d !important;">
                        <strong>Discounted Value</strong>
                    </td>
                    <td colspan="2" class="text-end" style="text-align:right; border:1px solid #6c757d !important;">
                        <span t-esc="pg_discounted_value"
                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                    </td>
                </tr>
                <tr>
                    <td colspan="5" style="text-align:right; border:1px solid #6c757d !important;">
                        <strong>Delivery Charge - OOS</strong>
                    </td>
                    <td colspan="2" class="text-end" style="text-align:right; border:1px solid #6c757d !important;">
                        <span t-esc="sum(pg_delivery_charge_lines.mapped('price_subtotal'))"
                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                    </td>
                </tr>
                <tr>
                    <td colspan="5" style="text-align:right; border:1px solid #6c757d !important;">
                        <strong>Port and Custom Charges - OOS</strong>
                    </td>
                    <td colspan="2" class="text-end" style="text-align:right; border:1px solid #6c757d !important;">
                        <span t-esc="sum(pg_port_charge_lines.mapped('price_subtotal'))"
                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                    </td>
                </tr>
                <t t-foreach="pg_other_expense_lines" t-as="line">
                    <tr>
                        <td colspan="5" style="text-align:right; border:1px solid #6c757d !important;">
                            <strong>
                                <span t-field="line.product_id.name"/>
                            </strong>
                        </td>
                        <td colspan="2" class="text-end" style="text-align:right; border:1px solid #6c757d !important;">
                            <span t-field="line.price_subtotal"/>
                        </td>
                    </tr>
                </t>
                <tr>
                    <td colspan="5" style="text-align:right; border:1px solid #6c757d !important;">
                        <strong>Grand Total</strong>
                    </td>
                    <td colspan="2" class="text-end" style="text-align:right; border:1px solid #6c757d !important;">
                        <span t-esc="o.currency_id.symbol"/>
                        <span t-esc="'{:,.2f}'.format(pg_discounted_value + pg_expense_total)"/>
                    </td>
                </tr>
            </tfoot>
        </table>
        <div class="mt-3">
            <t t-if="o.port_note">
                <strong>Terms &amp; Conditions:</strong>
                <div t-field="o.port_note"/>
            </t>
            <strong>Payment terms:</strong>

            <span t-field="o.payment_term_id.name"/>

        </div>

        <t t-if="o.show_bank_details">
            <div class="mt-3">
                <strong>Bank Details:</strong>
                <p>-- pull from o.company_id / company bank accounts here --</p>
            </div>
        </t>

    </template>
</odoo>
