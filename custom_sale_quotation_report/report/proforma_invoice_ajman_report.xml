<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_proforma_invoice_ajman">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="bank" t-value="o.company_id.partner_id.bank_ids[:1]"/>
                <t t-set="delivery" t-value="o.picking_ids.filtered(lambda p: p.picking_type_id.code == 'outgoing')[:1]"/>
                <t t-set="is_powerx" t-value="o.company_id.business_unit == 'pg_powerx'"/>
                <div class="page" style="font-size:12px; padding:0; margin:0;">

                    <!-- ============ HEADER (letterhead banner, SVG shape as background image) ============ -->
                    <div style="width:100%; height:42mm; background-repeat:no-repeat; background-size:100% 100%; background-image:url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyMTAgNDIiIHByZXNlcnZlQXNwZWN0UmF0aW89Im5vbmUiPjxwb2x5Z29uIHBvaW50cz0iMCwwIDIxMCwwIDIxMCwxNC40IDk5LjMsMTQuNCA4Ny45LDQyIDAsNDIiIGZpbGw9IiNkMWQzZDQiLz48L3N2Zz4=');">
                    <table style="width:100%; height:42mm; table-layout:fixed; border-collapse:collapse;">
                        <colgroup>
                            <col style="width:93mm;"/>
                            <col style="width:117mm;"/>
                        </colgroup>
                        <tr>
                            <td style="padding:3mm 4mm; vertical-align:middle; text-align:left;">
                                <img t-if="o.company_id.logo" t-att-src="o.company_id.get_logo_on_background()" style="max-height:36mm; max-width:100%;"/>
                            </td>
                            <td style="padding:6mm 18mm 6mm 4mm; vertical-align:middle; text-align:right;">
                                <span style="font-size:34px; font-weight:bold; color:#231f20;">PROFORMA INVOICE</span>
                            </td>
                        </tr>
                    </table>
                    </div>

                    <div style="padding:3mm 7mm 0 7mm;">

                    <table style="width:100%; border-collapse:collapse; margin-bottom:15px;">
                        <tr>
                            <td style="width:55%; vertical-align:top; font-size:12px;">
                                <div><strong t-field="o.company_id.name"/></div>
                                <div t-if="o.company_id.street"><span t-field="o.company_id.street"/></div>
                                <div t-if="o.company_id.phone"><span t-field="o.company_id.phone"/></div>
                                <div t-if="o.company_id.email"><span t-field="o.company_id.email"/></div>
                                <div t-if="o.company_id.website"><span t-esc="o.company_id.website.replace('http://', '').replace('https://', '')"/></div>
                            </td>
                            <td style="width:45%; vertical-align:top;">
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2; width:35%;">
                                            <strong><span t-esc="'Proforma Invoice No.' if is_powerx else 'Invoice No'"/></strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong><span t-esc="'Date' if is_powerx else 'Invoice Date'"/></strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.date_order" t-options="{'widget': 'date'}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong><span t-esc="'Seller TRN' if is_powerx else 'TRN'"/></strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.company_id.vat"/>
                                        </td>
                                    </tr>
                                    <tr t-if="is_powerx">
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>Purchase Order No. and Date</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.client_po_order_no"/>
                                        </td>
                                    </tr>
                                    <tr t-if="is_powerx">
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>Sales Incharge</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.user_id.name"/>
                                        </td>
                                    </tr>
                                    <tr t-if="is_powerx">
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>Payment Terms</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.payment_term_id.name"/>
                                        </td>
                                    </tr>
                                    <tr t-if="is_powerx">
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>Exchange Rate</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;"> </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ BUYER / INVOICE DETAILS ============ -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:15px;">
                        <tr>
                            <td style="width:48%; vertical-align:top;">
                                <div style="background-color:#d9d9d9; padding:4px 6px; font-weight:bold;">Buyer</div>
                                <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:12px;">
                                    <tr>
                                        <td style="padding:4px; width:40%;">Company Name</td>
                                        <td style="padding:4px;">: <span t-field="o.partner_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;">Address</td>
                                        <td style="padding:4px;">:
                                            <span t-field="o.partner_id.street"/>
                                            <t t-if="o.partner_id.street2">, <span t-field="o.partner_id.street2"/></t>
                                            <t t-if="o.partner_id.city">, <span t-field="o.partner_id.city"/></t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;">Contact No.</td>
                                        <td style="padding:4px;">: <span t-field="o.partner_id.phone"/></td>
                                    </tr>
                                    <t t-if="not is_powerx">
                                        <tr>
                                            <td style="padding:4px;">Emirate</td>
                                            <td style="padding:4px;">: <span t-field="o.partner_id.state_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding:4px;">Country</td>
                                            <td style="padding:4px;">: <span t-field="o.partner_id.country_id.name"/></td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td style="padding:4px;">TRN</td>
                                        <td style="padding:4px;">: <span t-field="o.partner_id.vat"/></td>
                                    </tr>
                                    <tr t-if="not is_powerx">
                                        <td style="padding:4px;">Place of supply</td>
                                        <td style="padding:4px;">: </td>
                                    </tr>
                                </table>
                            </td>
                            <td style="width:4%;"/>
                            <td style="width:48%; vertical-align:top;">
                                <div style="background-color:#d9d9d9; padding:4px 6px; font-weight:bold;">
                                    <span t-esc="'Delivery Details' if is_powerx else 'Invoice Details'"/>
                                </div>
                                <table t-if="is_powerx" style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:12px;">
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%;">Vehicle No.</td>
                                        <td style="padding:4px;">Contact No.</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;"><span t-field="delivery.vehicle_no"/></td>
                                        <td style="padding:4px;"><span t-field="o.partner_id.phone"/></td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px;">WS No.</td>
                                        <td style="padding:4px;">Delivery Note No.</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;"> </td>
                                        <td style="padding:4px;"><span t-field="delivery.document_number"/></td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px;" colspan="2">Terms</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;" colspan="2"> </td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px;">Place of Supply</td>
                                        <td style="padding:4px;">Place of Loading</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;"> </td>
                                        <td style="padding:4px;"><span t-field="o.port_master_id.name"/></td>
                                    </tr>
                                </table>
                                <table t-else="" style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:12px; table-layout:fixed;">
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Delivery Note No.</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Delivery Note Date</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;">&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;">&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Vessel Name</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">IMO No</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="o.vessel_no_id.name"/>&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="o.imo_number"/>&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Buyer's Order No.</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Dated</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="o.client_po_order_no"/>&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="o.buyers_date"/>&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Despatch Document No.</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Despatch Note Date</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="delivery.document_number"/>&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;">&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Despatch Document Date</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Payment Terms</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;">&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="o.payment_term_id.name"/>&#160;</td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Despatched through</td>
                                        <td style="padding:4px; width:50%; white-space:nowrap;">Port</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; width:50%; vertical-align:top;">&#160;</td>
                                        <td style="padding:4px; width:50%; vertical-align:top;"><span t-field="o.port_master_id.name"/>&#160;</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <div t-if="is_powerx" style="font-weight:bold; margin:-10px 0 15px 0;">FREE ZONE TO FREE ZONE</div>

                    <!-- ============ LINE ITEMS ============ -->
                    <table class="table table-sm" style="width:100%; border-collapse:collapse; font-size:11px;">
                        <thead>
                            <tr style="background-color:#d9d9d9;">
                                <th style="border:1px solid #ccc; padding:4px;">Sn</th>
                                <th style="border:1px solid #ccc; padding:4px;">Description of Goods</th>
                                <th t-if="not is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">Packaging</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">Quantity</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">
                                    <span t-esc="'Rate Per Unit' if is_powerx else 'Rate'"/>
                                </th>
                                <th t-if="not is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">Per</th>
                                <th t-if="not is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">VAT %</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">Amount</th>
                                <th t-if="is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">VAT Rate</th>
                                <th t-if="is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">Taxable Value</th>
                                <th t-if="is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">Tax Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sn" t-value="0"/>
                            <t t-foreach="o.order_line" t-as="line">
                                <t t-if="not line.display_type">
                                    <t t-set="sn" t-value="sn + 1"/>
                                    <t t-set="vat_pct"
                                       t-value="'+'.join(['%g' % t.amount for t in line.tax_ids if t.amount_type == 'percent']) or '0'"/>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-esc="sn"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="line.name"/>
                                            <t t-if="is_powerx and line.packing_type">
                                                <br/>
                                                <small class="text-muted">Packing: <span t-esc="line.packing_type"/></small>
                                            </t>
                                        </td>
                                        <td t-if="not is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.pack_size_id.name"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.product_uom_qty"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.price_unit"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td t-if="not is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.product_uom_id.name"/>
                                        </td>
                                        <td t-if="not is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-esc="vat_pct"/>%
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.price_subtotal"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td t-if="is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-esc="vat_pct"/>%
                                        </td>
                                        <td t-if="is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.price_subtotal"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td t-if="is_powerx" style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.price_tax"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <div t-if="is_powerx" style="display:flex; justify-content:space-between; background-color:#f2f2f2; padding:4px 6px; font-size:11px; border:1px solid #ccc; border-top:none;">
                        <span>Gross Weight: <span t-esc="'{:,.2f}'.format(sum(o.order_line.mapped('gross_weight')))"/></span>
                        <span>Net Weight: <span t-esc="'{:,.2f}'.format(sum(o.order_line.mapped('net_weight')))"/></span>
                    </div>

                    <table t-if="is_powerx" style="width:100%; border-collapse:collapse; font-size:11px; margin-top:4px;">
                        <tr style="background-color:#d9d9d9; font-weight:bold;">
                            <td style="border:1px solid #ccc; padding:4px;">Total AED</td>
                            <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ TERMS / TOTALS ============ -->
                    <table t-if="is_powerx" style="width:100%; border-collapse:collapse; margin-top:10px;">
                        <tr>
                            <td style="width:55%; vertical-align:top; font-size:12px;">
                                <div><strong>Amount Chargeable (in words)</strong></div>
                                <div><span t-esc="o.currency_id.amount_to_text(o.amount_total)"/></div>
                                <div style="margin-top:10px;"><strong>VAT Amount (in words)</strong></div>
                                <div><span t-esc="o.currency_id.amount_to_text(o.amount_tax)"/></div>
                            </td>
                            <td style="width:45%; vertical-align:top;">
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="border:1px solid #ccc; padding:4px;"><strong>VAT %</strong></td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;"><strong>Assessable Value</strong></td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;"><strong>Tax Amount</strong></td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px;">5%</td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="font-weight:bold;">
                                        <td style="border:1px solid #ccc; padding:4px;">Total</td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                                <div style="text-align:right; font-size:10px; font-style:italic; margin-top:2px;">E. &amp; O.E</div>
                            </td>
                        </tr>
                    </table>
                    <table t-else="" style="width:100%; border-collapse:collapse; margin-top:10px;">
                        <tr>
                            <td style="width:55%; vertical-align:top; font-size:12px;">
                                <div><strong>Terms of Delivery</strong></div>
                                <div>Ex-Works Ajman</div>
                                <div style="margin-top:10px;">Veh. No : <span t-field="delivery.vehicle_no"/></div>
                            </td>
                            <td style="width:45%; vertical-align:top;">
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px;"><strong>Sub Total</strong></td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_untaxed"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.vat_selection and o.vat_selection != 'vat_not_applicable'">
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <strong>
                                                <span t-if="o.vat_selection == 'vat_5'">VAT 5%</span>
                                                <span t-if="o.vat_selection == 'vat_0'">VAT 0%</span>
                                            </strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_tax"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px;"><strong>Grand Total</strong></td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_total"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                                <div style="margin-top:8px;">
                                    <strong>Amount in words</strong> :
                                    <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                                </div>
                                <div style="margin-top:4px;">
                                    <strong>Other Charges</strong> :
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ BANK DETAILS ============ -->
                    <div style="background-color:#f2f2f2; padding:10px; margin-top:20px; font-size:12px;">
                        <div style="font-weight:bold; margin-bottom:6px;">BANK DETAILS</div>
                        <table style="width:60%; border-collapse:collapse;">
                            <tr>
                                <td style="padding:2px; width:40%;">Bank Name</td>
                                <td style="padding:2px;">: <span t-field="bank.bank_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding:2px;">A/C No.</td>
                                <td style="padding:2px;">: <span t-field="bank.acc_number"/></td>
                            </tr>
                            <tr>
                                <td style="padding:2px;">IBAN</td>
