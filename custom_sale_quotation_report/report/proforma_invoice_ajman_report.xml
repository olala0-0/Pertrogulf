<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_proforma_invoice_ajman">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="bank" t-value="o.company_id.partner_id.bank_ids[:1]"/>
                <t t-set="delivery" t-value="o.picking_ids.filtered(lambda p: p.picking_type_id.code == 'outgoing')[:1]"/>
                <div class="page" style="font-size:12px; padding:0; margin:0;">

                    <!-- ============ HEADER (letterhead banner) ============ -->
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td colspan="2" style="background-color:#d1d3d4; height:14.4mm; font-size:0; line-height:0;">&#160;</td>
                        </tr>
                        <tr>
                            <td style="background-color:#d1d3d4; width:47%; padding:6mm 4mm 6mm 8mm; vertical-align:middle;">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height:24mm; max-width:100%;"/>
                            </td>
                            <td style="width:53%; padding:6mm 18mm 6mm 4mm; vertical-align:middle; text-align:right;">
                                <span style="font-size:34px; font-weight:bold; color:#231f20;">PROFORMA INVOICE</span>
                            </td>
                        </tr>
                    </table>

                    <div style="padding:3mm 7mm 0 7mm;">

                    <table style="width:100%; border-collapse:collapse; margin-bottom:15px;">
                        <tr>
                            <td style="width:55%; vertical-align:top; font-size:12px;">
                                <div><strong t-field="o.company_id.name"/></div>
                                <div t-if="o.company_id.street"><span t-field="o.company_id.street"/></div>
                                <div t-if="o.company_id.phone"><span t-field="o.company_id.phone"/></div>
                                <div t-if="o.company_id.email"><span t-field="o.company_id.email"/></div>
                                <div t-if="o.company_id.website"><span t-field="o.company_id.website"/></div>
                            </td>
                            <td style="width:45%; vertical-align:top;">
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2; width:35%;">
                                            <strong>Invoice No</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>Invoice Date</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.date_order" t-options="{'widget': 'date'}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>TRN</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.company_id.vat"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ BUYER / INVOICE DETAILS ============ -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:15px;">
                        <tr>
                            <td style="width:48%; vertical-align:top;">
                                <div style="background-color:#d9d9d9; padding:4px 6px; font-weight:bold;">Buyer</div>
                                <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:12px;">
                                    <tr>
                                        <td style="padding:4px; width:40%;">Company Name</td>
                                        <td style="padding:4px;">: <span t-field="o.partner_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;">Address</td>
                                        <td style="padding:4px;">:
                                            <span t-field="o.partner_id.street"/>
                                            <span t-if="o.partner_id.street2" t-field="o.partner_id.street2"/>
                                            <span t-if="o.partner_id.city" t-field="o.partner_id.city"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;">Contact No.</td>
                                        <td style="padding:4px;">: <span t-field="o.partner_id.phone"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;">Emirate</td>
                                        <td style="padding:4px;">: <span t-field="o.partner_id.state_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;">Country</td>
                                        <td style="padding:4px;">: <span t-field="o.partner_id.country_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;">TRN</td>
                                        <td style="padding:4px;">: <span t-field="o.partner_id.vat"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;">Place of supply</td>
                                        <td style="padding:4px;">: </td>
                                    </tr>
                                </table>
                            </td>
                            <td style="width:4%;"/>
                            <td style="width:48%; vertical-align:top;">
                                <div style="background-color:#d9d9d9; padding:4px 6px; font-weight:bold;">Invoice Details</div>
                                <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:12px;">
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px; width:50%;">Delivery Note No.</td>
                                        <td style="padding:4px;">Delivery Note Date</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;"> </td>
                                        <td style="padding:4px;"> </td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px;">Vessel Name</td>
                                        <td style="padding:4px;">IMO No</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;"><span t-field="o.vessel_no_id.name"/></td>
                                        <td style="padding:4px;"><span t-field="o.imo_number"/></td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px;">Buyer's Order No.</td>
                                        <td style="padding:4px;">Dated</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;"><span t-field="o.client_po_order_no"/></td>
                                        <td style="padding:4px;"> </td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px;">Despatch Document No.</td>
                                        <td style="padding:4px;">Despatch Note Date</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;"><span t-field="delivery.document_number"/></td>
                                        <td style="padding:4px;"> </td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px;">Despatch Document Date</td>
                                        <td style="padding:4px;">Payment Terms</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;"> </td>
                                        <td style="padding:4px;"><span t-field="o.payment_term_id.name"/></td>
                                    </tr>
                                    <tr style="background-color:#f2f2f2;">
                                        <td style="padding:4px;">Despatched through</td>
                                        <td style="padding:4px;">Port</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;"> </td>
                                        <td style="padding:4px;"><span t-field="o.port_master_id.name"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ LINE ITEMS ============ -->
                    <table class="table table-sm" style="width:100%; border-collapse:collapse; font-size:11px;">
                        <thead>
                            <tr style="background-color:#d9d9d9;">
                                <th style="border:1px solid #ccc; padding:4px;">Sn</th>
                                <th style="border:1px solid #ccc; padding:4px;">Description of Goods</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">Packaging</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">Quantity</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">Rate</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">Per</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">VAT %</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sn" t-value="0"/>
                            <t t-foreach="o.order_line" t-as="line">
                                <t t-if="not line.display_type">
                                    <t t-set="sn" t-value="sn + 1"/>
                                    <t t-set="vat_pct"
                                       t-value="'+'.join(['%g' % t.amount for t in line.tax_ids if t.amount_type == 'percent']) or '0'"/>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-esc="sn"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.pack_size_id.name"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.product_uom_qty"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.price_unit"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.product_uom_id.name"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-esc="vat_pct"/>%
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.price_subtotal"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- ============ TERMS / TOTALS ============ -->
                    <table style="width:100%; border-collapse:collapse; margin-top:10px;">
                        <tr>
                            <td style="width:55%; vertical-align:top; font-size:12px;">
                                <div><strong>Terms of Delivery</strong></div>
                                <div>Ex-Works Ajman</div>
                                <div style="margin-top:10px;">Veh. No : <span t-field="delivery.vehicle_no"/></div>
                            </td>
                            <td style="width:45%; vertical-align:top;">
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px;"><strong>Sub Total</strong></td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_untaxed"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.vat_selection and o.vat_selection != 'vat_not_applicable'">
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <strong>
                                                <span t-if="o.vat_selection == 'vat_5'">VAT 5%</span>
                                                <span t-if="o.vat_selection == 'vat_0'">VAT 0%</span>
                                            </strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_tax"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px;"><strong>Grand Total</strong></td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="o.amount_total"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                                <div style="margin-top:8px;">
                                    <strong>Amount in words</strong> :
                                    <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                                </div>
                                <div style="margin-top:4px;">
                                    <strong>Other Charges</strong> :
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ BANK DETAILS ============ -->
                    <div style="background-color:#f2f2f2; padding:10px; margin-top:20px; font-size:12px;">
                        <div style="font-weight:bold; margin-bottom:6px;">BANK DETAILS</div>
                        <table style="width:60%; border-collapse:collapse;">
                            <tr>
                                <td style="padding:2px; width:40%;">Bank Name</td>
                                <td style="padding:2px;">: <span t-field="bank.bank_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding:2px;">A/C No.</td>
                                <td style="padding:2px;">: <span t-field="bank.acc_number"/></td>
                            </tr>
                            <tr>
                                <td style="padding:2px;">IBAN</td>
                                <td style="padding:2px;">: <span t-field="bank.acc_number"/></td>
                            </tr>
                            <tr>
                                <td style="padding:2px;">Branch &amp; SWIFT Code</td>
                                <td style="padding:2px;">: <span t-field="bank.bank_bic"/></td>
                            </tr>
                        </table>
                    </div>

                    <!-- ============ DECLARATION ============ -->
                    <div style="margin-top:20px; font-size:11px;">
                        <div style="text-decoration:underline; font-weight:bold;">Declaration</div>
                        <div>
                            Hereby we declare that this invoice shows the actual price of the goods
                            described and that all particulars are true and correct
                        </div>
                    </div>

                    <div style="text-align:center; font-size:10px; margin-top:15px;">
                        This is a Computer Generated Invoice
                    </div>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>