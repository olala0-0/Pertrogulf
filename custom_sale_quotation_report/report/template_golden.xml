<odoo>
    <template id="body_golden">
        <table class="table table-sm o_main_table mb-0" style="font-size:15px;">
            <thead>
                <tr style="background-color:#619FAF;">
                    <th>Sn</th>
                    <th>Offered Items</th>
                    <th>Pack Size</th>
                    <th>No of Units</th>
                    <th>Unit Price</th>
                    <th class="text-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="sn" t-value="0"/>
                <t t-foreach="o.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="sn" t-value="sn + 1"/>
                        <tr>
                            <td>
                                <span t-esc="sn"/>
                            </td>
                            <td>
                                <span t-field="line.name"/>
                            </td>
                            <td>
                                <span t-field="line.pack_size_id"/>
                            </td>
                            <td>
                                <span t-field="line.product_uom_qty"/>
                            </td>
                            <td>
                                <span t-field="line.price_unit"/>
                            </td>
                            <td class="text-right">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
        <table class="table table-sm o_main_table mb-0"
               style="margin-top:0; font-size:15px; border-top:none;">
            <tr>
                <td style="text-align:right;width:75%;border-top:none;">
                    <strong>Total</strong>
                </td>
                <td colspan="3" style="text-align:right;border-top:none;">
                    <span t-field="o.amount_untaxed"/>
                </td>
            </tr>
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Vat 5%</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_tax"/>
                </td>
            </tr>
            <tr>
                <td style="text-align:right;width:75%">
                    <strong>Grand Total</strong>
                </td>
                <td colspan="3" style="text-align:right;">
                    <span t-field="o.amount_total"/>
                </td>
            </tr>
        </table>

        <div class="mt-3">
            <t t-if="o.note">

                <strong>Terms &amp; Conditions:</strong>
                <div t-field="o.note"/>
            </t>
            <strong>Payment terms:</strong>
            <span t-field="o.payment_term_id.name"/>
        </div>
    </template>
</odoo>
