    <record id="view_order_form_aviation_details" model="ir.ui.view">
        <field name="name">sale.order.form.aviation.details</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="zilancer_customisation.view_sale_order_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_uid']" position="after">
                <field name="aircraft_reg_details" invisible="business_unit != 'pg_aviation'" />
                <field name="aircraft_type" invisible="business_unit != 'pg_aviation'" />
                <field name="country_of_origin" invisible="business_unit != 'pg_aviation'" />
            </xpath>
        </field>
    </record>

