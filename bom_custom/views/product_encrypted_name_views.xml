<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_encrypted_name_list" model="ir.ui.view">
        <field name="name">product.product.encrypted.name.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Product Encrypted Names" editable="bottom" create="0" delete="0">
                <field name="name" string="Product Name" readonly="1"/>
                <field name="default_code" string="Product Code" readonly="1"/>
                <field name="encrypted_name"/>
            </list>
        </field>
    </record>

    <record id="view_product_encrypted_name_search" model="ir.ui.view">
        <field name="name">product.product.encrypted.name.search</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="Product Encrypted Names">
                <field name="name" string="Product Name"/>
                <field name="default_code" string="Product Code"/>
                <field name="encrypted_name"/>
            </search>
        </field>
    </record>

    <record id="action_product_encrypted_name" model="ir.actions.act_window">
        <field name="name">Product Encrypted Names</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_product_encrypted_name_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No products found.
            </p>
            <p>
                Set an Encrypted Name per product. On Bill of Materials and Production Blend Sheet
                components, this name is shown instead of the product display name when set.
            </p>
        </field>
    </record>

    <record id="action_product_encrypted_name_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_encrypted_name_list"/>
        <field name="act_window_id" ref="action_product_encrypted_name"/>
    </record>

    <menuitem id="menu_product_encrypted_name"
              name="Product Encrypted Names"
              action="action_product_encrypted_name"
              parent="mrp.menu_mrp_bom"
              sequence="15"
              groups="mrp.group_mrp_user"/>
</odoo>
