<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Production Blend Sheet fields are visible only when action context
        has production_blend_sheet=True.

        Manufacturing > Products > Bill of Materials  -> base BOM only
        Manufacturing > Products > Production Blend Sheet -> blend sheet UI
    -->

    <!-- New action: same model as Bills of Materials, blend context -->
    <record id="action_production_blend_sheet" model="ir.actions.act_window">
        <field name="name">Production Blend Sheet</field>
        <field name="res_model">mrp.bom</field>
        <field name="path">production-blend-sheet</field>
        <field name="domain">[]</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="mrp.view_mrp_bom_filter"/>
        <field name="context">{
            'default_company_id': allowed_company_ids[0],
            'production_blend_sheet': True,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No production blend sheet found. Let's create one!
            </p>
            <p>
                Production Blend Sheets define batch formulation on a Bill of Materials
                (percentages, qty in KG/Ltr, density and approval).
            </p>
        </field>
    </record>

    <menuitem id="menu_production_blend_sheet"
              name="Production Blend Sheet"
              action="action_production_blend_sheet"
              parent="mrp.menu_mrp_bom"
              sequence="14"/>

    <record id="mrp_bom_form_view_bom_custom" model="ir.ui.view">
        <field name="name">mrp.bom.form.bom.custom</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">

            <!-- Status + Approve: blend sheet only -->
            <xpath expr="//sheet" position="before">
                <header invisible="not context.get('production_blend_sheet')">
                    <button name="button_approve"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
            </xpath>

            <!-- Hide Product Variant on blend sheet only -->
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="invisible">context.get('production_blend_sheet')</attribute>
            </xpath>

            <!-- Quantity label: standard vs Total Qty (Kgs) on blend sheet -->
            <xpath expr="//label[@for='product_qty']" position="attributes">
                <attribute name="invisible">context.get('production_blend_sheet')</attribute>
            </xpath>
            <xpath expr="//label[@for='product_qty']" position="after">
                <label for="product_qty"
                       string="Total Qty (Kgs)"
                       invisible="not context.get('production_blend_sheet')"/>
            </xpath>


            <!-- Blend header fields -->
            <xpath expr="//field[@name='product_tmpl_id']" position="after">
                <field name="ketal_no" invisible="not context.get('production_blend_sheet')"/>
                <field name="previous_product" invisible="not context.get('production_blend_sheet')"/>
                <field name="flushing_required" invisible="not context.get('production_blend_sheet')"/>
                <field name="flushing_qty" invisible="not context.get('production_blend_sheet')"/>
                <field name="total_qty_liters" readonly="1" invisible="not context.get('production_blend_sheet')"/>
            </xpath>

            <xpath expr="//field[@name='code']" position="after">
                <field name="density" invisible="not context.get('production_blend_sheet')"/>
                <field name="batch_start_time" invisible="not context.get('production_blend_sheet')"/>
                <field name="batch_stop_time" invisible="not context.get('production_blend_sheet')"/>
                <field name="heating_start_time" invisible="not context.get('production_blend_sheet')"/>
                <field name="mixing_start_time" invisible="not context.get('production_blend_sheet')"/>
                <field name="mixing_temperature" invisible="not context.get('production_blend_sheet')"/>
                <field name="sample_given_time" invisible="not context.get('production_blend_sheet')"/>
                <field name="batch_approval_time" invisible="not context.get('production_blend_sheet')"/>
            </xpath>

            <!-- Component product label: encrypted_name when set (BoM + Blend Sheet) -->
            <xpath expr="//page[@name='components']//field[@name='bom_line_ids']" position="attributes">
                <attribute name="context">{
                    'default_parent_product_tmpl_id': product_tmpl_id,
                    'default_product_id': False,
                    'default_bom_id': id,
                    'bom_display_encrypted_name': True,
                }</attribute>
            </xpath>
            <xpath expr="//page[@name='components']//field[@name='bom_line_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="context">{'default_is_storable': True, 'bom_display_encrypted_name': True}</attribute>
            </xpath>

            <!-- Components: hide standard columns only on blend sheet -->
            <xpath expr="//page[@name='components']//field[@name='bom_line_ids']/list/field[@name='sequence']" position="attributes">
                <attribute name="column_invisible">context.get('production_blend_sheet')</attribute>
            </xpath>
            <xpath expr="//page[@name='components']//field[@name='bom_line_ids']/list/button[@name='action_see_attachments']" position="attributes">
                <attribute name="column_invisible">context.get('production_blend_sheet')</attribute>
            </xpath>
            <xpath expr="//page[@name='components']//field[@name='bom_line_ids']/list/field[@name='attachments_count']" position="attributes">
                <attribute name="column_invisible">context.get('production_blend_sheet')</attribute>
            </xpath>
            <xpath expr="//page[@name='components']//field[@name='bom_line_ids']/list/field[@name='product_uom_id']" position="attributes">
                <attribute name="column_invisible">context.get('production_blend_sheet')</attribute>
            </xpath>
            <xpath expr="//page[@name='components']//field[@name='bom_line_ids']/list/field[@name='bom_product_template_attribute_value_ids']" position="attributes">
                <attribute name="column_invisible">context.get('production_blend_sheet')</attribute>
            </xpath>
            <xpath expr="//page[@name='components']//field[@name='bom_line_ids']/list/field[@name='operation_id']" position="attributes">
                <attribute name="column_invisible">context.get('production_blend_sheet')</attribute>
            </xpath>

            <!-- Blend component columns: only on blend sheet -->
            <xpath expr="//page[@name='components']//field[@name='bom_line_ids']/list/field[@name='product_id']" position="after">
                <field name="percentage" widget="percentage" string="Percentage"
                       column_invisible="not context.get('production_blend_sheet')"/>
            </xpath>
            <xpath expr="//page[@name='components']//field[@name='bom_line_ids']/list/field[@name='product_qty']" position="after">
                <field name="qty_ltr" readonly="1" string="Qty in Ltr"
                       column_invisible="not context.get('production_blend_sheet')"/>
                <field name="actual_qty_ltr" string="Actual Qty Ltr"
                       column_invisible="not context.get('production_blend_sheet')"/>
                <field name="actual_qty_kg" string="Actual Qty KG"
                       column_invisible="not context.get('production_blend_sheet')"/>
                <field name="density" string="Density"
                       column_invisible="not context.get('production_blend_sheet')"/>
            </xpath>

            <xpath expr="//page[@name='components']//field[@name='bom_line_ids']" position="after">
                <group invisible="not context.get('production_blend_sheet')">
                    <group string="Component Totals">
                        <field name="total_component_qty_kg" readonly="1"/>
                        <field name="total_component_qty_ltr" readonly="1"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
