<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Order Inquiry Form View Extension -->
    <record id="view_order_enq_form_division" model="ir.ui.view">
        <field name="name">order.enq.form.division</field>
        <field name="model">order.enq</field>
        <field name="inherit_id" ref="sale_order_enquiry.view_order_enq_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="division_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Order Inquiry Tree / List View Extension -->
    <record id="view_order_enq_tree_division" model="ir.ui.view">
        <field name="name">order.enq.tree.division</field>
        <field name="model">order.enq</field>
        <field name="inherit_id" ref="sale_order_enquiry.view_order_enq_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="division_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
