<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="division_master_view_tree" model="ir.ui.view">
        <field name="name">division.master.tree</field>
        <field name="model">division.master</field>
        <field name="arch" type="xml">
            <list string="Division Master">
                <field name="id" string="ID"/>
                <field name="name" string="Division Name"/>
                <field name="company_id" string="Parent Company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="division_master_view_form" model="ir.ui.view">
        <field name="name">division.master.form</field>
        <field name="model">division.master</field>
        <field name="arch" type="xml">
            <form string="Division Master">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name" string="Division Name" placeholder="e.g. Automotive"/>
                            <field name="company_id" string="Parent Company" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search / Filter View -->
    <record id="division_master_view_search" model="ir.ui.view">
        <field name="name">division.master.search</field>
        <field name="model">division.master</field>
        <field name="arch" type="xml">
            <search string="Search Division Master">
                <field name="name" string="Division Name"/>
                <field name="company_id" string="Parent Company"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Parent Company" name="groupby_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_division_master" model="ir.actions.act_window">
        <field name="name">Division Master</field>
        <field name="res_model">division.master</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="division_master_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Division Master!
            </p>
            <p>
                Manage company divisions and assign allowed divisions to users.
            </p>
        </field>
    </record>

    <!-- Menu Item under Sales -> Configuration -->
    <menuitem id="menu_division_master"
              name="Division Master"
              parent="sale.menu_sale_config"
              action="action_division_master"
              sequence="15"/>
</odoo>
