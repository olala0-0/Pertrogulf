<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Division Master Multi-Company Rule -->
        <record id="division_master_comp_rule" model="ir.rule">
            <field name="name">Division Master multi-company</field>
            <field name="model_id" ref="model_division_master"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!--
            Dynamic Multi-Company & Division Filtering Rules
            Applies to active company selected in header. Restricts records based on allowed divisions assigned to the user for that active company.
        -->

        <record id="res_partner_division_rule" model="ir.rule">
            <field name="name">Partner Multi-Division Rule</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">user._get_division_record_domain()</field>
        </record>

        <record id="product_template_division_rule" model="ir.rule">
            <field name="name">Product Template Multi-Division Rule</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">user._get_division_record_domain()</field>
        </record>

        <record id="product_product_division_rule" model="ir.rule">
            <field name="name">Product Variant Multi-Division Rule</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="domain_force">user._get_division_record_domain()</field>
        </record>

        <record id="sale_order_division_rule" model="ir.rule">
            <field name="name">Sale Order Multi-Division Rule</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">user._get_division_record_domain('partner_id')</field>
        </record>

        <record id="order_enq_division_rule" model="ir.rule">
            <field name="name">Order Inquiry Multi-Division Rule</field>
            <field name="model_id" ref="sale_order_enquiry.model_order_enq"/>
            <field name="domain_force">user._get_division_record_domain('partner_id')</field>
        </record>
    </data>
</odoo>
