<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mst_activity_log_model_config_list" model="ir.ui.view">
        <field name="name">mst.activity.log.model.config.list</field>
        <field name="model">mst.activity.log.model.config</field>
        <field name="arch" type="xml">
            <list string="Model Log Configuration">
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="name"/>
                <field name="model_count"/>
                <field name="model_names"/>
                <field name="technical_model_names"/>
                <field name="module_names"/>
                <field name="track_create"/>
                <field name="track_modify"/>
                <field name="track_delete"/>
                <field name="include_related_line_models"/>
            </list>
        </field>
    </record>

    <record id="view_mst_activity_log_model_config_form" model="ir.ui.view">
        <field name="name">mst.activity.log.model.config.form</field>
        <field name="model">mst.activity.log.model.config</field>
        <field name="arch" type="xml">
            <form string="Model Log Configuration">
                <header>
                    <button name="action_view_model_logs"
                            type="object"
                            string="View Logs"
                            class="btn-primary"
                            invisible="not model_ids"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="name" readonly="True"/>
                            <field name="model_count" readonly="True"/>
                            <field name="include_related_line_models"/>
                        </group>

                        <group string="Tracking Options">
                            <field name="track_create"/>
                            <field name="track_modify"/>
                            <field name="track_delete"/>
                        </group>
                    </group>

                    <group string="Select Models">
                        <field name="model_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>

                    <group>
                        <group string="Selected Model Names">
                            <field name="model_names" readonly="True" nolabel="True"/>
                        </group>

                        <group string="Technical Models">
                            <field name="technical_model_names" readonly="True" nolabel="True"/>
                        </group>
                    </group>

                    <group string="Modules">
                        <field name="module_names" readonly="True" nolabel="True"/>
                    </group>

                    <group string="Notes">
                        <field name="notes" nolabel="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mst_activity_log_model_config_search" model="ir.ui.view">
    <field name="name">mst.activity.log.model.config.search</field>
    <field name="model">mst.activity.log.model.config</field>
    <field name="arch" type="xml">
        <search string="Model Log Configuration">

            <!-- Searchable Fields -->
            <field name="name"/>
            <field name="model_names"/>
            <field name="technical_model_names"/>
            <field name="module_names"/>

            <separator/>

            <!-- Filters -->
            <filter name="active_config"
                    string="Active"
                    domain="[('active', '=', True)]"/>

            <filter name="inactive_config"
                    string="Archived"
                    domain="[('active', '=', False)]"/>

            <separator/>

            <!-- Group By -->
            <group name="group_by">
                <filter name="group_active"
                        string="Active Status"
                        context="{'group_by': 'active'}"/>
            </group>

        </search>
    </field>
</record>

   

    <record id="action_mst_activity_log_model_config" model="ir.actions.act_window">
        <field name="name">Model Log Configuration</field>
        <field name="res_model">mst.activity.log.model.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mst_activity_log_model_config_search"/>
    </record>

 

</odoo>