<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_login_history_list" model="ir.ui.view">
        <field name="name">login.history.list</field>
        <field name="model">login.history</field>
        <field name="arch" type="xml">
            <list string="Login History" create="0" edit="0">
                <field name="user_id"/>
                <field name="login_time"/>
                <field name="logout_time"/>
                <field name="duration"/>
                <field name="ip_address"/>
                <field name="city"/>
                <field name="region"/>
                <field name="country"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="location_source"/>
                <field name="map_url" widget="url"/>
                <field name="browser"/>
                <field name="operating_system"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_login_history_form" model="ir.ui.view">
        <field name="name">login.history.form</field>
        <field name="model">login.history</field>
        <field name="arch" type="xml">
            <form string="Login History" create="0" edit="0">
                <header>
                    <button
                        name="action_open_map"
                        type="object"
                        string="Open Map"
                        class="btn-primary"
                        invisible="not latitude or not longitude"/>
                </header>

                <sheet>
                    <group>
                        <group string="Login Details">
                            <field name="user_id"/>
                            <field name="login_time"/>
                            <field name="logout_time"/>
                            <field name="duration"/>
                            <field name="status"/>
                        </group>

                        <group string="Device Details">
                            <field name="ip_address"/>
                            <field name="browser"/>
                            <field name="operating_system"/>
                            <field name="session_id"/>
                        </group>
                    </group>

                    <group>
                        <group string="Geo Location">
                            <field name="country"/>
                            <field name="region"/>
                            <field name="city"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="location_source"/>
                            <field name="map_url" widget="url"/>
                        </group>
                    </group>

                    <group string="Full Location">
                        <field name="full_location" nolabel="1"/>
                    </group>

                    <group string="User Agent">
                        <field name="user_agent" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_login_history_search" model="ir.ui.view">
    <field name="name">login.history.search</field>
    <field name="model">login.history</field>
    <field name="arch" type="xml">
        <search string="Login History">

            <!-- Searchable Fields -->
            <field name="user_id"/>
            <field name="ip_address"/>
            <field name="city"/>
            <field name="region"/>
            <field name="country"/>
            <field name="status"/>
            <field name="location_source"/>

            <separator/>

            <!-- Filters -->
            <filter name="active_sessions"
                    string="Active Sessions"
                    domain="[('status', '=', 'active')]"/>

            <filter name="logout_sessions"
                    string="Logout Sessions"
                    domain="[('status', '=', 'logout')]"/>

            <separator/>

            <filter name="browser_location"
                    string="Browser Location"
                    domain="[('location_source', '=', 'browser')]"/>

            <filter name="ip_location"
                    string="IP Location"
                    domain="[('location_source', '=', 'ip')]"/>

            <separator/>

            <!-- Group By -->
            <group name="group_by">
                <filter name="group_by_user"
                        string="User"
                        context="{'group_by': 'user_id'}"/>

                <filter name="group_by_status"
                        string="Status"
                        context="{'group_by': 'status'}"/>

                <filter name="group_by_country"
                        string="Country"
                        context="{'group_by': 'country'}"/>

                <filter name="group_by_region"
                        string="Region"
                        context="{'group_by': 'region'}"/>

                <filter name="group_by_city"
                        string="City"
                        context="{'group_by': 'city'}"/>

                <filter name="group_by_location_source"
                        string="Location Source"
                        context="{'group_by': 'location_source'}"/>

                <filter name="group_by_login_date"
                        string="Login Date"
                        context="{'group_by': 'login_time:day'}"/>
            </group>

        </search>
    </field>
</record>

    <record id="action_login_history" model="ir.actions.act_window">
        <field name="name">Login History</field>
        <field name="res_model">login.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_login_history_search"/>
    </record>

    <record id="view_login_failed_history_list" model="ir.ui.view">
        <field name="name">login.failed.history.list</field>
        <field name="model">login.failed.history</field>
        <field name="arch" type="xml">
            <list string="Failed Login History" create="0" edit="0">
                <field name="login"/>
                <field name="attempt_time"/>
                <field name="ip_address"/>
                <field name="city"/>
                <field name="region"/>
                <field name="country"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="location_source"/>
                <field name="map_url" widget="url"/>
                <field name="browser"/>
                <field name="operating_system"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_login_failed_history_form" model="ir.ui.view">
        <field name="name">login.failed.history.form</field>
        <field name="model">login.failed.history</field>
        <field name="arch" type="xml">
            <form string="Failed Login History" create="0" edit="0">
                <header>
                    <button
                        name="action_open_map"
                        type="object"
                        string="Open Map"
                        class="btn-primary"
                        invisible="not latitude or not longitude"/>
                </header>

                <sheet>
                    <group>
                        <group string="Attempt Details">
                            <field name="login"/>
                            <field name="attempt_time"/>
                            <field name="reason"/>
                        </group>

                        <group string="Device Details">
                            <field name="ip_address"/>
                            <field name="browser"/>
                            <field name="operating_system"/>
                        </group>
                    </group>

                    <group>
                        <group string="Geo Location">
                            <field name="country"/>
                            <field name="region"/>
                            <field name="city"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="location_source"/>
                            <field name="map_url" widget="url"/>
                        </group>
                    </group>

                    <group string="Full Location">
                        <field name="full_location" nolabel="1"/>
                    </group>

                    <group string="User Agent">
                        <field name="user_agent" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_login_failed_history_search" model="ir.ui.view">
    <field name="name">login.failed.history.search</field>
    <field name="model">login.failed.history</field>
    <field name="arch" type="xml">
        <search string="Failed Login History">

            <!-- Searchable Fields -->
            <field name="login"/>
            <field name="ip_address"/>
            <field name="city"/>
            <field name="region"/>
            <field name="country"/>
            <field name="reason"/>
            <field name="location_source"/>

            <separator/>

            <!-- Filters -->
            <filter name="browser_location"
                    string="Browser Location"
                    domain="[('location_source', '=', 'browser')]"/>

            <filter name="ip_location"
                    string="IP Location"
                    domain="[('location_source', '=', 'ip')]"/>

            <separator/>

            <!-- Group By -->
            <group name="group_by">

                <filter name="group_by_login"
                        string="Login"
                        context="{'group_by': 'login'}"/>

                <filter name="group_by_country"
                        string="Country"
                        context="{'group_by': 'country'}"/>

                <filter name="group_by_region"
                        string="Region"
                        context="{'group_by': 'region'}"/>

                <filter name="group_by_city"
                        string="City"
                        context="{'group_by': 'city'}"/>

                <filter name="group_by_location_source"
                        string="Location Source"
                        context="{'group_by': 'location_source'}"/>

                <filter name="group_by_attempt_date"
                        string="Attempt Date"
                        context="{'group_by': 'attempt_time:day'}"/>

            </group>

        </search>
    </field>
</record> 
    <record id="action_login_failed_history" model="ir.actions.act_window">
        <field name="name">Failed Login History</field>
        <field name="res_model">login.failed.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_login_failed_history_search"/>
    </record>



</odoo>