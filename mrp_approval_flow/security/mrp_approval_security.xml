<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_mrp_approval">
        <field name="name">MRP Approvals</field>
        <field name="sequence">30</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_mrp_approval">
        <field name="name">MRP Approvals</field>
        <field name="category_id" ref="module_category_mrp_approval"/>
        <field name="description">QC and Store In-ward approval on Manufacturing Orders</field>
    </record>

    <record id="group_mrp_qc_approver" model="res.groups">
        <field name="name">QC Approval</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mrp_approval"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        <field name="comment">Can approve Manufacturing Orders at QC step.</field>
    </record>

    <record id="group_mrp_store_approver" model="res.groups">
        <field name="name">Store In-ward Approval</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mrp_approval"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        <field name="comment">Can approve Manufacturing Orders at Store In-ward step (after QC).</field>
    </record>
</odoo>
