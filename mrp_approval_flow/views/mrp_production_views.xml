<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_approval_flow" model="ir.ui.view">
        <field name="name">mrp.production.form.approval.flow</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Approval before Confirm -->
            <xpath expr="//header" position="inside">
                <button name="action_qc_approval"
                        type="object"
                        string="QC Approval"
                        class="btn-primary"
                        groups="mrp_approval_flow.group_mrp_qc_approver"
                        invisible="state != 'draft' or mo_approval_state != 'pending_qc'"/>
                <button name="action_store_approval"
                        type="object"
                        string="Store Approval"
                        class="btn-primary"
                        groups="mrp_approval_flow.group_mrp_store_approver"
                        invisible="state != 'draft' or mo_approval_state != 'pending_store'"/>
            </xpath>

            <!-- Confirm only after both approvals -->
            <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="invisible">state != 'draft' or mo_approval_state != 'approved'</attribute>
            </xpath>

            <!-- One statusbar only (hide standard MO state statusbar) -->
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="after">
                <field name="mo_display_stage"
                       widget="statusbar"
                       statusbar_visible="pending_qc,pending_store,approved,confirmed,done"/>
                <field name="mo_approval_state" invisible="True"/>
            </xpath>

            <!-- Approval details -->
            <xpath expr="//page[@name='miscellaneous']" position="after">
                <page string="MO Approvals" name="mo_approvals" invisible="state == 'cancel'">
                    <group>
                        <group string="QC Approval">
                            <field name="qc_approved_by" readonly="True"/>
                            <field name="qc_approved_date" readonly="True"/>
                        </group>
                        <group string="Store In-ward Approval">
                            <field name="store_approved_by" readonly="True"/>
                            <field name="store_approved_date" readonly="True"/>
                        </group>
                    </group>
                    <div class="text-muted" colspan="2">
                        Manufacturing Order must be approved first by QC, then by Store In-ward,
                        before it can be confirmed and started.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- List: single stage column -->
    <record id="mrp_production_tree_view_approval_flow" model="ir.ui.view">
        <field name="name">mrp.production.list.approval.flow</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="mo_display_stage" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Search filters -->
    <record id="view_mrp_production_filter_approval_flow" model="ir.ui.view">
        <field name="name">mrp.production.search.approval.flow</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='todo']" position="after">
                <separator/>
                <filter string="Waiting QC Approval" name="waiting_qc"
                        domain="[('mo_approval_state', '=', 'pending_qc'), ('state', '=', 'draft')]"/>
                <filter string="Waiting Store Approval" name="waiting_store"
                        domain="[('mo_approval_state', '=', 'pending_store'), ('state', '=', 'draft')]"/>
                <filter string="Ready to Confirm" name="ready_confirm"
                        domain="[('mo_approval_state', '=', 'approved'), ('state', '=', 'draft')]"/>
            </xpath>
        </field>
    </record>
</odoo>
