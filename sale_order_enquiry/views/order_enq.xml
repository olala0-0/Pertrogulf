    <record id="saleorder_form_inherit" model="ir.ui.view">
        <field name="name">Sale order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page/field[@name='order_line']" position="before">
                <button name="button_add_line_from_sales" style="margin-top: -1%;margin-left: 42%;" type="object"  string="Add Lines"
                        class="btn-primary"
                        invisible="state not in ('draft', 'sent'), not order_enquirey_id"/>
            </xpath>
            <!-- <xpath expr="//group[1]" position="attributes">
                <attribute name="col">3</attribute>
            </xpath> -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="before">
                <field name="order_enquirey_id" readonly="True" invisible="not order_enquirey_id"/>
                <field name="reason_id" string="Reason for not quoting"/>
                <field name="new_existing" readonly="True"/>
                <field name="Source_of_inquiry_id"/>
                <field name="post_tally_date" invisible="True"/>
                <field name="other_ref" invisible="True"/>
                <field name="dispatch_through" invisible="False"/>
                <field name="destination" invisible="False"/>
            </xpath>
            <xpath expr="//group[@name='partner_details']/field[@name='partner_shipping_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Keep base Offered Item (product) fields; only relabel + block create -->
            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='product_template_id']" position="attributes">
                <attribute name="string">Offered Item</attribute>
                <attribute name="options">{'show_label_warning': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}</attribute>
                <attribute name="domain">[('sale_ok', '=', True)]</attribute>
                <attribute name="width">380px</attribute>
            </xpath>
            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="string">Offered Item</attribute>
                <attribute name="options">{'show_label_warning': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}</attribute>
                <attribute name="domain">[('sale_ok', '=', True)]</attribute>
                <attribute name="width">380px</attribute>
            </xpath>

            <!-- Customer ref fields before Offered Item -->
            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='product_template_id']" position="before">
                <field name="customer_ref_id" string="Inquired Item" optional="show" width="140px"
                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                <field name="customer_brand" string="Customer Brand" optional="show" width="120px"/>
                <field name="cust_ref_pro_category" string="Cust Ref Product Category" optional="show" width="140px"/>
            </xpath>

            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Qty in Units</attribute>
                <attribute name="width">90px</attribute>
            </xpath>
            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="pack_size_id" string="Pack Size" optional="show" width="100px"
                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}" column_invisible="1"/>
            </xpath>
            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='product_uom_id']" position="after">
                <field name="unit_qty" string="Quantity" optional="show" width="80px"/>
            </xpath>
            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='product_uom_id'][@groups='uom.group_uom']" position="attributes">
                <attribute name="string">UoM</attribute>
                <attribute name="width">70px</attribute>
            </xpath>
            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='name']" position="attributes">
                <attribute name="width">180px</attribute>
            </xpath>

        </field>
    </record>

