<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_order_enq_form" model="ir.ui.view">
        <field name="name">view_order_enq_form</field>
        <field name="model">order.enq</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="button_confirm" type="object" string="Convert to Quote" class="btn-primary"
                            invisible="state in ('convert_quote', 'cancel')" />
                    <button name="button_cancel" type="object" string="Cancel" class="btn-secondary"
                                 invisible="state in ('convert_quote', 'cancel')" />
                    <button name="button_multi_orders" type="object" string="Recreate Sales" class="btn-primary"
                             invisible="not multi_order" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button icon="fa-eye" type="object" string="View Sales" class="oe_stat_button" name="view_sale_order"
                                 invisible="not sale_order_id" >
                                <field name="sale_count" widget="statinfo" string="View sales"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Converted to Quote" bg_color="bg-success" invisible="state != 'convert_quote'" />
                    <widget name="web_ribbon" title="Inquiry" bg_color="bg-info" invisible="state != 'inquiry'" />
                    <widget name="web_ribbon" title="Cancel" bg_color="bg-danger" invisible="state != 'cancel'" />
                    <widget name="web_ribbon" title="Multi" bg_color="bg-success" invisible="sale_count &lt;= 1" />
                    <div class="oe_title">
                        <lable for="name"/>
                        <h2>
                            <field name="name"/>
                        </h2>
                    </div>
                    <group col="2">
                        <group>
                            <field name="partner_id" required="True" readonly="state in ('convert_quote', 'cancel')"
                                     options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                            <field name="company_id" readonly="True"/>
                            <field name="user_id" readonly="True"/>
                            <field name="state" invisible="True"/>
                            <field name="business_unit" readonly="True" force_save="True"/>
                            <field name="country_port_id" string="Country of Supply"/>
                            <field name="sales_user_id" required="True"/>
                            <field name="reason_id" string="Reason for not inquiry"/>
                            <!-- <field name="pricing"/> -->
                            <field name="total_quantity" string="Total Quantity"/>
                        </group>
                        <group>
                            <field name="customer_user_id" invisible="True"/>
                            <field name="email"/>
                            <field name="date_order"/>
                            <field name="sale_order_id" nolabel="True"  invisible="not sale_order_id or multi_order" readonly="True" />
                            <field name="note"/>
                            <field name="inquiry_rec_from"/>
                            <field name="new_existing" force_save="True"/>
                            <field name="Source_of_inquiry_id"/>
                            <!-- <field name="out_of_service_area"/> -->
                            <field name="vessel_eta_message"/>
                            <field name="post_tally_date" invisible="True"/>
                            <field name="mode_payments"/>
                            <field name="total_qty_units" string="Total Qty in Units"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Additional Details - Marine" invisible="company_id != 3">
                            <group>
                                <group>
                                    <field name="vessel_no_id" required="company_id == 3"/>
                                    <!-- <field name="vessel_no" required="company_id == 3"/> -->
                                    <field name="vessel_eta"/>
                                    <!-- <field name="imo_no_id" required="company_id == 3"/> -->
                                    <field name="imo_number" required="company_id == 3"/>
                                    <field name="delivery_by_id"/>
                                    <field name="port_master_id" required="company_id == 3"/>
                                    <field name="country_id"/>
                                    <field name="port_note"/>
                                    <field name="delivery_type_id"/>
                                    <field name="operational_status"/>
                                </group>
                                <group>
                                </group>
                            </group>
                        </page>
                        <page name="order_line" string="Order Line">
                            <!-- <button type="object" string="Add Lines"  name="button_add_line_from_sales" invisible="state in ('convert_quote', 'cancel')" /> -->
                            <field name="order_line_ids" readonly="state in ('convert_quote', 'cancel')" mode="list"
                                   widget="section_and_note_one2many" nolabel="True">
                                <list editable="bottom">
                                    <control>
                                        <create name="add_product_control" string="Add a product"/>
                                        <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                                    </control>
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" column_invisible="True"/>
                                    <field name="customer_ref_id" string="Inquired Item" optional="show" width="140px"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                                    <field name="customer_brand" string="Customer Brand" optional="show" width="120px"/>
                                    <field name="cust_ref_pro_category" string="Cust Ref Product Category" optional="show" width="140px"/>
                                    <field name="product_id" widget="product_configurator" string="Offered Item" width="320px"
                                             options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                                    <field name="name" widget="section_and_note_text" column_invisible="True"/>
                                    <field name="product_uom_qty" string="Qty in Units" width="90px"/>
                                    <field name="pack_size_id" string="Pack Size" optional="show" width="100px"
                                             options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                                    <field name="unit_qty" string="Quantity" width="80px"/>
                                    <field name="product_uom_id" string="UoM" width="70px"/>
                                    <field name="company_id" optional="hide"/>
                                    <field name="sale_order_id" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <!-- <field name="price_tax" column_invisible="True"/>
                                    <field name="price_total" column_invisible="True"/> -->
                                </list>
                            </field>

                            <group name="note_group" col="6" class="mt-2 mt-md-0">
                                <!-- <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                                    <field name="tax_totals" widget="account-tax-totals-field" nolabel="True" colspan="2" readonly="True"/>
                                </group>
                                <div class="clearfix"/> -->
                            </group>
                        </page>
                        <page string="Additional Details - Auto" invisible="1">
                            <group>
                                <group>
                                    <field name="sales_order_received"/>
                                    <field name="sales_order_date"/>
                                    <field name="po_received"/>
                                    <field name="po_number"/>
                                    <field name="purchase_order_date"/>
                                    <field name="brand_master_id"/>
                                    <field name="brand_type"/>
                                </group>
                                <group>
                                    <field name="production_started"/>
                                    <field name="expected_closure_date"/>
                                    <field name="production_date"/>
                                    <field name="expected_date_of_completion"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_order_enq_product_line_form" model="ir.ui.view">
        <field name="name">view_order_enq_product_line_form</field>
        <field name="model">order.enq.lines</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="2">
                        <field name="sale_order_id" invisible="True"/>
                        <field name="currency_id" invisible="True"/>
                        <!-- <field name="price_tax" invisible="True"/> -->
                        <!-- <field name="price_total" invisible="True"/> -->
                        <field name="sequence" invisible="True"/>
                        <field name="display_type" invisible="True"/>
                        <group>
                            <field name="product_id" string="Offered Item"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                            <field name="name"/>
                            <!-- <field name="price_unit"/> -->
                            <!-- <field name="product_uom"/> -->
                        </group>
                        <group>
                            <field name="product_uom_qty"/>
                            <!-- <field name="tax_id" widget="many2many_tags"/>
                            <field name="price_subtotal" widget="monetary"/> -->
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="view_order_enq_kanban_improved" model="ir.ui.view">
        <field name="name">order.enq.kanban.improved</field>
        <field name="model">order.enq</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" 
                    class="o_kanban_small_column" 
                    sample="True"
                    records_draggable="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="date_order"/>
                <field name="sales_user_id"/>
                <field name="sale_count"/>
                <field name="total_quantity"/>
                <field name="business_unit"/>
                <field name="color" invisible="True"/>
                
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click" 
                             t-attf-style="border-left: 5px solid #{
                                record.state.raw_value == 'convert_quote' ? '#28a745' : 
                                record.state.raw_value == 'inquiry' ? '#17a2b8' : 
                                record.state.raw_value == 'cancel' ? '#dc3545' : '#6c757d'}; 
                                padding: 12px;">
                            <div class="ribbon ribbon-top-right" t-if="record.state.raw_value == 'convert_quote'">
                                <span class="bg-success">Converted to Quote</span>
                            </div>
                            <div class="ribbon ribbon-top-right" t-if="record.state.raw_value == 'inquiry'">
                                <span class="bg-info">Inquiry</span>
                            </div>
                            <div class="ribbon ribbon-top-right" t-if="record.state.raw_value == 'cancel'">
                                <span class="bg-danger">Cancelled</span>
                            </div>
                            
                            <div class="mb-3 pb-2" style="border-bottom: 1px solid rgba(0,0,0,0.1);">
                                <h5 class="mb-1">
                                    <field name="name"/>
                                </h5>
                                <div>
                                    <span class="text-muted">Customer: </span>
                                    <strong><field name="partner_id"/></strong>
                                </div>
                            </div>
                            
                            <table class="o_kanban_record_body w-100 mb-3">
                                <tr>
                                    <td class="text-end pe-3" style="width: 40%; vertical-align: top;">
                                        <span class="text-muted">Date:</span>
                                    </td>
                                    <td style="width: 60%; vertical-align: top;">
                                        <field name="date_order" widget="date"/>
                                    </td>
                                </tr>
                                
                                <tr>
                                    <td class="text-end pe-3" style="vertical-align: top;">
                                        <span class="text-muted">Sales Person:</span>
                                    </td>
                                    <td style="vertical-align: top;">
                                        <field name="sales_user_id"/>
                                    </td>
                                </tr>
                                
                                <tr t-if="record.business_unit.raw_value">
                                    <td class="text-end pe-3" style="vertical-align: top;">
                                        <span class="text-muted">Business Unit:</span>
                                    </td>
                                    <td style="vertical-align: top;">
                                        <field name="business_unit"/>
                                    </td>
                                </tr>
                                
                                <tr>
                                    <td class="text-end pe-3" style="vertical-align: top;">
                                        <span class="text-muted">Quantity:</span>
                                    </td>
                                    <td style="vertical-align: top;">
                                        <field name="total_quantity"/>
                                    </td>
                                </tr>
                            </table>
                            
                            <div class="d-flex justify-content-end" style="border-top: 1px solid rgba(0,0,0,0.1); padding-top: 8px;">
                                <t t-if="record.sale_count.raw_value > 0">
                                    <span class="badge rounded-pill bg-primary me-1">
                                        <i class="fa fa-file-text-o me-1" role="img" aria-label="Sales" title="Sales"></i>
                                        <t t-out="record.sale_count.value"/> Sale<t t-if="record.sale_count.raw_value > 1">s</t>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

