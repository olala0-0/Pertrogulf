        <record id="view_process_master_kanban" model="ir.ui.view">
            <field name="name">process.master.kanban</field>
            <field name="model">process.master</field>
            <field name="arch" type="xml">
                <kanban default_group_by="team_id">
                    <field name="name"/>
                    <field name="team_id"/>
                    <field name="stage_no"/>
                    <field name="stage"/>
                    <field name="progress"/>
                    <field name="business_unit"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click" style="margin-bottom: 10px;">
                                
                                <!-- Header -->
                                <div class="oe_kanban_content" style="padding: 10px;">
                                    <div style="font-weight: bold; font-size: 14px; color: #2E86AB; margin-bottom: 8px;">
                                        Process #<field name="name"/>
                                    </div>
                                    
                                    <!-- Team -->
                                    <div style="margin-bottom: 6px;">
                                        <span style="color: #666;">Team: </span>
                                        <strong><field name="team_id"/></strong>
                                    </div>
                                    
                                    <!-- Stage -->
                                    <div style="margin-bottom: 6px;">
                                        <span style="color: #666;">Stage No: </span>
                                        <span style="background: #17a2b8; color: white; padding: 2px 6px; border-radius: 3px; font-size: 11px;">
                                            <field name="stage_no"/>
                                        </span>
                                        <!-- <span style="margin-left: 5px;"><field name="stage"/></span> -->
                                    </div>

                                    <div style="margin-bottom: 8px;">
                                        <span style="color: #666;">Stage: </span>
                                        <span>
                                            <field name="stage"/>
                                        </span>
                                    </div>
                                    
                                    <!-- Progress -->
                                    <div style="margin-bottom: 8px;">
                                        <span style="color: #666;">Progress: </span>
                                        <span style="background: #28a745; color: white; padding: 2px 6px; border-radius: 3px; font-size: 11px;">
                                            <field name="progress"/>
                                        </span>
                                    </div>
                                    
                                </div>
                                
                                <!-- Footer -->
                                <div style="border-top: 1px solid #eee; padding: 8px 10px; background: #f8f9fa;">
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <div>
                                            <t t-if="record.business_unit and record.business_unit.raw_value == 'automotive'">
                                                <span style="background: #007bff; color: white; padding: 2px 6px; border-radius: 3px; font-size: 10px;">
                                                    Automotive
                                                </span>
                                            </t>
                                            <t t-elif="record.business_unit and record.business_unit.raw_value == 'adnoc'">
                                                <span style="background: #6f42c1; color: white; padding: 2px 6px; border-radius: 3px; font-size: 10px;">
                                                    ADNOC
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span style="background: #6c757d; color: white; padding: 2px 6px; border-radius: 3px; font-size: 10px;">
                                                    <field name="business_unit"/>
                                                </span>
                                            </t>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <t t-if="record.create_uid and record.create_uid.raw_value">
                                                <img t-att-src="kanban_image('res.users', 'avatar_128', record.create_uid.raw_value)" 
                                                     width="20" height="20" 
                                                     class="oe_kanban_avatar" 
                                                     style="border-radius: 50%;"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                                
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_process_master" model="ir.actions.act_window">
            <field name="name">Process Master</field>
            <field name="res_model">process.master</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <record id="view_process_master_tree" model="ir.ui.view">
            <field name="name">process.user.master.list</field>
            <field name="model">process.user.master</field>
            <field name="arch" type="xml">
                <list string="Process User Master">
                    <field name="user_business_unit"/>
                    <field name="team_id"/>
                    <field name="user_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record id="view_process_master_forms" model="ir.ui.view">
            <field name="name">process.user.master.form</field>
            <field name="model">process.user.master</field>
            <field name="arch" type="xml">
                <form string="Process User Master">
                    <sheet>
                        <group>
                            <group>
                                <field name="user_business_unit"/>
                                <field name="portal_master_ids" invisible="True"/>
                                <field name="team_id" domain="[('id', 'in', portal_master_ids)]"/>
                                <field name="user_ids" widget="many2many_tags"/>
                                <field name="business_unit" invisible="True"/>
                            </group>
                            <group>
                                <!-- <field name="stage"/>
                                <field name="progress"/>
                                <field name="business_unit"/> -->
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

