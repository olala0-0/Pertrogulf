<odoo>
    <record id="paperformat_purchase_order_ajman" model="report.paperformat">
        <field name="name">Purchase Order - Petro Gulf Ajman</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_purchase_order_ajman" model="ir.actions.report">
        <field name="name">Purchase Order</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_purchase_order_report.report_purchase_order_ajman</field>
        <field name="report_file">custom_purchase_order_report.report_purchase_order_ajman</field>
        <field name="print_report_name">'Purchase Order - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_purchase_order_ajman"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>