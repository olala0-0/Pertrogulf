<odoo>
    <record id="paperformat_picking_list" model="report.paperformat">
        <field name="name">Picking List - Petro Gulf</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_picking_list" model="ir.actions.report">
        <field name="name">Picking List</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_purchase_order_report.report_picking_list</field>
        <field name="report_file">custom_purchase_order_report.report_picking_list</field>
        <field name="print_report_name">'Picking List - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_picking_list"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="domain">[('picking_type_code', '=', 'outgoing'), ('company_id.business_unit', 'in', ['pg_auto', 'pg_tblnd', 'pg_aviation'])]</field>
    </record>
</odoo>