<odoo>
    <template id="report_delivery_note_ajman">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="is_powerx" t-value="o.company_id.business_unit == 'pg_powerx'"/>
                <div class="page" style="font-size:12px; padding:0; margin:0;">

                    <!-- ============ HEADER (letterhead banner, SVG shape as background image) ============ -->
                    <div style="width:100%; height:42mm; background-repeat:no-repeat; background-size:100% 100%; background-image:url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyMTAgNDIiIHByZXNlcnZlQXNwZWN0UmF0aW89Im5vbmUiPjxwb2x5Z29uIHBvaW50cz0iMCwwIDIxMCwwIDIxMCwxNC40IDk5LjMsMTQuNCA4Ny45LDQyIDAsNDIiIGZpbGw9IiNkMWQzZDQiLz48L3N2Zz4=');">
                    <table style="width:100%; height:42mm; table-layout:fixed; border-collapse:collapse;">
                        <colgroup>
                            <col style="width:93mm;"/>
                            <col style="width:117mm;"/>
                        </colgroup>
                        <tr>
                            <td style="padding:3mm 4mm; vertical-align:middle; text-align:left;">
                                <img t-if="o.company_id.logo" t-att-src="o.company_id.get_logo_on_background()" style="max-height:36mm; max-width:100%;"/>
                            </td>
                            <td style="padding:6mm 18mm 6mm 4mm; vertical-align:middle; text-align:right;">
                                <span style="font-size:34px; font-weight:bold; color:#231f20;">DELIVERY NOTE</span>
                            </td>
                        </tr>
                    </table>
                    </div>

                    <div style="padding:3mm 7mm 0 7mm;">

                    <table style="width:100%; border-collapse:collapse; margin-bottom:15px;">
                        <tr>
                            <td style="width:55%; vertical-align:top; font-size:12px;">
                                <div><strong t-field="o.company_id.name"/></div>
                                <div t-if="o.company_id.street"><span t-field="o.company_id.street"/></div>
                                <div t-if="o.company_id.phone"><span t-field="o.company_id.phone"/></div>
                                <div t-if="o.company_id.email"><span t-field="o.company_id.email"/></div>
                                <div t-if="is_powerx">TRN <span t-field="o.company_id.vat"/></div>
                                <div t-if="o.company_id.website"><span t-field="o.company_id.website"/></div>
                            </td>
                            <td style="width:45%; vertical-align:top;">
                                <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:12px;">
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#d9d9d9; width:45%;">
                                            <span t-esc="'Delivery Order No.' if is_powerx else 'Delivery Note No.'"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;"><span t-field="o.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#d9d9d9;">Date</td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.date_done" t-options="{'widget': 'date'}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#d9d9d9;">
                                            <span t-esc="'Invoice No.' if is_powerx else 'Mode/Terms of Payment'"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-if="is_powerx" t-field="o.invoice_no"/>
                                            <span t-else="" t-field="o.sale_id.payment_term_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#d9d9d9;">
                                            <span t-esc="'Order Reference:' if is_powerx else &quot;Supplier's Ref.&quot;"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-if="is_powerx" t-field="o.origin"/>
                                            <span t-else="" t-field="o.sale_id.client_order_ref"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#d9d9d9;">
                                            <span t-esc="'Terms of Delivery' if is_powerx else 'Other Reference(s)'"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;"> </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ BUYER / REFERENCES ============ -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:15px;">
                        <tr>
                            <td style="width:48%; vertical-align:top;">
                                <div style="background-color:#d9d9d9; padding:4px 6px; font-weight:bold;">Buyer</div>
                                <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:12px;">
                                    <tr>
                                        <td style="padding:4px; width:40%;">Company Name</td>
                                        <td style="padding:4px;">: <span t-field="o.partner_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;">Address</td>
                                        <td style="padding:4px;">:
                                            <span t-field="o.partner_id.street"/>
                                            <span t-if="o.partner_id.city" t-field="o.partner_id.city"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;">Contact No.</td>
                                        <td style="padding:4px;">: <span t-field="o.partner_id.phone"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px;">TRN</td>
                                        <td style="padding:4px;">: <span t-field="o.partner_id.vat"/></td>
                                    </tr>
                                </table>
                            </td>
                            <td style="width:4%;"/>
                            <td style="width:48%; vertical-align:top;">
                                <table t-if="is_powerx" style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:12px; margin-top:19px;">
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2; width:25%;">DN No.</td>
                                        <td style="padding:4px; width:25%;"><span t-field="o.document_number"/></td>
                                        <td style="padding:4px; background-color:#f2f2f2; width:25%;">Date &amp; Time In</td>
                                        <td style="padding:4px; width:25%;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Vehicle No.</td>
                                        <td style="padding:4px;"><span t-field="o.vehicle_no"/></td>
                                        <td style="padding:4px; background-color:#f2f2f2;">Date &amp; Time Out</td>
                                        <td style="padding:4px;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Driver</td>
                                        <td style="padding:4px;"><span t-field="o.driver_name"/></td>
                                        <td style="padding:4px; background-color:#f2f2f2;">EID - No.</td>
                                        <td style="padding:4px;"><span t-field="o.driver_id"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Customer</td>
                                        <td style="padding:4px;"><span t-field="o.partner_id.name"/></td>
                                        <td style="padding:4px; background-color:#f2f2f2;">Container #1</td>
                                        <td style="padding:4px;"><span t-field="o.container_no"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Material</td>
                                        <td style="padding:4px;"> </td>
                                        <td style="padding:4px; background-color:#f2f2f2;">Container #2</td>
                                        <td style="padding:4px;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Loaded Weight</td>
                                        <td style="padding:4px;"> </td>
                                        <td style="padding:4px; background-color:#f2f2f2;">TANK NO</td>
                                        <td style="padding:4px;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Empty Weight</td>
                                        <td style="padding:4px;"> </td>
                                        <td style="padding:4px; background-color:#f2f2f2;">Vat Amount</td>
                                        <td style="padding:4px;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Net Weight</td>
                                        <td style="padding:4px;"> </td>
                                        <td style="padding:4px; background-color:#f2f2f2;">Total Amount</td>
                                        <td style="padding:4px;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Operator</td>
                                        <td style="padding:4px;"> </td>
                                        <td style="padding:4px;"></td>
                                        <td style="padding:4px;"></td>
                                    </tr>
                                </table>
                                <table t-else="" style="width:100%; border-collapse:collapse; border:1px solid #ccc; font-size:12px; margin-top:19px;">
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2; width:50%;">Buyer's Order No.</td>
                                        <td style="padding:4px;"><span t-field="o.sale_id.client_po_order_no"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Dated</td>
                                        <td style="padding:4px;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Despatch Document No.</td>
                                        <td style="padding:4px;"><span t-field="o.document_number"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Despatched through</td>
                                        <td style="padding:4px;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Destination</td>
                                        <td style="padding:4px;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px; background-color:#f2f2f2;">Terms of Delivery</td>
                                        <td style="padding:4px;"><span t-field="o.sale_id.incoterm.name"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ LINE ITEMS ============ -->
                    <table class="table table-sm" style="width:100%; border-collapse:collapse; font-size:12px;">
                        <thead>
                            <tr style="background-color:#d9d9d9;">
                                <th style="border:1px solid #ccc; padding:4px; width:8%;">Sn</th>
                                <th style="border:1px solid #ccc; padding:4px;">Description of Goods</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right; width:20%;">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sn" t-value="0"/>
                            <t t-foreach="o.move_ids.filtered(lambda m: m.state != 'cancel')" t-as="move">
                                <t t-set="sn" t-value="sn + 1"/>
                                <tr>
                                    <td style="border:1px solid #ccc; padding:4px;">
                                        <span t-esc="sn"/>
                                    </td>
                                    <td style="border:1px solid #ccc; padding:4px;">
                                        <span t-field="move.product_id.name"/>
                                    </td>
                                    <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                        <span t-field="move.quantity"/>
                                    </td>
                                </tr>
                            </t>
                            <tr style="background-color:#d9d9d9;">
                                <td colspan="2" style="border:1px solid #ccc; padding:4px; text-align:right;">
                                    <strong>Total</strong>
                                </td>
                                <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                    <span t-esc="sum(o.move_ids.filtered(lambda m: m.state != 'cancel').mapped('quantity'))"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <t t-if="is_powerx">
                        <div style="text-align:right; margin-top:20px; font-size:12px;">
                            <div>for <span t-field="o.company_id.name"/></div>
                            <div style="margin-top:24px;"><strong>Authorised Signatory</strong></div>
                        </div>
                        <div style="color:#c0392b; font-style:italic; font-weight:bold; text-align:right; margin-top:8px;">
                            Leave your Base Oil with us
                        </div>
                        <div style="margin-top:20px; font-size:11px;">
                            <div style="text-decoration:underline; font-weight:bold;">Declaration</div>
                            <div>
                                We declare that this invoice shows the actual price of the goods
                                described and that all particulars are true and correct
                            </div>
                        </div>
                        <div style="text-align:center; font-size:10px; margin-top:15px;">
                            This is a Computer Generated Invoice
                        </div>
                    </t>
                    <t t-else="">
                        <div style="margin-top:6px;">
                            <span>Received in Good Condition</span>
                            <span style="float:right; font-style:italic;">E. &amp; O.E</span>
                        </div>

                        <div style="text-align:right; margin-top:60px;">
                            <strong>For <span t-field="o.company_id.name"/></strong>
                        </div>

                        <div style="margin-top:20px; font-size:10px;">
                            <span>F-IM S-ACC-05</span>
                            <span style="float:right;">This is a Computer Generated Invoice</span>
                        </div>
                    </t>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>