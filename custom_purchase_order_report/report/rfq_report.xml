<odoo>
    <template id="report_rfq">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-size:12px; padding:0; margin:0;">

                    <!-- ============ HEADER (letterhead banner, SVG shape as background image) ============ -->
                    <div style="width:100%; height:42mm; background-repeat:no-repeat; background-size:100% 100%; background-image:url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyMTAgNDIiIHByZXNlcnZlQXNwZWN0UmF0aW89Im5vbmUiPjxwb2x5Z29uIHBvaW50cz0iMCwwIDIxMCwwIDIxMCwxNC40IDk5LjMsMTQuNCA4Ny45LDQyIDAsNDIiIGZpbGw9IiNkMWQzZDQiLz48L3N2Zz4=');">
                    <table style="width:100%; height:42mm; table-layout:fixed; border-collapse:collapse;">
                        <colgroup>
                            <col style="width:93mm;"/>
                            <col style="width:117mm;"/>
                        </colgroup>
                        <tr>
                            <td style="padding:7mm 4mm; vertical-align:middle; text-align:center;">
                                <img t-if="o.company_id.logo" t-att-src="o.company_id.get_logo_on_background()" style="max-height:28mm; max-width:100%;"/>
                            </td>
                            <td style="padding:6mm 18mm 6mm 4mm; vertical-align:middle; text-align:right;">
                                <span style="font-size:27px; font-weight:bold; color:#231f20;">REQUEST FOR QUOTATION</span>
                            </td>
                        </tr>
                    </table>
                    </div>

                    <div style="padding:3mm 7mm 0 7mm;">

                    <table style="width:100%; border-collapse:collapse; margin-bottom:15px;">
                        <tr>
                            <td style="width:55%; vertical-align:top; font-size:12px;">
                                <div><strong t-field="o.company_id.name"/></div>
                                <div t-if="o.company_id.street"><span t-field="o.company_id.street"/></div>
                                <div t-if="o.company_id.phone"><span t-field="o.company_id.phone"/></div>
                                <div t-if="o.company_id.email"><span t-field="o.company_id.email"/></div>
                                <div t-if="o.company_id.website"><span t-field="o.company_id.website"/></div>
                            </td>
                            <td style="width:45%; vertical-align:top;">
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2; width:35%;">
                                            <strong>RFQ No</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>RFQ Date</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.date_order" t-options="{'widget': 'date'}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px; background-color:#f2f2f2;">
                                            <strong>TRN</strong>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="o.company_id.vat"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ LINE ITEMS ============ -->
                    <table class="table table-sm" style="width:100%; border-collapse:collapse; font-size:11px;">
                        <thead>
                            <tr style="background-color:#d9d9d9;">
                                <th style="border:1px solid #ccc; padding:4px;">Sn</th>
                                <th style="border:1px solid #ccc; padding:4px;">Description of Goods</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">Expected Date</th>
                                <th style="border:1px solid #ccc; padding:4px; text-align:right;">QTY</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sn" t-value="0"/>
                            <t t-foreach="o.order_line" t-as="line">
                                <t t-if="not line.display_type">
                                    <t t-set="sn" t-value="sn + 1"/>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-esc="sn"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.date_planned" t-options="{'widget': 'date'}"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:4px; text-align:right;">
                                            <span t-field="line.product_qty"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- ============ SIGNATORY ============ -->
                    <table style="width:100%; border-collapse:collapse; margin-top:60px;">
                        <tr>
                            <td style="width:60%;"/>
                            <td style="width:40%; text-align:center; background-color:#d9d9d9; padding:10px;">
                                <div>for <span t-field="o.company_id.name"/></div>
                                <div style="margin-top:40px;"><strong>Authorised Signatory</strong></div>
                            </td>
                        </tr>
                    </table>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
