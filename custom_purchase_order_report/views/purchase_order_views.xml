<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_custom_report" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.custom.report</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Extra Information" name="extra_information">
                    <group>
                        <group>
                            <field name="voucher_no"/>
                            <field name="buyer_order_no"/>
                            <field name="other_ref"/>
                            <field name="place_of_supply"/>
                        </group>
                        <group>
                            <field name="destination"/>
                            <field name="despatch_through"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
