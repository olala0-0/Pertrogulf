<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cabang itu sendiri disaring per perusahaan, seperti data
             master lain. Aturan untuk DOKUMEN (sale order, invoice, transfer,
             dan seterusnya) tidak ada di sini: itu milik modul yang memang
             memasang field cabang pada dokumennya. -->
        <record id="rule_ms_branch_company" model="ir.rule">
            <field name="name">Branch: multi-company</field>
            <field name="model_id" ref="model_ms_branch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
