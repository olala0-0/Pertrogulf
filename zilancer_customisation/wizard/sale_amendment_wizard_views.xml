<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_sale_order_amendment_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.amendment.wizard.form</field>
        <field name="model">sale.order.amendment.wizard</field>
        <field name="arch" type="xml">
            <form string="Amendment Details">
                <sheet>
                    <group>
                        <field name="sale_order_id" invisible="True"/>
                        <field name="amendment_reason_id"/>
                        <!-- options="{'no_create': True}" -->
                        <field name="remarks"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Action for the wizard -->
    <record id="action_sale_order_amendment_wizard" model="ir.actions.act_window">
        <field name="name">Amendment Details</field>
        <field name="res_model">sale.order.amendment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>