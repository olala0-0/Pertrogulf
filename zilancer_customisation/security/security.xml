        </record>

        <!-- Rule 1: Team Leader can see all team records -->
        <record id="crm_lead_team_leader_rule" model="ir.rule">
            <field name="name">CRM Lead: Team Leader Access</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[
                '|',
                ('user_id', '=', user.id),
                ('team_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule 2: Team Member can only see own records -->
        <record id="crm_lead_team_member_rule" model="ir.rule">
            <field name="name">CRM Lead: Team Member Own Records</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

