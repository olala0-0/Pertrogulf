<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form view inherit for Manufacturing Order -->
        <record id="mrp_production_form_view_inherit_marine" model="ir.ui.view">
            <field name="name">mrp.production.form.inherit.marine</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <field name="business_unit" invisible="1"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Additional Details" name="additional_details" invisible="business_unit != 'pg_marine'">
                        <group>
                            <group>
                                <field name="vessel_no_id"/>
                                <field name="imo_number"/>
                                <field name="port_master_id"/>
                                <field name="country_port_id"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- List view inherit for Manufacturing Order -->
        <record id="mrp_production_tree_view_inherit_marine" model="ir.ui.view">
            <field name="name">mrp.production.tree.inherit.marine</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="vessel_no_id" optional="show"/>
                    <field name="imo_number" optional="show"/>
                    <field name="port_master_id" optional="show"/>
                    <field name="country_port_id" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
