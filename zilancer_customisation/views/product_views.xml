    <record id="product_template_form_view_customs" model="ir.ui.view">
        <field name="name">product.template.form.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Sales / Purchase / Inventory tabs were forced hidden here;
                 leave them visible so standard Odoo product tabs show. -->
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="height"/>
                <field name="width"/>
                <field name="gross_weight"/>
                <field name="net_weight"/>
                <field name="density"/>
                <field name="pds_link"/>
                <field name="pack_size_id"/>
                <field name="moq_pkg_type"/>
                <field name="kgs_per_pkg_type"/>
            </xpath>
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="is_expences" readonly="False"/>
                    <label for="is_expences"/>
                </span>
            </xpath>
            <xpath expr="//field[@name='type']" position="after">
                <field name="sap_fg_code"/>
                <field name="hs_code"/>
                <field name="client_product_code"/>
                <field name="sap_fg_description"/>
                <field name="client_fg_description"/>
            </xpath>

            <!-- Analysis Codes tab (template + variant forms) -->
            <xpath expr="//notebook" position="inside">
                <page string="Analysis Codes" name="analysis_codes">
                    <group>
                        <group>
                            <field name="analysis_product_type_id"/>
                            <field name="analysis_brand_id"/>
                            <field name="analysis_product_categ_id"/>
                            <field name="analysis_api_id"/>
                        </group>
                        <group>
                            <field name="analysis_sae_id"/>
                            <field name="analysis_tbn_id"/>
                            <field name="analysis_iso_tbn_id"/>
                            <field name="analysis_package_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sale.product_template_action" model="ir.actions.act_window">
        <field name="domain">['|', '|', ('company_id', '!=', False), ('name', 'ilike', 'Delivery%'), ('name', 'ilike', 'Discount%')]</field>
    </record>

</odoo>