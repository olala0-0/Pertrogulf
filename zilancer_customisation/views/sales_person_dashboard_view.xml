<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Dashboard Tree View -->
    <record id="view_sales_person_dashboard_tree" model="ir.ui.view">
        <field name="name">sales.person.dashboard.list</field>
        <field name="model">sales.person.dashboard</field>
        <field name="arch" type="xml">
            <list string="Sales Dashboards" decoration-info="lead_count > 0" decoration-success="order_count > 0">
                <field name="name"/>
                <field name="user_id"/>
                <field name="lead_count"/>
                <field name="opportunity_count"/>
                <field name="quotation_count"/>
                <field name="order_count"/>
                <field name="delivered_count"/>
                <field name="total_revenue"/>
                <!-- <field name="quotation_to_order_rate" widget="percentage"/> -->
                <field name="date_from"/>
                <field name="date_to"/>
            </list>
        </field>
    </record>
    
    <!-- Dashboard Graph View -->
    <record id="view_sales_person_dashboard_graph" model="ir.ui.view">
        <field name="name">sales.person.dashboard.graph</field>
        <field name="model">sales.person.dashboard</field>
        <field name="arch" type="xml">
            <graph string="Sales Performance Analysis" type="bar" stacked="True">
                <field name="user_id"/>
                <field name="lead_count"/>
                <field name="opportunity_count"/>
                <field name="quotation_count"/>
                <field name="order_count"/>
                <!-- <field name="total_revenue" type="measure"/> -->
                <!-- <field name="quotation_to_order_rate" type="measure"/> -->
            </graph>
        </field>
    </record>
    
    <!-- Dashboard Pivot View -->
    <record id="view_sales_person_dashboard_pivot" model="ir.ui.view">
        <field name="name">sales.person.dashboard.pivot</field>
        <field name="model">sales.person.dashboard</field>
        <field name="arch" type="xml">
            <pivot string="Sales Performance Analysis" display_quantity="true">
                <field name="user_id" type="row"/>
                <field name="lead_count" type="measure"/>
                <field name="opportunity_count" type="measure"/>
                <field name="quotation_count" type="measure"/>
                <field name="order_count" type="measure"/>
                <field name="total_revenue" type="measure"/>
                <!-- <field name="quotation_to_order_rate" type="measure"/> -->
            </pivot>
        </field>
    </record>

    <!-- Dashboard Form View -->
    <record id="view_sales_person_dashboard_form" model="ir.ui.view">
        <field name="name">sales.person.dashboard.form</field>
        <field name="model">sales.person.dashboard</field>
        <field name="arch" type="xml">
            <form string="Sales Person Dashboard">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_leads" type="object" class="oe_stat_button" icon="fa-star">
                            <field name="lead_count" widget="statinfo" string="Leads"/>
                        </button>
                        <button name="action_view_opportunities" type="object" class="oe_stat_button" icon="fa-star-half-o">
                            <field name="opportunity_count" widget="statinfo" string="Opportunities"/>
                        </button>
                        <button name="action_view_inquiries" type="object" class="oe_stat_button" icon="fa-question-circle">
                            <field name="inquiry_count" widget="statinfo" string="Inquiries"/>
                        </button>
                        <button name="action_view_quotations" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="quotation_count" widget="statinfo" string="Quotations"/>
                        </button>
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-usd">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_view_deliveries" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="delivered_count" widget="statinfo" string="Deliveries"/>
                        </button>
                    </div>
                    <field name="color" widget="color_picker" invisible="True"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="active"/>
                            <field name="currency_id" invisible="True"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Performance Summary">
                            <group>
                                <group string="Activity">
                                    <div class="row">
                                        <div class="col-xs-6">
                                            <field name="lead_count"/>
                                            <label for="lead_count" string="Leads"/>
                                        </div>
                                        <div class="col-xs-6">
                                            <field name="opportunity_count"/>
                                            <label for="opportunity_count" string="Opportunities"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-xs-6">
                                            <field name="quotation_count"/>
                                            <label for="quotation_count" string="Quotations"/>
                                        </div>
                                        <div class="col-xs-6">
                                            <field name="order_count"/>
                                            <label for="order_count" string="Orders"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-xs-6">
                                            <field name="inquiry_count"/>
                                            <label for="inquiry_count" string="Inquiries"/>
                                        </div>
                                        <div class="col-xs-6">
                                        </div>
                                    </div>
                                </group>
                                <group>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

