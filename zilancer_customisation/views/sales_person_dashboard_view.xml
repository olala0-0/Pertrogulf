    <!-- Tree View -->
    <record id="view_sales_performance_tree" model="ir.ui.view">
        <field name="name">sales.performance.list</field>
        <field name="model">sales.performance</field>
        <field name="arch" type="xml">
            <list string="Sales Performance">
                <field name="salesperson"/>
                <field name="sales_metric"/>
                <field name="value"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sales_performance_form" model="ir.ui.view">
        <field name="name">sales.performance.form</field>
        <field name="model">sales.performance</field>
        <field name="arch" type="xml">
            <form string="Sales Performance">
                <sheet>
                    <group>
                        <field name="salesperson"/>
                        <field name="sales_metric"/>
                        <field name="value"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sales_performance_search" model="ir.ui.view">
        <field name="name">sales.performance.search</field>
        <field name="model">sales.performance</field>
        <field name="arch" type="xml">
            <search string="Sales Performance">
                <field name="salesperson"/>
                <field name="sales_metric"/>
                <group>
                    <filter string="Sales Person" name="group_by_salesperson" domain="[]" context="{'group_by': 'salesperson'}"/>
                    <filter string="Sales Metric" name="group_by_metric" domain="[]" context="{'group_by': 'sales_metric'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_sales_performance_pivot" model="ir.ui.view">
        <field name="name">sales.performance.pivot</field>
        <field name="model">sales.performance</field>
        <field name="arch" type="xml">
            <pivot string="Sales Performance" display_quantity="true">
                <field name="salesperson" type="row"/>
                <field name="sales_metric" type="col"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_sales_performance_graph" model="ir.ui.view">
        <field name="name">sales.performance.graph</field>
        <field name="model">sales.performance</field>
        <field name="arch" type="xml">
            <graph string="Sales Performance" type="bar" stacked="0">
                <field name="salesperson" type="row"/>
                <field name="sales_metric" type="col"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sales_performance_view" model="ir.actions.act_window">
        <field name="name">Sales Performance</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sales.performance</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_group_by_salesperson': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create sales performance records to see the graph
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_sales_performance"
              name="Sales Performance"
              parent="sale.menu_sale_report"
              action="action_sales_performance_view"
              sequence="20"/>

