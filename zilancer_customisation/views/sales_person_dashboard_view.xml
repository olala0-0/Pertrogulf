    <record id="view_sales_person_dashboard_kanban" model="ir.ui.view">
    <field name="name">sales.person.dashboard.kanban</field>
    <field name="model">sales.person.dashboard</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_dashboard sales_person_dashboard" sample="True">
            <field name="id"/>
            <field name="name"/>
            <field name="user_id"/>
            <field name="lead_count"/>
            <field name="opportunity_count"/>
            <field name="inquiry_count"/>
            <field name="quotation_count"/>
            <field name="order_count"/>
            <field name="delivered_count"/>
            <field name="color"/>
            <field name="total_revenue"/>
            <!-- <field name="quotation_to_order_rate"/> -->
            <templates>
                <t t-name="kanban-box">
                    <div t-attf-class="#{kanban_color(record.color.raw_value)} oe_kanban_card oe_kanban_global_click" 
                         style="border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); position: relative; overflow: hidden;">
                        <!-- Top color bar indicator -->
                        <div t-attf-style="height: 6px; background-color: #{kanban_color(record.color.raw_value, 'backgroundColor')}; width: 100%;"></div>
                        
                        <div class="o_kanban_card_header" style="padding: 12px 16px; border-bottom: 1px solid #f0f0f0;">
                            <div class="o_kanban_card_header_title" style="display: flex; align-items: center;">
                                <div class="o_primary" style="font-size: 18px; font-weight: 600; color: #212529;">
                                    <field name="name"/>
                                </div>
                                <!-- <div class="o_secondary" style="margin-left: auto; background-color: #f8f9fa; border-radius: 20px; padding: 4px 12px; font-size: 13px; color: #6c757d;">
                                    <field name="user_id"/>
                                </div> -->
                            </div>
                        </div>
                        
                        <div class="container o_kanban_card_content" style="padding: 16px 8px;">
                            
                            <!-- Stats Counter Rows -->
                            <div class="row" style="margin-bottom: 12px;">
                                <div class="col-xs-4" style="text-align: center;background-color: #e9f5fe; border-radius: 8px;">
                                    <a name="action_view_leads" type="object" style="text-decoration: none;">
                                        <div style="background-color: #e9f5fe; border-radius: 8px;">
                                            <span class="o_value" style="display: block; font-size: 20px; font-weight: 600; color: #0d6efd;">
                                                <field name="lead_count"/>
                                            </span>
                                            <span class="o_label" style="display: block; font-size: 12px; color: #6c757d;">Leads</span>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-xs-4" style="text-align: center;background-color: #fff4e5; border-radius: 8px;">
                                    <a name="action_view_opportunities" type="object" style="text-decoration: none;">
                                        <div>
                                            <span class="o_value" style="display: block; font-size: 20px; font-weight: 600; color: #fd7e14;">
                                                <field name="opportunity_count"/>
                                            </span>
                                            <span class="o_label" style="display: block; font-size: 12px; color: #6c757d;">Opportunities</span>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-xs-4" style="text-align: center;background-color: #f8f9fa; border-radius: 8px;">
                                    <a name="action_view_inquiries" type="object" style="text-decoration: none;">
                                        <div style="background-color: #f8f9fa; border-radius: 8px;">
                                            <span class="o_value" style="display: block; font-size: 20px; font-weight: 600; color: #6c757d;">
                                                <field name="inquiry_count"/>
                                            </span>
                                            <span class="o_label" style="display: block; font-size: 12px; color: #6c757d;">Inquiries</span>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-xs-6" style="text-align: center;background-color: #e8f5e9; border-radius: 8px;">
                                    <a name="action_view_quotations" type="object" style="text-decoration: none;">
                                        <div style="background-color: #e8f5e9; border-radius: 8px;">
                                            <span class="o_value" style="display: block; font-size: 20px; font-weight: 600; color: #28a745;">
                                                <field name="quotation_count"/>
                                            </span>
                                            <span class="o_label" style="display: block; font-size: 12px; color: #6c757d;">Quotations</span>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-xs-6" style="text-align: center;background-color: #e3f2fd; border-radius: 8px;">
                                    <a name="action_view_orders" type="object" style="text-decoration: none;">
                                        <div style="background-color: #e3f2fd; border-radius: 8px;">
                                            <span class="o_value" style="display: block; font-size: 20px; font-weight: 600; color: #0d6efd;">
                                                <field name="order_count"/>
                                            </span>
                                            <span class="o_label" style="display: block; font-size: 12px; color: #6c757d;">Orders</span>
                                        </div>
                                    </a>
                                </div>
                            </div>
                            <!-- <div class="row">
                                <div class="col-xs-6" style="text-align: center;background-color: #e8f5e9; border-radius: 8px;">
                                    <a name="action_view_quotations" type="object" style="text-decoration: none;">
                                        <div style="background-color: #e8f5e9; border-radius: 8px;">
                                            <span class="o_value" style="display: block; font-size: 20px; font-weight: 600; color: #28a745;">
                                                <field name="quotation_count"/>
                                            </span>
                                            <span class="o_label" style="display: block; font-size: 12px; color: #6c757d;">Quotations</span>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-xs-6" style="text-align: center;background-color: #e3f2fd; border-radius: 8px;">
                                    <a name="action_view_orders" type="object" style="text-decoration: none;">
                                        <div style="background-color: #e3f2fd; border-radius: 8px;">
                                            <span class="o_value" style="display: block; font-size: 20px; font-weight: 600; color: #0d6efd;">
                                                <field name="order_count"/>
                                            </span>
                                            <span class="o_label" style="display: block; font-size: 12px; color: #6c757d;">Orders</span>
                                        </div>
                                    </a>
                                </div>
                            </div> -->
                        </div>
                        
                        <!-- Progress bar showing conversion rate -->
                        <!-- <div style="height: 5px; width: 100%; background-color: #e9ecef; margin-top: 5px;">
                            <div t-att-style="'height: 100%; width: ' + Math.min(record.quotation_to_order_rate.raw_value || 0, 100) + '%; background-color: #28a745;'"></div>
                        </div> -->
                        
                        <!-- Manage Dropdown Menu -->
                        <div class="o_dropdown_kanban dropdown" 
                             style="position: absolute; top: 10px; right: 10px;">
                            <a class="dropdown-toggle o-no-caret btn" 
                               data-toggle="dropdown" 
                               style="background-color: rgba(255,255,255,0.9); border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-ellipsis-v" style="color: #6c757d;"/>
                            </a>
                            <div class="dropdown-menu" role="menu" 
                                 style="border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); border: none; padding: 8px 0;">
                                <div class="o_kanban_card_manage_title" 
                                     style="padding: 8px 16px; font-weight: 600; color: #495057; border-bottom: 1px solid #f0f0f0;">
                                    <span>More Info</span>
                                </div>
                                <div style="padding: 4px 16px;">
                                    <a name="action_view_leads" type="object">Leads</a>
                                </div>
                                <div style="padding: 4px 16px;">
                                    <a name="action_view_opportunities" type="object">Opportunities</a>
                                </div>
                                <div style="padding: 4px 16px;">
                                    <a name="action_view_inquiries" type="object">Inquiries</a>
                                </div>
                                <div style="padding: 4px 16px;">
                                    <a name="action_view_quotations" type="object">Quotations</a>
                                </div>
                                <div style="padding: 4px 16px;">
                                    <a name="action_view_orders" type="object">Orders</a>
                                </div>
                                <div style="padding: 4px 16px;">
                                    <a name="action_view_deliveries" type="object">Deliveries</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

    <!-- Dashboard Search View -->
    <record id="view_sales_person_dashboard_search" model="ir.ui.view">
        <field name="name">sales.person.dashboard.search</field>
        <field name="model">sales.person.dashboard</field>
        <field name="arch" type="xml">
            <search string="Search Dashboards">
                <field name="name"/>
                <field name="user_id"/>
                <filter string="My Dashboard" name="my_dashboard" domain="[('user_id', '=', uid)]"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <group>
                    <filter string="Sales Person" name="group_by_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Dashboard Action Window -->
    <record id="action_sales_person_dashboard" model="ir.actions.act_window">
        <field name="name">Sales Performance</field>
        <field name="res_model">sales.person.dashboard</field>
        <field name="view_mode">kanban,list,graph,pivot,form</field>
        <field name="context">{'search_default_my_dashboard': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No dashboard found. Let's create one!
            </p>
            <p>
                Create your personalized sales dashboard to track your performance.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_sales_person_dashboard" 
              name="Sales Performance" 
              parent="sale.menu_sale_report" 
              action="action_sales_person_dashboard" 
              sequence="5"/>




