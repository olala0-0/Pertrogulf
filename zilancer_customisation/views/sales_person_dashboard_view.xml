        <field name="domain">[('salesperson', '=', 'Dharmesh')]</field>
    </record>

    <!-- Add a menu item -->
    <menuitem id="menu_sales_performance_report"
              name="Sales Performance"
              parent="sale.menu_sale_report"
              action="action_sales_performance_report"
              sequence="30"/>
    
