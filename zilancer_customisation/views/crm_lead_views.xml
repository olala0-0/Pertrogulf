<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Modify CRM Lead View to Show Action Points -->
        <record id="view_crm_lead_form_inherit" model="ir.ui.view">
            <field name="name">crm.lead.form.action.points</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Action Points">
                        <field name="action_point_ids" nolabel="True">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="action_type_id"/>
                                <field name="remarks"/>
                                <field name="status"/>
                            </list>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//field[@name='date_deadline']" position="attributes">
                    <attribute name="required">True</attribute>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="before">
                    <field name="expected_volume_ltr"/>
                </xpath>
            </field>
        </record>

        <record id="view_crm_case_tree_view_oppor_inherit" model="ir.ui.view">
            <field name="name">crm.lead.list</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='phone']" position="before">
                    <field name="expected_volume_ltr" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="crm_lead_view_pivot_inherits" model="ir.ui.view">
            <field name="name">crm.lead.pivot</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_pivot"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='expected_revenue']" position="after">
                    <field name="expected_volume_ltr" type="measure"/>
                </xpath>
            </field>
        </record>

        <record id="crm_case_kanban_view_leads_inherits" model="ir.ui.view">
            <field name="name">crm.lead.kanban</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
            <field name="arch" type="xml">
                <!-- <xpath expr="//field[@name='expected_revenue']" position="after">
                    <field name="expected_volume_ltr"/>
                </xpath> -->
                <xpath expr="//div" position="inside">
                    <div class="d-flex gap-2">
                        <field name="expected_volume_ltr"/>
                        <span>Liters</span>
                    </div>
                </xpath>
                <xpath expr="//progressbar" position="replace">
                    <!-- <attribute name="sum_field">prorated_revenue</attribute>
                    <attribute name="sum_field">expected_volume_ltr</attribute>
                    <attribute name="recurring_revenue_sum_field">recurring_revenue_monthly_prorated</attribute> -->
                    <progressbar field="activity_state" colors="{&quot;planned&quot;: &quot;success&quot;, &quot;today&quot;: &quot;warning&quot;, &quot;overdue&quot;: &quot;danger&quot;}" sum_field="expected_revenue" recurring_revenue_sum_field="expected_volume_ltr" help="This bar allows to filter the opportunities based on scheduled activities."/>
                </xpath>
            </field>
        </record>

        <record id="crm_case_kanban_view_leads_inherits_forecast" model="ir.ui.view">
            <field name="name">crm.lead.kanban</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_kanban_forecast"/>
            <field name="arch" type="xml">
                <xpath expr="//div" position="inside">
                    <div class="d-flex gap-2">
                        <field name="expected_volume_ltr"/>
                        <span>Liters</span>
                    </div>
                </xpath>
            </field>
        </record>

        

        

    </data>
</odoo>
