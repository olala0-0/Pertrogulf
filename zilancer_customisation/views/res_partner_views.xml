        <record id="view_res_partner_filter_inherit" model="ir.ui.view">
            <field name="name">res.partner.saleorder.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="priority" eval="20"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="region_code_id"/>
                </xpath>
                <xpath expr="//filter[@name='group_company']" position="replace">
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </xpath>
            </field>
        </record>

        <record id="contacts.action_contacts" model="ir.actions.act_window">
            <field name="domain" eval="['|', ('customer_rank', '>', 0), ('supplier_rank', '>', 0)]"/>
        </record>

        <record id="link_tracker_view_form_inherit" model="ir.ui.view">
            <field name="name">link.tracker.view.form.inherit</field>
            <field name="model">link.tracker</field>
            <field name="inherit_id" ref="link_tracker.link_tracker_view_form"/>
            <field name="arch" type="xml">

                <!-- Replace the whole group -->
                <group name="link" string="Link">
                    <group name="link" string="Link">
                        <field name="url" string="Target Link"/>
                        <field name="title"/>
                        <field name="label"/>
                        <field name="short_url_host" string="Tracked URL"/>
                    </group>
                </group>

            </field>
        </record>
    </data>
