                                <field name="function"/> at <field name="parent_id"/>
                            </div>
                        </div>
                        <div t-if="record.city.raw_value or record.country_id.raw_value">
                            <field name="city"/>
                            <span t-if="record.city.raw_value and record.country_id.raw_value">, </span>
                            <field name="country_id"/>
                        </div>
                        <field name="email" class="text-truncate"/>
                        <footer><div/></footer>
                    </main> -->
                    <main class="ps-2 ps-md-0">
                        <div class="mb-1">
                            <!-- Sort Name and Name -->
                            <!-- <field name="sort_name" class="fw-bold text-primary"/>
                            <field name="name" class="text-muted"/> -->
                            <field t-if="record.parent_id.raw_value" class="text-muted" name="display_name"/>
                            <field t-if="!record.parent_id.raw_value" class="text-muted" name="display_name"/>
                            
                        </div>

                        <div class="mb-1">
                            <!-- Designation -->
                            <field name="function" class="text-muted"/>
                        </div>

                        <!-- Contact Info with icons -->
                        <div class="mt-1">
                            
                            <!-- Phone -->
                            <t t-if="record.phone.raw_value">
                                <i class="fa fa-phone me-1 text-success"/> 
                                <field name="phone"/>
                            </t>
                            <br/>

                            <!-- Email -->
                            <t t-if="record.email.raw_value">
                                <i class="fa fa-envelope me-1 text-info"/>
                                <field name="email"/>
                            </t>
                            <br/>

                            <!-- WhatsApp -->
                            <!-- <t t-if="record.mobile.raw_value">
                                <i class="fa fa-whatsapp me-1 text-success"/>
                                <field name="mobile"/>
                            </t> -->
                        </div>

                        <!-- Optional: City & Country -->
                        <div class="mt-1">
                            <field name="city"/>
                            <span t-if="record.city.raw_value and record.country_id.raw_value">, </span>
                            <field name="country_id"/>
                        </div>

                        <!-- Footer (Empty or add action buttons if needed) -->
                        <footer><div/></footer>
                    </main>
                </xpath>
            </field>
        </record>
        
