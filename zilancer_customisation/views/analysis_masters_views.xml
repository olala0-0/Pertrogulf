<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shared list / form structure for analysis masters -->
    <record id="view_analysis_product_type_list" model="ir.ui.view">
        <field name="name">analysis.product.type.list</field>
        <field name="model">analysis.product.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_analysis_product_type_form" model="ir.ui.view">
        <field name="name">analysis.product.type.form</field>
        <field name="model">analysis.product.type</field>
        <field name="arch" type="xml">
            <form string="Product Type">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_analysis_product_type" model="ir.actions.act_window">
        <field name="name">Product Type</field>
        <field name="res_model">analysis.product.type</field>
        <field name="view_mode">list,form</field>
    </record>

