<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form_inherits" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <field name="picking_type_code" invisible="1"/>
                    <field name="business_unit" invisible="1"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Dispatch Instructions" invisible="1">
                        <group>
                            <group>
                                <field name="vessel_no" required="False"/>
                                <field name="invoice_no" required="False"/>
                                <field name="invoice_date" required="False"/>
                                <field name="expected_arrival_days"/>
                                <field name="other_expected_days" invisible="expected_arrival_days != 'others'"/>
                                <field name="eta_date" readonly="True"/>
                            </group>
                            <group>
                                <field name="eta1"/>
                                <field name="remark1"/>
                                <field name="eta2"/>
                                <field name="remark2"/>
                                <field name="eta3"/>
                                <field name="remark3"/>
                                <field name="actual"/>
                                <field name="final_remark"/>
                                <field name="custom_no"/>
                            </group>
                        </group>
                    </page>
                    <!-- <page string="Document Information">
                        <group>
                            <group string="Document Information">
                                <field name="document_type" widget="radio" options="{'horizontal': true}"/>
                                <field name="document_number" readonly="True" force_save="True"/>
                            </group>
                            <group string="Additional Information">
                                <field name="customer_lpo_no"/>
                                <field name="container_no"/>
                                <field name="seal_no"/>
                                <field name="vehicle_no"/>
                            </group>
                        </group>
                    </page> -->
                    <page string="Driver Details" invisible="picking_type_code != 'outgoing'">
                        <!-- invisible="picking_type_code != 'outgoing' or business_unit != 'pg_marine'" -->
                        <!-- invisible="company_id != 9" -->
                        <group string="Driver Details">
                            <group>
                                <field name="driver_name"/>
                                <field name="driver_id"/>
                                <field name="driver_emirates_id" filename="driver_emirates_id_filename"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </page>
                    <page string="Document Details" invisible="picking_type_code != 'outgoing'">
                        <group string="Driver Details">
                            <group>
                                <field name="prepared_by"/>
                                <field name="loaded_by_id" options="{'no_open': True, 'no_create': True}"/>
                            </group>
                            <group>
                                <field name="approved_by"/>
                                <field name="receiver_name"/>
                                <field name="receiver_sign" invisible="receiver_sign == False" />
                            </group>
                        </group>
                    </page>
                    <page string="Additional Details" name="additional_details" invisible="business_unit != 'pg_marine'">
                        <group>
                            <group>
                                <field name="vessel_no_id"/>
                                <field name="imo_number"/>
                                <field name="port_master_id"/>
                                <field name="country_port_id"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//page[@name='note']" position="attributes">
                    <attribute name="string">Delivery Instruction</attribute>
                </xpath>
                <xpath expr="//page[@name='note']/field[@name='note']" position="attributes">
                    <attribute name="string">Delivery Instruction</attribute>
                    <attribute name="placeholder">Delivery instructions for this order...</attribute>
                </xpath>

                <!-- Allow changing UoM on operations until Done/Cancel (e.g. match PO UoM on receipt) -->
                <xpath expr="//page[@name='operations']//field[@name='move_ids']/list/field[@name='product_uom']" position="attributes">
                    <attribute name="readonly">state in ('done', 'cancel')</attribute>
                </xpath>
                <!-- Add package and pack fields to the Operations page list view -->
                <xpath expr="//page[@name='operations']//field[@name='move_ids']/list/field[@name='product_uom']" position="after">
                    <!-- <field name="package" string="Package"/> -->
                    <!-- <field name="pack" string="Pack"/> -->
                    <!-- <field name="batch_no"/> -->
                    <!-- <field name="mfg_date"/> -->
                    <field name="sample_type" column_invisible="parent.document_type != 'general_dispatch'" optional="show"/>
                    <!-- <field name="exp_date" column_invisible="parent.document_type != 'dispatch_advise'" optional="show"/> -->
                    <field name="sap_fg_code" column_invisible="parent.document_type != 'dispatch_advise'" optional="show"/>
                    <field name="remarks" string="Dispatch Instructions"/>
                </xpath>
                <xpath expr="//field[@name='location_id']" position="after">
                    <field name="document_type" widget="radio" options="{'horizontal': true}" invisible="picking_type_code != 'outgoing'"/>
                    <field name="document_number" readonly="True" force_save="True" invisible="picking_type_code != 'outgoing'"/>
                    <field name="manual_dispatch_note_no" invisible="picking_type_code != 'outgoing'"/>
                </xpath>
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="customer_lpo_no" invisible="picking_type_code != 'outgoing'"/>
                    <field name="container_no" invisible="picking_type_code != 'outgoing'"/>
                    <field name="seal_no" invisible="picking_type_code != 'outgoing'"/>
                    <field name="vehicle_no" invisible="picking_type_code != 'outgoing'"/>
                </xpath>
            </field>
        </record>

        <record id="vpicktree_inherit_marine" model="ir.ui.view">
            <field name="name">stock.picking.tree.inherit.marine</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="document_number" optional="show"/>
                    <field name="manual_dispatch_note_no" optional="show"/>
                    <field name="vessel_no_id" optional="show"/>
                    <field name="imo_number" optional="show"/>
                    <field name="port_master_id" optional="show"/>
                    <field name="country_port_id" optional="show"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
