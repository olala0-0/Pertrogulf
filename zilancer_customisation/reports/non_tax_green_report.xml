        <div class="row col-12 mb4">
            <t t-if="doc.state in ['draft','sent']">
                <span style="font-size:20px !important;">Quotation No: </span> <span style="font-size:20px !important;" t-field="doc.name"></span><br/>
            </t>
            <t t-else="">
                <span style="font-size:20px !important;">Order No: </span> <span style="font-size:20px !important;" t-field="doc.name"></span><br/>
            </t>
        </div>
        <div class="row col-12 mb-8 mt-2">
            <span style="font-size:20px !important;">Kind Attn: </span> <span style="font-size:20px !important;" t-field="doc.inquiry_rec_from"></span><br/>
        </div>
        <div class="row col-12 mb-8 mt-2">
            <span style="font-size:20px !important;">Customer Name: </span> <span style="font-size:20px !important;" t-field="doc.partner_id.name"></span><br/>
        </div>
        <div class="row col-12 mb-8 mt-2">
            <span style="font-size:20px !important;">Customer Address: </span> <span style="font-size:20px !important;" t-field="doc.partner_id.street"></span> <span style="font-size:20px !important;" t-field="doc.partner_id.street2"></span><span style="font-size:20px !important;" t-field="doc.partner_id.city"></span> <span style="font-size:20px !important;" t-field="doc.partner_id.country_id.name"></span><br/>
        </div>
        <!-- <div class="row col-12 mb-2 mt32" style="font-size:16px !important;">
            <div class="col-4">
                <span>Vessel Name: </span> <span t-field="doc.vessel_no_id.name"></span>
            </div>
            <div class="col-4">
                <span>IMO No.: </span> <span t-field="doc.imo_no_id"></span>
            </div>
            <div class="col-4">
                <span>Port Name: </span> <span t-field="doc.port_master_id.name"></span>
            </div>
        </div> -->
        <div class="page">
            <div class="oe_structure"/>

            <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
            <!-- <t t-set="layout_document_title">
                <span style="font-size:20px !important" t-if="is_proforma">Pro-Forma Invoice # </span>
                <span style="font-size:20px !important" t-elif="doc.state in ['draft','sent']">Quotation # </span>
                <span style="font-size:20px !important" t-else="">Order # </span>
                <span style="font-size:20px !important" t-field="doc.name">SO0000</span>
            </t> -->

            <div class="row mb-4 mt32" id="informations">
                <div t-if="doc.client_order_ref" class="col" name="informations_reference">
                    <strong>Your Reference</strong>
                    <div t-field="doc.client_order_ref">SO0000</div>
                </div>
                <div t-if="doc.date_order" class="col" name="informations_date">
                    <strong t-if="is_proforma">Issued Date</strong>
                    <strong t-elif="doc.state in ['draft', 'sent']">Quotation Date</strong>
                    <strong t-else="">Order Date</strong>
                    <div t-field="doc.date_order" t-options='{"widget": "date"}'>2023-12-31</div>
                </div>
                <div t-if="doc.validity_date and doc.state in ['draft', 'sent']"
                    class="col"
                    name="expiration_date">
                    <strong>Quote Valid Till Date</strong>
                    <div t-field="doc.validity_date">2023-12-31</div>
                </div>
                <div t-if="doc.create_uid.name" class="col">
                    <strong>Quoted by</strong>
                    <div t-field="doc.create_uid">Mitchell Admin</div>
                </div>

                <div t-if="doc.vessel_no_id" class="col" name="vessel_no_id">
                    <strong>Vessel Name</strong>
                    <div t-field="doc.vessel_no_id"></div>
                </div>
                <!-- <div t-if="doc.vessel_no" class="col" name="vessel_no">
                    <strong>Vessel Name</strong>
                    <div t-field="doc.vessel_no"></div>
                </div> -->
                <!-- <div t-if="doc.imo_no_id" class="col" name="imo_no_id">
                    <strong>IMO No</strong>
                    <div t-field="doc.imo_no_id"></div>
                </div> -->
                <div t-if="doc.imo_number" class="col" name="imo_number">
                    <strong>IMO No</strong>
                    <div t-field="doc.imo_number"></div>
                </div>
                <div t-if="doc.port_master_id" class="col" name="port_master_id">
                    <strong>Port Name</strong>
                    <div t-field="doc.port_master_id.name"></div>
                </div>
            </div>

            <!-- Is there a discount on at least one line? -->
            <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
            <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>
            <t t-set="has_hs_code" t-value="any(line.hs_code for line in lines_to_report if not line.display_type)"/>
            <div class="oe_structure"></div>
            <table class="o_has_total_table table o_main_table table-borderless">
                <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                <thead style="display: table-row-group;text-transform: none !important;">
                    <tr>
                        <th name="th_inquired" class="text-start">Inquired Item</th>
                        <th name="th_description" class="text-start">Offered Item</th>
                        <th name="th_quantity" class="text-end text-nowrap">Pack Size</th>
                        <!-- <th name="th_hs_code" class="text-end text-nowrap">HS Code</th> -->
                        <th t-if="has_hs_code" name="th_hs_code" class="text-end text-nowrap">HS Code</th>
                        <th name="th_quantity" class="text-end text-nowrap">No of Units</th>
                        <th name="th_priceunit" class="text-end text-nowrap">Unit Price</th>
                        <th name="th_subtotal" class="text-end">
                            <span>Amount</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">

                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-foreach="lines_to_report.filtered(lambda l: l.product_id.type != 'service')" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                        <tr
                            t-att-class="'fw-bold o_line_section' if (
                                line.display_type == 'line_section'
                                or line.product_type == 'combo'
                            )
                            else 'fst-italic o_line_note' if line.display_type == 'line_note'
                            else ''"
                        >
                            <t t-if="not line.display_type and line.product_type != 'combo'">
                                <td name="td_inquired">
                                    <span t-field="line.customer_ref_id.name"></span>
                                </td>
                                <td name="td_name">
                                    <t t-if="line.product_id.pds_link">
                                        <a t-att-href="line.product_id.pds_link" target="new">
                                            <span t-field="line.product_id.name"/>
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <span t-field="line.product_id.name"/>
                                    </t>
                                </td>
                                <td name="td_unit_qty" class="text-end text-nowrap">
                                    <span t-field="line.pack_size_id.name"></span>
                                </td>
                                <!-- <td name="td_hs_code" class="text-end text-nowrap">
                                    <span t-field="line.hs_code"></span>
                                </td> -->
                                <td t-if="has_hs_code" name="td_hs_code" class="text-end text-nowrap">
                                    <span t-field="line.hs_code"></span>
                                </td>
                                <td name="td_quantity" class="text-end text-nowrap">
                                    <span t-field="line.product_uom_qty"></span>
                                </td>
                                <td name="td_priceunit" class="text-end text-nowrap">
                                    <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'>3</span>
                                </td>
                                <td t-if="not line.is_downpayment" name="td_subtotal" class="text-end o_price_total">
                                    <span t-field="line.price_subtotal">27.00</span>
                                </td>
                            </t>
                            <t t-elif="line.display_type == 'line_section' or line.product_type == 'combo'">
                                <td name="td_section_line" colspan="99">
                                    <span t-field="line.name">A section title</span>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <td name="td_note_line" colspan="99">
                                    <span t-field="line.name">A note, whose content usually applies to the section or product above.</span>
                                </td>
                            </t>
                        </tr>

                        <t
                            t-if="current_section and (
                                line_last
                                or lines_to_report[line_index+1].display_type == 'line_section'
                                or lines_to_report[line_index+1].product_type == 'combo'
                                or (
                                    line.combo_item_id
                                    and not lines_to_report[line_index+1].combo_item_id
                                )
                            ) and not line.is_downpayment"
                        >
                            <t t-set="current_section" t-value="None"/>
                            <tr class="is-subtotal text-end">
                                <td name="td_section_subtotal" colspan="99">
                                    <strong class="mr16">Subtotal</strong>
                                    <span
                                        t-out="current_subtotal"
                                        t-options='{"widget": "monetary", "display_currency": doc.currency_id}'
                                    >31.05</span>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
            <!-- <div class="clearfix" name="so_total_summary">
                <div id="total" class="row mt-n3" name="total">
