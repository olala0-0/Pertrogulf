                    </td>
                </tr>
            </table> -->
            <t t-if="doc.sale_type == 'local_sale'">
                <table class="table" style="width: 100%; margin-top: -17px;; float: right; font-size: 15px; border-collapse: collapse; border: 0 !important; border-style: none !important; box-shadow: none !important;border: 0px solid #495057 !important;border-radius: 0 !important;">
                    <tr>
                        <td style="text-align: right; font-weight: bold;width: 75.9%;">Total</td>
                        <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 1px solid #ddd; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                            <span t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(sum(doc.order_line.filtered(lambda l: not l.product_id.is_expences and l.product_id.name != 'Discount').mapped('price_subtotal')))"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: right; font-weight: bold;width: 75.9%;">Discount</td>
                        <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                            <span t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(sum(doc.order_line.filtered(lambda l: not l.product_id.is_expences and l.product_id.name != 'Discount').mapped('discount_value')))"/>
                        </td>
                    </tr>
                    <t t-if="sum(doc.order_line.filtered(lambda l: l.product_id.name == 'Discount').mapped('price_subtotal')) != 0">
                        <tr>
                            <td style="text-align: right; font-weight: bold; width: 75.9%;">Additional Discount</td>
                            <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                                <span t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(sum(doc.order_line.filtered(lambda l: l.product_id.name == 'Discount').mapped('price_subtotal')))"/>
                            </td>
                        </tr>
                    </t>
                    <t t-set="regular_lines" t-value="doc.order_line.filtered(lambda l: not l.product_id.is_expences and l.product_id.name != 'Discount')"/>
                    <t t-set="discount_lines" t-value="doc.order_line.filtered(lambda l: l.product_id.name == 'Discount')"/>
                    <t t-set="subtotal_amount" t-value="sum(regular_lines.mapped('price_subtotal'))"/>
                    <t t-set="discount_amount" t-value="sum(discount_lines.mapped('price_subtotal'))"/>
                    <t t-set="discount_value_amount" t-value="sum(regular_lines.mapped('discount_value'))"/>
                    <t t-set="total_discounted" t-value="subtotal_amount + discount_amount - discount_value_amount"/>
                    <t t-set="total_discount_prices" t-value="subtotal_amount - discount_value_amount"/>

                    <!-- Calculate tax based on discounted subtotal -->
                    <t t-set="custom_tax" t-value="0.0"/>
                    <t t-if="doc.vat_selection == 'vat_5'">
                        <t t-set="custom_tax" t-value="total_discount_prices * 0.05"/>
                    </t>
                    <t t-if="doc.vat_selection == 'vat_0'">
                        <t t-set="custom_tax" t-value="total_discount_prices * 0.0"/>
                    </t>

                    <tr>
                        <td style="text-align: right; font-weight: bold; width: 75.9%;">Discounted Value</td>
                        <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                            <span t-esc="doc.currency_id.symbol"/>
                            <span t-esc="'{:,.2f}'.format(total_discounted)"/>
                        </td>
                    </tr>

                    <t t-set="expense_total" t-value="sum(doc.order_line.filtered(lambda l: l.product_id.is_expences).mapped('price_subtotal'))"/>
                    <t t-foreach="doc.order_line.filtered(lambda l: l.product_id.is_expences)" t-as="line">
                        <tr>
                            <td style="text-align: right; font-weight: bold;width: 75.9%;"><t t-esc="line.product_id.name"/></td>
                            <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                                <span t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(line.price_subtotal)"/>
                            </td>
                        </tr>
                    </t>

                    <!-- Replace doc.amount_tax with custom_tax -->
                    <t t-if="custom_tax != 0">
                        <tr>
                            <td style="text-align: right; font-weight: bold; width: 75.9%;">
                                <span t-if="doc.vat_selection == 'vat_5'">VAT 5%</span>
                                <span t-if="doc.vat_selection == 'vat_0'">VAT 0%</span>
                            </td>
                            <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                                <!-- <span t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(custom_tax)"/> -->
                                <span t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(doc.amount_tax)"/>
                            </td>
                        </tr>
                    </t>

                    <tr>
                        <td style="text-align: right; font-weight: bold;width: 75.9%;">Grand Total</td>
                        <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                            <strong t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(total_discounted + doc.amount_tax + expense_total)"/>
                        </td>
                    </tr>
                </table>
            </t>
            <t t-else="">
                <table class="table" style="width: 100%; margin-top: -17px;; float: right; font-size: 15px; border-collapse: collapse; border: 0 !important; border-style: none !important; box-shadow: none !important;border: 0px solid #495057 !important;border-radius: 0 !important;">
                    <tr>
                        <td style="text-align: right; font-weight: bold;width: 75.9%;">Total</td>
                        <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 1px solid #ddd; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                            <span t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(sum(doc.order_line.filtered(lambda l: not l.product_id.is_expences and l.product_id.name != 'Discount').mapped('price_subtotal')))"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: right; font-weight: bold;width: 75.9%;">Discount</td>
                        <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                            <span t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(sum(doc.order_line.filtered(lambda l: l.product_id.name == 'Discount').mapped('price_subtotal')))"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: right; font-weight: bold;width: 75.9%;">Discounted Value</td>
                        <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                            <span t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(sum(doc.order_line.filtered(lambda l: not l.product_id.is_expences and l.product_id.name != 'Discount').mapped('price_subtotal')) + sum(doc.order_line.filtered(lambda l: l.product_id.name == 'Discount').mapped('price_subtotal')))"/>
                        </td>
                    </tr>
                    <tr t-if="doc.vat_selection and doc.vat_selection != 'vat_not_applicable'">
                        <td style="text-align: right; font-weight: bold; width: 75.9%;">
                            <span t-if="doc.vat_selection == 'vat_5'">VAT 5%</span>
                            <span t-if="doc.vat_selection == 'vat_0'">VAT 0%</span>
                        </td>
                        <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                            <span t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(doc.amount_tax)"/>
                        </td>
                    </tr>
                    <t t-foreach="doc.order_line.filtered(lambda l: l.product_id.is_expences)" t-as="line">
                        <tr>
                            <td style="text-align: right; font-weight: bold;width: 75.9%;"><t t-esc="line.product_id.name"/></td>
                            <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                                <span t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(line.price_subtotal)"/>
                            </td>
                        </tr>
                    </t>
                    <tr>
                        <td style="text-align: right; font-weight: bold;width: 75.9%;">Grand Total</td>
                        <td style="text-align: right; border-left: 1px solid #ddd !important; border-top: 0; border-right: 1px solid #ddd; border-bottom: 1px solid #ddd;">
                            <strong t-esc="doc.currency_id.symbol + ' ' + '{:,.2f}'.format(doc.amount_total)"/>
                        </td>
                    </tr>
                </table>
            </t>
            
            <div class="oe_structure"></div>

            <div t-if="not doc.signature" class="oe_structure"></div>
            <div t-else="" class="mt-4 ml64 mr4" name="signature">
                <div class="offset-8">
                    <strong>Signature</strong>
                </div>
                <div class="offset-8">
                    <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                </div>
                <div class="offset-8 text-center">
                    <span t-field="doc.signed_by">Oscar Morgan</span>
                </div>
            </div>
            <t t-if="doc.company_id.id == 4">
                <t t-if="doc.port_note">
                    <div style="margin-top: 200px;">
                        <span t-field="doc.port_note" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}" name="order_note"/>
                        <p t-if="not is_html_empty(doc.payment_term_id.note)">
                            <span t-field="doc.payment_term_id.note">The payment should also be transmitted with love</span>
                        </p>
                        <div class="oe_structure"/>
                        <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)"
                            id="fiscal_position_remark">
                            <strong>Fiscal Position Remark:</strong>
                            <span t-field="doc.fiscal_position_id.sudo().note">No further requirements for this payment</span>
                        </p>
                    </div>
                </t>
            </t>
            <t t-else="">
                <t t-if="doc.note">
                    <div style="margin-top: 200px;">
                        <span t-field="doc.note" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}" name="order_note"/>
                        <p t-if="not is_html_empty(doc.payment_term_id.note)">
                            <span t-field="doc.payment_term_id.note">The payment should also be transmitted with love</span>
                        </p>
                        <div class="oe_structure"/>
                        <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)"
                            id="fiscal_position_remark">
                            <strong>Fiscal Position Remark:</strong>
                            <span t-field="doc.fiscal_position_id.sudo().note">No further requirements for this payment</span>
                        </p>
                    </div>
                </t>
            </t>
            <div class="oe_structure"/>
        </div>
    </t>
</template>

<template id="report_notax_green_raw">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="zilancer_customisation.report_notax_green_document" t-lang="doc.partner_id.lang"/>
        </t>
    </t>
</template>

<template id="report_notax_green">
    <t t-call="zilancer_customisation.report_notax_green_raw"/>
</template>

<template id="report_notax_green_a4">
    <t t-call="zilancer_customisation.report_notax_green_raw"/>
</template>


