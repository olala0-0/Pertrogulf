            <!-- Totals (Only Last Two Columns Visible) -->
            <!-- <table class="table" style="width: 85%; margin-top: -17px;; float: right; font-size: 15px; border-collapse: collapse; border: 0 !important; border-style: none !important; box-shadow: none !important;border: 0px solid #495057 !important;border-radius: 0 !important;">
