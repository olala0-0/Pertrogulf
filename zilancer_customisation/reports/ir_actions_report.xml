    <record id="action_report_notax_green" model="ir.actions.report">
        <field name="name">Quotation Marine</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zilancer_customisation.report_notax_green</field>
        <field name="report_file">zilancer_customisation.report_notax_green</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation_Tax - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="zilancer_customisation.paperformat_label_sheet_quotation_tax"/>
        <!-- <field name="groups_id" eval="[(6, 0, [ref('zilancer_customisation.group_print_quotation_marine')])]"/> -->
    </record>

