<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_aviation_document">
    <t t-call="web.external_layout">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
        <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
        <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
        <div class="page">
            <div class="oe_structure"/>
            <br/>
            <br/>
            <br/>
            <!-- <br/> -->
            <!-- <br/> -->
            <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
            <div style="text-align: center; font-size: 25px; font-weight: bold; margin-bottom: 25px;">
                QUOTATION
            </div>
            
            <div class="row col-12 mb4">
                <t t-if="doc.state in ['draft','sent']">
                    <span style="font-size:20px !important;">Quotation No: </span> <span style="font-size:20px !important;" t-field="doc.name"></span><br/>
                </t>
                <t t-else="">
                    <span style="font-size:20px !important;">Order No: </span> <span style="font-size:20px !important;" t-field="doc.name"></span><br/>
                </t>
            </div>
            <div class="row col-12 mb-8 mt-2">
                <span style="font-size:20px !important;">Kind Attn: </span> <span style="font-size:20px !important;" t-field="doc.inquiry_rec_from"></span><br/>
            </div>
            <div class="row col-12 mb-8 mt-2">
                <span style="font-size:20px !important;">Customer Name: </span> <span style="font-size:20px !important;" t-field="doc.partner_id.name"></span><br/>
            </div>
            <div class="row col-12 mb-8 mt-2">
                <span style="font-size:20px !important;">Customer Address: </span> <span style="font-size:20px !important;" t-field="doc.partner_id.street"></span> <span style="font-size:20px !important;" t-field="doc.partner_id.street2"></span><span style="font-size:20px !important;" t-field="doc.partner_id.city"></span> <span style="font-size:20px !important;" t-field="doc.partner_id.country_id.name"></span><br/>
            </div>

            <div class="row mb-4 mt32" id="informations">
                <div t-if="doc.client_order_ref" class="col" name="informations_reference">
                    <strong>Your Reference</strong>
                    <div t-field="doc.client_order_ref">SO0000</div>
                </div>
                <div t-if="doc.date_order" class="col" name="informations_date">
                    <strong t-if="is_proforma">Issued Date</strong>
                    <strong t-elif="doc.state in ['draft', 'sent']">Quotation Date</strong>
                    <strong t-else="">Order Date</strong>
                    <div t-field="doc.date_order" t-options='{"widget": "date"}'>2023-12-31</div>
                </div>
                <div t-if="doc.validity_date and doc.state in ['draft', 'sent']"
                    class="col"
                    name="expiration_date">
                    <strong>Quote Valid Till Date</strong>
                    <div t-field="doc.validity_date">2023-12-31</div>
                </div>
                <div t-if="doc.create_uid.name" class="col">
                    <strong>Quoted by</strong>
                    <div t-field="doc.create_uid">Mitchell Admin</div>
                </div>
            </div>

            <!-- Is there a discount on at least one line? -->
            <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
            <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>

            <div class="oe_structure"></div>
            <div class="col-12">
                <table class="mt-4 o_has_total_table table o_main_table table-borderless"
                   style="width:100%; border-collapse: collapse; border: 1px solid black;">
                <thead style="display: table-row-group;">
                    <tr>
                        <th name="th_hs_code" class="text-nowrap"
                            style="text-transform: none; border: 1px solid black;">Inquired Items</th>
                        <th name="th_sl" class="text-nowrap"
                            style="text-transform: none; border: 1px solid black;">Product Desciption</th>
                        <th name="th_lead" class="text-end text-nowrap"
                            style="width:5% !important;text-transform: none; border: 1px solid black;">Estimated Lead Time</th>
                        <th name="th_categ" class="text-end text-nowrap"
                            style="text-transform: none; border: 1px solid black;">Category</th>
                        <th name="th_description" class="text-start"
                            style="text-transform: none; border: 1px solid black;">PKG Type</th>
                        <th name="th_quantity" class="text-end text-nowrap"
                            style="text-transform: none; border: 1px solid black;">Requested Qty.</th>
                        <th style="width:5% !important; text-transform: none; border: 1px solid black;"
                            name="th_no_units" class="text-end text-nowrap">KGS Per PKG Type</th>
                        <th style="width:5% !important; text-transform: none; border: 1px solid black;"
                            name="th_net" class="text-end text-nowrap">Total KGS</th>
                        <th style="width:5% !important; text-transform: none; border: 1px solid black;"
                            name="th_gross" class="text-end text-nowrap">
                            <span t-esc="doc.currency_id.name"/> per Pack
                        </th>
                        <th style="width:5% !important; text-transform: none; border: 1px solid black;"
                            name="th_priceunit" class="text-end text-nowrap">Total USD / EXW-DXB</th>
                        
                    </tr>
                </thead>

                <tbody class="sale_tbody">
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-set="counter" t-value="0"/>

                    <t t-foreach="lines_to_report.filtered(lambda l: l.product_id.name != 'Discount')" t-as="line" t-index="line_index">
                        <t t-set="counter" t-value="counter + 1"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                        <tr t-att-class="'fw-bold o_line_section' if (
                                line.display_type == 'line_section'
                                or line.product_type == 'combo'
                            )
                            else 'fst-italic o_line_note' if line.display_type == 'line_note'
                            else ''">

                            <t t-if="not line.display_type and line.product_type != 'combo'">
                                <td class="text-center" style="border: 1px solid black;">
                                    <span t-field="line.customer_ref_id.name"/>
                                </td>
                                <td class="text-start" style="border: 1px solid black;">
                                    <span t-field="line.product_id.name"/>
                                </td>
                                <td class="text-center" style="border: 1px solid black;">
                                    <span t-field="line.leads_time"/>
                                </td>
                                <td class="text-center" style="border: 1px solid black;">
                                    <span t-field="line.product_id.categ_id.name"/>
                                </td>
                                <td class="text-start" style="border: 1px solid black;">
                                    <span t-field="line.product_id.product_tmpl_id.pack_size_id.name"/>
                                </td>
                                <td class="text-center" style="border: 1px solid black;">
                                    <span t-field="line.product_uom_qty"/>
                                </td>
                                <td class="text-center" style="border: 1px solid black;">
                                    <span t-field="line.product_id.product_tmpl_id.kgs_per_pkg_type"/>
                                </td>
                                <td class="text-center" style="border: 1px solid black;">
                                    <span t-field="line.unit_qty"/>
                                </td>
                                <td class="text-center" style="border: 1px solid black;">
                                    <span t-field="line.price_unit"
                                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                                <td class="text-center" style="border: 1px solid black;">
                                    <span t-field="line.price_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </t>

                            <t t-elif="line.display_type == 'line_section' or line.product_type == 'combo'">
                                <td name="td_section_line" colspan="99" style="border: 1px solid black;">
                                    <span t-field="line.name">A section title</span>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>

                            <t t-elif="line.display_type == 'line_note'">
                                <td name="td_note_line" colspan="99" style="border: 1px solid black;">
                                    <span t-field="line.name">A note, whose content usually applies to the section or product above.</span>
                                </td>
                            </t>
                        </tr>

                        <t t-if="current_section and (
                                    line_index + 1 == len(lines_to_report)
                                    or lines_to_report[line_index+1].display_type == 'line_section'
                                    or lines_to_report[line_index+1].product_type == 'combo'
                                    or (line.combo_item_id and not lines_to_report[line_index+1].combo_item_id)
                                ) and not line.is_downpayment">
                            <t t-set="current_section" t-value="None"/>
                            <tr class="is-subtotal text-end">
                                <td name="td_section_subtotal" colspan="99"
                                    style="border: 1px solid black; font-weight: bold;">
                                    <strong class="mr16">Subtotal</strong>
                                    <span t-out="current_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            </div>
            <!-- <t t-if="is_proforma"> -->
            <t t-set="subtotal" t-value="0.0"/>
            <t t-set="discount_total" t-value="0.0"/>
            <t t-set="additional_discount" t-value="0.0"/>

            <!-- Calculate subtotal and percent-based discount -->
            <t t-foreach="doc.order_line" t-as="line">
                <t t-set="subtotal" t-value="subtotal + (line.price_unit * line.product_uom_qty)"/>
                <t t-set="discount_total" t-value="discount_total + (line.price_unit * line.product_uom_qty * (line.discount / 100.0))"/>
            </t>

            <!--  Get additional discount from "Discount" product line (if any) -->
            <t t-set="additional_discount"
               t-value="abs(sum(doc.order_line.filtered(lambda l: l.product_id.name == 'Discount').mapped('price_subtotal')))"/>

            <!-- Calculate final totals -->
            <t t-set="total_discount" t-value="discount_total + additional_discount"/>
            <t t-set="net_total" t-value="subtotal"/>
            <t t-set="grand_total" t-value="net_total + doc.amount_tax"/>

            <!-- Display table -->
            <div class="clearfix" name="so_total_summary">
                <div id="total" class="row mt-n3" name="total">
                    <div class="col-6 ms-auto">
                        <table class="o_total_table table table-borderless"
                           style="width: 47%; float: right; border-collapse: collapse; border: 1px solid black;">
                        <tbody>
                            <!-- SUBTOTAL -->
                            <tr style="border: 1px solid black;">
                                <td class="text-end" style="border: 1px solid black;"><strong>Sub Total:</strong></td>
                                <td class="text-end" style="border: 1px solid black;">
                                    <span t-esc="'{:,.2f}'.format(subtotal + total_discount)"/>
                                    <span t-field="doc.currency_id"/>
                                </td>
                            </tr>

                            <!-- DISCOUNT (Credit Note + Line %) -->
                            <tr style="border: 1px solid black;">
                                <td class="text-end" style="border: 1px solid black;"><strong>Discount (Credit Note):</strong></td>
                                <td class="text-end" style="border: 1px solid black;">
                                    (-) <span t-esc="'{:,.2f}'.format(total_discount)"/>
                                    <span t-field="doc.currency_id"/>
                                </td>
                            </tr>

                            <!-- VAT -->
                            <tr t-if="doc.vat_selection and doc.vat_selection != 'vat_not_applicable'" style="border: 1px solid black;">
                                <td class="text-end" style="border: 1px solid black; font-weight: bold;">
                                    <span t-if="doc.vat_selection == 'vat_5'">VAT 5%</span>
                                    <span t-if="doc.vat_selection == 'vat_0'">VAT 0%</span>
                                </td>
                                <td class="text-end" style="border: 1px solid black;">
                                    <t t-if="doc.currency_id">
                                        <span t-esc="'{:,.2f}'.format(doc.amount_tax)"/>
                                        <span t-esc="doc.currency_id.symbol"/>
                                    </t>
                                </td>
                            </tr>

                            <!-- TOTAL -->
                            <tr style="border: 1px solid black;">
                                <td class="text-end" style="border: 1px solid black;"><strong>Total Amount:</strong></td>
                                <td class="text-end" style="border: 1px solid black;">
                                    <span t-esc="'{:,.2f}'.format(grand_total)"/>
                                    <span t-field="doc.currency_id"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    </div>
                </div>
            </div>


                <!--: Amount in Words -->
                <div style="font-weight:bold; width:100%; word-wrap:break-word;">
                    Total Amount in Words: 
                    <t t-out="doc.currency_id.amount_to_text(grand_total)"/>
                </div>
            <!-- </t> -->
            <!-- <t t-else=""> -->
            <!-- <div class="clearfix" name="so_total_summary">
                <div id="total" class="row mt-n3" name="total">
                    <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                        <table class="o_total_table table table-borderless">
                            <t t-call="sale.document_tax_totals">
                                <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                <t t-set="currency" t-value="doc.currency_id"/>
                            </t>
                        </table>
                    </div>
                </div>
            </div> -->
            <!-- </t> -->

            <div class="oe_structure"></div>

            <div t-if="not doc.signature" class="oe_structure"></div>
            <div t-else="" class="mt-4 ml64 mr4" name="signature">
                <div class="offset-8">
                    <strong>Signature</strong>
                </div>
                <div class="offset-8">
                    <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                </div>
                <div class="offset-8 text-center">
                    <span t-field="doc.signed_by">Oscar Morgan</span>
                </div>
            </div>
            <t t-if="not is_proforma">
                <div style="margin-top:40px;">
                    <span t-field="doc.note" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}" name="order_note"/>
                </div>
            </t>
            <br/>
            <div class="row" style="margin-top:10px;">
                <div class="col-7">
                    <div style="background-color:#1F4E79; color:#FFFFFF; font-weight:bold; padding:6px; display:block; box-sizing:border-box; width:100%; word-wrap:break-word;">
                        Once order is confirmed, any subsequent cancellation will incur applicable cancellation charges.
                    </div>
                </div>
            </div>

            <br/><br/><br/>

            <div class="row" style="margin-top:10px;">
                <div class="col-4">
                    <div style="background-color:#FFFF00; color:#000000; font-weight:bold; text-transform:uppercase; padding:6px; display:block; box-sizing:border-box; width:100%; word-wrap:break-word;">
                        [Bank Details Should Be Optional]
                    </div>
                </div>
            </div>
            
            
            <div class="oe_structure"/>
        </div>
    </t>
</template>

<template id="report_aviation_raw">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="zilancer_customisation.report_aviation_document" t-lang="doc.partner_id.lang"/>
        </t>
    </t>
</template>

<template id="report_aviation">
    <t t-call="zilancer_customisation.report_aviation_raw"/>
</template>

<template id="report_aviation_a4">
    <t t-call="zilancer_customisation.report_aviation_raw"/>
</template>


</odoo>
