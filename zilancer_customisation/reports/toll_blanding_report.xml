<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_toll_blanding_document">
    <t t-call="web.external_layout">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
        <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
        <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
        <div class="page">
            <div class="oe_structure"/>
            <br/>
            <br/>
            <br/>
            <!-- <br/> -->
            <!-- <br/> -->
            <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
            <div style="text-align: center; font-size: 25px; font-weight: bold; margin-bottom: 25px;">
                SALES QUOTATION
            </div>
            <div class="row col-12 mb4">
                <t t-if="doc.state in ['draft','sent']">
                    <span style="font-size:20px !important;">Quotation No: </span> <span style="font-size:20px !important;" t-field="doc.name"></span><br/>
                </t>
                <t t-else="">
                    <span style="font-size:20px !important;">Order No: </span> <span style="font-size:20px !important;" t-field="doc.name"></span><br/>
                </t>
            </div>
            <div class="row col-12 mb-8 mt-2">
                <span style="font-size:20px !important;">Kind Attn: </span> <span style="font-size:20px !important;" t-field="doc.inquiry_rec_from"></span><br/>
            </div>
            <div class="row col-12 mb-8 mt-2">
                <span style="font-size:20px !important;">Customer Name: </span> <span style="font-size:20px !important;" t-field="doc.partner_id.name"></span><br/>
            </div>
            <div class="row col-12 mb-8 mt-2">
                <span style="font-size:20px !important;">Customer Address: </span> <span style="font-size:20px !important;" t-field="doc.partner_id.street"></span> <span style="font-size:20px !important;" t-field="doc.partner_id.street2"></span><span style="font-size:20px !important;" t-field="doc.partner_id.city"></span> <span style="font-size:20px !important;" t-field="doc.partner_id.country_id.name"></span><br/>
            </div>

            <div class="row mb-4 mt32" id="informations">
                <div t-if="doc.client_order_ref" class="col" name="informations_reference">
                    <strong>Your Reference</strong>
                    <div t-field="doc.client_order_ref">SO0000</div>
                </div>
                <div t-if="doc.date_order" class="col" name="informations_date">
                    <strong t-if="is_proforma">Issued Date</strong>
                    <strong t-elif="doc.state in ['draft', 'sent']">Quotation Date</strong>
                    <strong t-else="">Order Date</strong>
                    <div t-field="doc.date_order" t-options='{"widget": "date"}'>2023-12-31</div>
                </div>
                <div t-if="doc.validity_date and doc.state in ['draft', 'sent']"
                    class="col"
                    name="expiration_date">
                    <strong>Quote Valid Till Date</strong>
                    <div t-field="doc.validity_date">2023-12-31</div>
                </div>
                <div t-if="doc.create_uid.name" class="col">
                    <strong>Quoted by</strong>
                    <div t-field="doc.create_uid">Mitchell Admin</div>
                </div>
            </div>
            <!-- </t> -->

            <!-- <t t-if="not is_proforma">
                <div class="row mb-4" id="informations">
                    <div t-if="doc.client_order_ref" class="col" name="informations_reference">
                        <strong>Your Reference</strong>
                        <div t-field="doc.client_order_ref">SO0000</div>
                    </div>
                    <div t-if="doc.date_order" class="col" name="informations_date">
                        <strong t-if="is_proforma">Issued Date</strong>
                        <strong t-elif="doc.state in ['draft', 'sent']">Quotation Date</strong>
                        <strong t-else="">Order Date</strong>
                        <div t-field="doc.date_order" t-options='{"widget": "date"}'>2023-12-31</div>
                    </div>
                    <div t-if="doc.validity_date and doc.state in ['draft', 'sent']"
                        class="col"
                        name="expiration_date">
                        <strong>Expiration</strong>
                        <div t-field="doc.validity_date">2023-12-31</div>
                    </div>
                    <div t-if="doc.user_id.name" class="col">
                        <strong>Salesperson</strong>
                        <div t-field="doc.user_id">Mitchell Admin</div>
                    </div>
                </div>
            </t> -->

            <!-- Is there a discount on at least one line? -->
            <!-- Lines to report fallback (quotation_lines or order_line) -->
            <t t-set="lines_to_report" t-value="doc.quotation_lines.filtered(lambda l: l.product_id.name != 'Discount') if doc.quotation_lines else doc.order_line.filtered(lambda l: not l.display_type and l.product_id.name != 'Discount')"/>
            <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>

            <div class="oe_structure"></div>
            <div class="col-12">
                <table class="mt-4 o_has_total_table table o_main_table table-borderless" style="border: 1px solid #000; border-collapse: collapse; width: 100%;">
                    <thead style="display: table-row-group; border: 1px solid #000;">
                        <tr style="border: 1px solid #000;">
                            <th name="th_sl" class="text-end text-nowrap" style="text-transform: none; border: 1px solid #000;">Sl No.</th>

                            <t t-if="doc.tb_show_hs_code != False">
                                <th name="th_hs_code" class="text-end text-nowrap" style="text-transform: none; border: 1px solid #000;">HS Code</th>
                            </t>

                            <th name="th_description" class="text-start" style="text-transform: none; border: 1px solid #000;">Product Description</th>
                            <t t-if="doc.tb_show_pack_type != False">
                                <th name="th_quantity" class="text-end text-nowrap" style="text-transform: none; border: 1px solid #000;">Selling Unit</th>
                            </t>
                            <t t-if="doc.tb_show_no_of_units != False">
                                <th style="width:5% !important; text-transform: none; border: 1px solid #000;" name="th_no_units" class="text-end text-nowrap">No. Of Units</th>
                            </t>
                            <t t-if="doc.tb_show_net_weight != False">
                                <th style="width:5% !important; text-transform: none; border: 1px solid #000;" name="th_net" class="text-end text-nowrap">Net Wt. (Kg)</th>
                            </t>
                            <t t-if="doc.tb_show_gross_weight != False">
                                <th style="width:5% !important; text-transform: none; border: 1px solid #000;" name="th_gross" class="text-end text-nowrap">Gross Wt. (Kg)</th>
                            </t>
                            <t t-if="doc.tb_show_unit_price != False">
                                <th style="width:5% !important; text-transform: none; border: 1px solid #000;" name="th_priceunit" class="text-end text-nowrap">Unit Price (<span t-esc="doc.currency_id.name"/>)</th>
                            </t>
                            <t t-if="doc.tb_show_amount != False">
                                <th name="th_subtotal" class="text-end" style="text-transform: none; border: 1px solid #000;">
                                    <span>Amount (<span t-esc="doc.currency_id.name"/>)</span>
                                </th>
                            </t>
                        </tr>
                    </thead>

                    <tbody class="sale_tbody">
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="counter" t-value="0"/>

                        <t t-foreach="lines_to_report" t-as="line">
                            <t t-set="counter" t-value="counter + 1"/>
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                            <tr style="border: 1px solid #000;">
                                <t>
                                    <!-- Sl No -->
                                    <td class="text-end" style="border: 1px solid #000;">
                                        <span t-out="counter"/>
                                    </td>

                                    <!-- HS Code -->
                                    <t t-if="doc.tb_show_hs_code != False">
                                        <td class="text-end" style="border: 1px solid #000;">
                                            <span t-field="line.hs_code"/>
                                        </td>
                                    </t>

                                    <!-- Product Description -->
                                    <td class="text-start" style="border: 1px solid #000;">
                                        <span t-field="line.product_id.name"/>
                                    </td>

                                    <!-- Selling Unit -->
                                    <t t-if="doc.tb_show_pack_type != False">
                                        <td class="text-end" style="border: 1px solid #000;">
                                            <span t-field="line.pack_size_id.name"/>
                                        </td>
                                    </t>

                                    <!-- No. Of Units -->
                                    <t t-if="doc.tb_show_no_of_units != False">
                                        <td class="text-end" style="border: 1px solid #000;">
                                            <span t-esc="line.unit_qty or line.product_uom_qty"/>
                                        </td>
                                    </t>

                                    <!-- Net Weight -->
                                    <t t-if="doc.tb_show_net_weight != False">
                                        <td class="text-end" style="border: 1px solid #000;">
                                            <span t-esc="'%.2f' % (line.net_weight or ((line.unit_qty or line.product_uom_qty or 0) * (line.product_id.net_weight or 0)))"/>
                                        </td>
                                    </t>

                                    <!-- Gross Weight -->
                                    <t t-if="doc.tb_show_gross_weight != False">
                                        <td class="text-end" style="border: 1px solid #000;">
                                            <span t-esc="'%.2f' % (line.gross_weight or ((line.unit_qty or line.product_uom_qty or 0) * (line.product_id.gross_weight or 0)))"/>
                                        </td>
                                    </t>

                                    <!-- Unit Price -->
                                    <t t-if="doc.tb_show_unit_price != False">
                                        <td class="text-end text-nowrap" style="border: 1px solid #000;">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </t>

                                    <!-- Amount -->
                                    <t t-if="doc.tb_show_amount != False">
                                        <td class="text-end" style="border: 1px solid #000;">
                                            <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </t>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>



            </div>
            <!-- <t t-if="is_proforma"> -->
            <t t-set="all_lines" t-value="doc.quotation_lines if doc.quotation_lines else doc.order_line.filtered(lambda l: not l.display_type)"/>
            <t t-set="subtotal" t-value="0.0"/>
            <t t-set="discount_total" t-value="0.0"/>
            <t t-set="additional_discount" t-value="0.0"/>

            <!-- Calculate subtotal and percent-based discount -->
            <t t-foreach="all_lines" t-as="line">
                <t t-set="l_qty" t-value="line.unit_qty or line.product_uom_qty"/>
                <t t-set="subtotal" t-value="subtotal + (line.price_unit * l_qty)"/>
                <t t-set="discount_total" t-value="discount_total + (line.price_unit * l_qty * (line.discount / 100.0))"/>
            </t>


            <!--  Get additional discount from "Discount" product line (if any) -->
            <t t-set="additional_discount"
               t-value="abs(sum(all_lines.filtered(lambda l: l.product_id.name == 'Discount').mapped('price_subtotal')))"/>

            <!-- Calculate final totals -->
            <t t-set="total_discount" t-value="discount_total + additional_discount"/>
            <t t-set="net_total" t-value="subtotal"/>
            <t t-set="grand_total" t-value="net_total + doc.quote_amount_tax"/>

            <!-- Display table -->
            <t t-if="doc.show_total">
                <div class="clearfix" name="so_total_summary">
                    <div id="total" class="row mt-n3" name="total">
                        <div class="col-4 ms-auto">
                            <table class="o_total_table table table-borderless" style="width: 100%;">
                                <tbody>
                                    <!-- SUBTOTAL -->
                                    <tr>
                                        <td class="text-end text-nowrap"><strong>Sub Total:</strong></td>
                                        <td class="text-end text-nowrap">
                                            <span t-esc="'{:,.2f}'.format(subtotal + total_discount)"/>
                                            <span t-field="doc.currency_id"/>
                                        </td>
                                    </tr>

                                    <!-- DISCOUNT (Credit Note + Line %) -->
                                    <tr t-if="doc.tb_show_discount != False">
                                        <td class="text-end text-nowrap"><strong>Discount (Credit Note):</strong></td>
                                        <td class="text-end text-nowrap">
                                            (-) <span t-esc="'{:,.2f}'.format(total_discount)"/>
                                            <span t-field="doc.currency_id"/>
                                        </td>
                                    </tr>

                                    <!-- VAT -->
                                    <tr t-if="doc.vat_selection and doc.vat_selection != 'vat_not_applicable'">
                                        <td class="text-end text-nowrap" style="font-weight: bold;">
                                            <span t-if="doc.vat_selection == 'vat_5'">VAT 5%</span>
                                            <span t-if="doc.vat_selection == 'vat_0'">VAT 0%</span>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <t t-if="doc.currency_id">
                                                <span t-esc="'{:,.2f}'.format(doc.quote_amount_tax)"/>
                                                <span t-esc="doc.currency_id.symbol"/>
                                            </t>
                                        </td>
                                    </tr>

                                    <!-- TOTAL -->
                                    <tr>
                                        <td class="text-end text-nowrap"><strong>Total Amount:</strong></td>
                                        <td class="text-end text-nowrap">
                                            <span t-esc="'{:,.2f}'.format(grand_total)"/>
                                            <span t-field="doc.currency_id"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>

            <t t-if="doc.show_total">
                <!--: Amount in Words -->
                <div style="font-weight:bold; width:100%; word-wrap:break-word;">
                    Total Amount in Words: 
                    <t t-out="doc.currency_id.amount_to_text(grand_total)"/>
                </div>
            </t>
            <!-- </t> -->
            <!-- <t t-else=""> -->
            <!-- <div class="clearfix" name="so_total_summary">
                <div id="total" class="row mt-n3" name="total">
                    <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                        <table class="o_total_table table table-borderless">
                            <t t-call="sale.document_tax_totals">
                                <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                <t t-set="currency" t-value="doc.currency_id"/>
                            </t>
                        </table>
                    </div>
                </div>
            </div> -->
            <!-- </t> -->

            <div class="oe_structure"></div>

            <div t-if="not doc.signature" class="oe_structure"></div>
            <div t-else="" class="mt-4 ml64 mr4" name="signature">
                <div class="offset-8">
                    <strong>Signature</strong>
                </div>
                <div class="offset-8">
                    <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                </div>
                <div class="offset-8 text-center">
                    <span t-field="doc.signed_by">Oscar Morgan</span>
                </div>
            </div>
            <t t-if="not is_proforma">
                <div style="margin-top:40px;">
                    <span t-field="doc.note" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}" name="order_note"/>
                </div>
            </t>

            <!-- Bank Details Note - OPTIONAL -->
            <div class="row" style="margin-top:10px;">
                <div class="col-4">
                    <div style="background-color:#FFF9C4; color:#000000; font-weight:bold; text-transform:uppercase; padding:6px; display:block; box-sizing:border-box; width:100%; word-wrap:break-word;">
                        [Bank Details Should Be Optional]
                    </div>
                </div>
            </div>
            <div class="oe_structure"/>
        </div>
    </t>
</template>

<template id="report_toll_blanding_raw">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="zilancer_customisation.report_toll_blanding_document" t-lang="doc.partner_id.lang"/>
        </t>
    </t>
</template>

<template id="report_toll_blanding">
    <t t-call="zilancer_customisation.report_toll_blanding_raw"/>
</template>

<template id="report_toll_blanding_a4">
    <t t-call="zilancer_customisation.report_toll_blanding_raw"/>
</template>


</odoo>
