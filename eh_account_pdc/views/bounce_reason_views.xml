<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_cheque_bounce_reason_tree" model="ir.ui.view">
        <field name="name">eh.cheque.bounce.reason.list</field>
        <field name="model">eh.cheque.bounce.reason</field>
        <field name="arch" type="xml">
            <list string="Bounce Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_recoverable" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_eh_cheque_bounce_reason_form" model="ir.ui.view">
        <field name="name">eh.cheque.bounce.reason.form</field>
        <field name="model">eh.cheque.bounce.reason</field>
        <field name="arch" type="xml">
            <form string="Bounce Reason">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_recoverable"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_cheque_bounce_reason" model="ir.actions.act_window">
        <field name="name">Bounce Reasons</field>
        <field name="res_model">eh.cheque.bounce.reason</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
