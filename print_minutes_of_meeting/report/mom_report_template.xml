<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Template of Minutes of Meeting Template-->
    <template id="report_mom_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <center>
                            <h3>Minutes of Meeting</h3>
                        </center>
                        <!-- <center>
                            <h3 t-field="o.meeting_id"/>
                        </center>
                        <h6>
                            <t t-esc="o.description"/>
                        </h6> -->

                        <table class="table table-striped table-bordered" style="width: 100%; font-size: 10px;">
                            <!-- First row: full width with colspan -->
                            <tr>
                                <!-- <td style="width: 25%;"><strong>Meeting Subject</strong></td>
                                <td colspan="3" style="width: 75%;"><span t-field="o.name"/></td> -->
                                <td style="width: 10%;"><strong>Meeting ID</strong></td>
                                <td style="width: 40%;"><span t-field="o.meeting_id"/></td>
                                <td style="width: 10%;"><strong>Meeting Subject</strong></td>
                                <td style="width: 40%;"><span t-field="o.name"/></td>
                            </tr>

                            <!-- Second row: Start and End Date/Time -->
                            <tr>
                                <td style="width: 10%;"><strong>Start Date &amp; Time</strong></td>
                                <td style="width: 40%;">
                                    <t t-if="o.start">
                                        <!-- <t t-esc="o.start.strftime('%d/%b/%Y %H:%M:%S %A')"/> -->
                                        <t t-esc="o.get_local_datetime(o.start)"/>
                                    </t>
                                </td>
                                <td style="width: 10%;"><strong>End Date &amp; Time</strong></td>
                                <td style="width: 40%;">
                                    <t t-if="o.stop">
                                        <!-- <t t-esc="o.stop.strftime('%d/%b/%Y %H:%M:%S %A')"/> -->
                                        <t t-esc="o.get_local_datetime(o.stop)"/>
                                    </t>
                                </td>

                                <!-- <td style="width: 25%;"><strong>Start Date &amp; Time</strong></td>
                                <td style="width: 25%;"><t t-if="start"><t t-esc="o.start.strftime('%d/%b/%Y %H:%M:%S %A') if o.start else ''"/></t></td>
                                <td style="width: 25%;"><strong>End Date &amp; Time</strong></td>
                                <td style="width: 25%;"><t t-if="stop"><t t-esc="o.stop.strftime('%d/%b/%Y %H:%M:%S %A') if o.stop else ''"/></t></td> -->
                            </tr>

                            <!-- Third row: Responsible and Note Taker -->
                            <tr>
                                <td style="width: 10%;"><strong>Meeting Co-ordinator</strong></td>
                                <td style="width: 40%;"><span t-field="o.responsible_user_id.name"/></td>
                                <td style="width: 10%;"><strong>Note Taker</strong></td>
                                <td style="width: 40%;"><span t-field="o.note_taker_id.name"/></td>
                            </tr>

                            <!-- Fourth row: Attendees and Absent Members -->
                            <tr>
                                <td style="width: 10%;"><strong>Invitees</strong></td>
                                <td style="width: 40%;"><span t-field="o.partner_ids"/></td>
                                <td style="width: 10%;"><strong>Absent Members</strong></td>
                                <td style="width: 40%;"><span t-field="o.absent_member_ids"/></td>
                            </tr>
                        </table>

                        <h5>Agenda Items</h5>

                        <table class="table table-striped table-bordered" style="font-size: 10px;">
                            <thead style="display: table-row-group;text-transform: none !important;">
                                <tr>
                                    <th>#</th>
                                    <th>Topic</th>
                                    <th>Description/Notes</th>
                                    <th>Discussed</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="1"/>
                                <tr t-foreach="o.agenda_ids" t-as="line">
                                    <td>
                                        <span t-esc="i"/>
                                    </td>
                                    <td>
                                        <span t-field="line.topic"/>
                                    </td>
                                    <td>
                                        <span t-field="line.description"/>
                                    </td>
                                    <td>
                                        <t t-if="line.is_discussed">
                                            <span>Yes</span>
                                        </t>
                                        <t t-else="">
                                            <span>No</span>
                                        </t>
                                    </td>
                                    <t t-set="i" t-value="i+1"/>
                                </tr>
                            </tbody>
                        </table>

                        <!-- <br/> -->

                        <h5>Actions/ Decisions</h5>

                        <table class="table table-striped table-bordered" style="font-size: 10px;">
                            <!-- <thead style="display: table-row-group;text-transform: none !important;"> -->
                            <thead style="display: table-header-group; text-transform: none !important;">
                                <tr>
                                    <th>#</th>
                                    <th>Action/ Decisions</th>
                                    <th style="width: 25%;">Description/Notes</th>
                                    <th>Responsible</th>
                                    <th>Assigned To</th>
                                    <th style="width: 7%;">Timeline</th>
                                    <th>Status</th>
                                    <th style="width: 25%;">Key Bottlenecks</th>
                                    <th>Extension 1</th>
                                    <th>Extension 2</th>
                                    <th>Attachment</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="1"/>
                                <tr t-foreach="o.actions_ids" t-as="line">
                                    <td>
                                        <span t-esc="i"/>
                                    </td>
                                    <td>
                                        <span t-field="line.action"/>
                                    </td>
                                    <td>
                                        <span t-field="line.description"/>
                                    </td>
                                    <td>
                                        <t t-esc="line.responsible_partner_id.name"/>
                                    </td>
                                    <td>
                                        <span t-field="line.assigned_partner_ids"/>
                                    </td>
                                    <!-- <td>
                                        <t t-if="line.deadline">
                                            <t t-esc="line.deadline.strftime('%d-%b-%Y %A')"/>
                                        </t>
                                    </td> -->
                                    <td>
                                        <t t-if="line.deadline">
                                            <t t-set="today" t-value="datetime.date.today()"/>
                                            <t t-set="tomorrow" t-value="today + datetime.timedelta(days=1)"/>
                                            
                                            <span t-att-class="'text-danger' if (line.deadline &lt;= today or line.deadline == tomorrow) else ''">
                                                <t t-esc="line.deadline.strftime('%d/%b/%Y %A')"/>
                                                <!-- <t t-esc="o.get_local_datetime(line.deadline)"/> -->
                                            </span>
                                        </t>
                                    </td>
                                    <td>
                                        <!-- <span t-field="line.status"/> -->
                                        <t t-if="line.status == 'wip'">
                                            <span style="color: blue;">Work In Progress</span>
                                        </t>
                                        <t t-elif="line.status == 'completed'">
                                            <span style="color: green;">Completed</span>
                                        </t>
                                        <t t-else="">
                                            <span style="color: gray;">Not Started</span>
                                        </t>
                                    </td>
                                    <td>
                                        <span t-field="line.remarks"/>
                                    </td>
                                    <td>
                                        <t t-if="line.extension_1">
                                            <t t-set="today" t-value="datetime.date.today()"/>
                                            <t t-set="tomorrow" t-value="today + datetime.timedelta(days=1)"/>
                                            <span t-att-class="'text-danger' if (line.extension_1 &lt;= today or line.extension_1 == tomorrow) else ''">
                                                <t t-esc="line.extension_1.strftime('%d/%b/%Y %A')"/>
                                                <!-- <t t-esc="o.get_local_datetime(line.extension_1)"/> -->
                                            </span>
                                        </t>
                                    </td>
                                    <td>
                                        <t t-if="line.extension_2">
                                            <t t-set="today" t-value="datetime.date.today()"/>
                                            <t t-set="tomorrow" t-value="today + datetime.timedelta(days=1)"/>
                                            <span t-att-class="'text-danger' if (line.extension_2 &lt;= today or line.extension_2 == tomorrow) else ''">
                                                <t t-esc="line.extension_2.strftime('%d/%b/%Y %A')"/>
                                                <!-- <t t-esc="o.get_local_datetime(line.extension_2)"/> -->
                                            </span>
                                        </t>
                                    </td>
                                    <td>
                                        <t t-if="line.attachment_data">
                                            <a t-att-href="'/binary_download/%s' % line.id">
                                                <t t-esc="line.attachment_name or 'Download File'"/>
                                            </a>
                                        </t>
                                    </td>
                                    <t t-set="i" t-value="i+1"/>
                                </tr>
                            </tbody>
                        </table>

                        <p>
                            <h5>
                                <strong>Conclusion Notes</strong>
                            </h5>
                            <br/>
                            <t t-esc="o.notes"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
