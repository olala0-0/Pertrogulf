<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    Action for Minutes of Meeting Report-->

    <record id="paperformat_label_sheet_minutes_of_meeting" model="report.paperformat">
        <field name="name">Minutes of Meeting</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">350</field>
        <field name="page_width">500</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">55</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="header_spacing">50</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_minutes_of_meeting_report" model="ir.actions.report">
        <field name="name">Minutes of Meeting</field>
        <field name="model">calendar.event</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">print_minutes_of_meeting.report_mom_template</field>
        <field name="report_file">print_minutes_of_meeting.report_mom_template</field>
        <field name="binding_model_id" ref="calendar.model_calendar_event"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="print_minutes_of_meeting.paperformat_label_sheet_minutes_of_meeting"/>
        <field name="print_report_name">('Minutes.of.meeting')</field>
    </record>
</odoo>
